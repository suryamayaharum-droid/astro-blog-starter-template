---
import EcosystemRail from '../components/EcosystemRail.astro';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {referenceArtists,referenceCollections,byRank} from '../data/references';
const base=import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const featured=byRank(17)!;
const normalizeFocus=(value:string)=>value.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();
const themedCover=(artist:typeof referenceArtists[number])=>{
 const focus=normalizeFocus(artist.focus);
 const lane=normalizeFocus(artist.lane);
 const subjects=focus+' '+lane;
 if(/museum|museu|arquivo|archive|biblioteca|database|acervo/.test(subjects))return 'museum-gallery';
 if(/jap|japan|ukiyo|asia|manga/.test(subjects))return 'moonlit-landscape';
 if(/botan|flor|planta|iris/.test(subjects))return 'iris-study';
 if(/carvao|charcoal|grafite|graphite|lapis|pencil/.test(focus))return 'harum-noir-caderno-estudo';
 if(/maos|hand/.test(subjects))return 'harum-noir-hands-study';
 if(/sketchbook|caderno|processo/.test(subjects))return 'open-sketchbook';
 if(/^(escola|school|atelier|ateli|academ|academic|ensino)/.test(lane))return 'atelier-desk';
 if(/^(retrato|portrait)/.test(lane))return 'harum-noir-caderno-olhar';
 if(/anatom|figura|gesture|gesto|life drawing/.test(subjects))return 'figure-gesture';
 if(/retrato|portrait|rosto|face|olho/.test(focus))return 'harum-noir-caderno-olhar';
 if(/^(ink|quadrinhos|comic)/.test(lane))return 'tools-paper';
 if(/^(design|perspectiva|concept|visual development)/.test(lane)||/concept|design|perspectiva|visual development|worldbuild|personagem|character|ambiente/.test(focus))return 'harum-noir-colecoes-atlas';
 if(/pintura|painting|cor|color|luz|light|tonal|pastel/.test(subjects))return 'drapery-still-life';
 if(/escola|school|ensino|educa|academ|curso|course/.test(subjects))return 'atelier-desk';
 return 'exercicio-quatro-decisoes';
};
const catalog=JSON.stringify(referenceArtists.map(a=>({rank:a.rank,slug:a.slug,name:a.name,focus:a.focus,videoId:a.slug==='zin-lim'?'':a.videoId,lane:a.lane,cover:themedCover(a)})));
const referenceSchema={
  '@context':'https://schema.org',
  '@type':'CollectionPage',
  name:'Atlas de Referências · Harum Noir',
  description:'Atlas editorial de artistas, desenho, carvão, grafite, figura, processo e repertório.',
  inLanguage:'pt-BR',
  mainEntity:{
    '@type':'ItemList',
    numberOfItems:referenceArtists.length,
    itemListElement:referenceArtists.map((a,i)=>({
      '@type':'ListItem',
      position:i+1,
      url:new URL(base+'referencias/'+a.slug,Astro.site).href,
      item:{'@type':'CreativeWork','name':a.name,'description':a.focus}
    }))
  }
};
---
<!doctype html><html lang="pt-BR"><head><BaseHead title="Atlas de Referências · Harum Noir" description="Um atlas visual de artistas, desenho, carvão, grafite, figura, processo e repertório." alternates={[{hreflang:'en',href:base+'en/references/'},{hreflang:'es',href:base+'es/referencias/'}]}/><script type="application/ld+json" set:html={JSON.stringify(referenceSchema)} /></head>
<body><Header/><main class="stream-main reference-composition">
<section class="stream-hero">
 <div class="stream-hero-media">
  <img src={base+'noir/visual-atlas/harum-noir-caderno-estudo.webp'} alt="" onerror={"this.src='"+base+"noir/visual-atlas/harum-noir-caderno-estudo.webp'"}/>
 </div>
 <div class="stream-hero-shade"></div>
 <div class="stream-hero-copy">
   <span class="eyebrow">EM DESTAQUE · CARVÃO & MATÉRIA</span>
   <h1>{featured.name}</h1>
   <p>{featured.special}</p><p class="journey-next">Capa temática HARUM NOIR · criada com assistência de IA; não representa obra do artista.</p>
   <div class="actions"><a class="btn primary" href={base+'referencias/'+featured.slug}>Entrar nesta referência</a></div>
   <p class="journey-next">Fonte original: <a href={featured.youtube} target="_blank" rel="noreferrer">YouTube ↗</a></p>
 </div>
</section>

<section class="stream-search-shell">
 <label for="stream-search" class="eyebrow">ATLAS DE REFERÊNCIAS · EXPLORE POR ARTISTA OU TÉCNICA</label>
  <input id="stream-search" class="stream-search" type="search" placeholder="Buscar artista, técnica, carvão, gesto…" aria-label="Buscar no atlas" aria-describedby="search-status"/>
 <p id="search-status" class="search-status" role="status" aria-live="polite" aria-atomic="true">{referenceArtists.length} referências para explorar.</p>
</section>
<nav class="collection-index" aria-label="Coleções de referências">
 {referenceCollections.map(col=><a href={'#'+col.id}>{col.title}</a>)}
</nav>
<p class="cover-note">Miniaturas de vídeos vêm do YouTube. Quando indisponíveis, a capa temática HARUM NOIR é uma composição com assistência de IA e não representa obra do artista.</p>

<section id="recent-section" class="stream-section" hidden>
 <div class="stream-head"><div><span class="eyebrow">SEU CAMINHO</span><h2>Continuar explorando</h2></div></div>
 <div id="recent-rail" class="stream-rail"></div>
</section>

<div id="collections-view">
{referenceCollections.map(col=>{
 const items=col.ranks.map(byRank).filter(Boolean);
 return <section class="stream-section" id={col.id}>
  <div class={col.id==='silencio-processo'?'stream-head collection-head-hands':'stream-head'}>
  <div><span class="eyebrow">COLEÇÃO</span><h2>{col.title}</h2></div>
  {col.id==='silencio-processo'&&<figure class="collection-hands-art">
   <img src={base+'noir/visual-atlas/harum-noir-hands-study-v2.webp'} alt="Estudo de uma mão em carvão e grafite sobre papel." loading="lazy" decoding="async" width="640" height="640"/>
   <figcaption>Estudo editorial HARUM NOIR, criado com assistência de IA.</figcaption>
  </figure>}
  <p>{col.subtitle}</p>
 </div>
  <div class="stream-rail">
   {items.map(a=><article class="stream-card reference-pick" data-ref-slug={a!.slug}>
    <a class="stream-card-link" href={base+'referencias/'+a!.slug}>
      <div class="stream-card-media">
        <img class="stream-fallback" src={base+'noir/visual-atlas/'+themedCover(a!)+'.webp'} alt="" loading="lazy" decoding="async" width="640" height="640" />
        {a!.videoId&&a!.slug!=='zin-lim'&&<img class="stream-thumb" src={'https://i.ytimg.com/vi/'+a!.videoId+'/hqdefault.jpg'} alt={'Referência visual de '+a!.name} loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.remove()"/>}
        <span class="stream-rank">{String(a!.rank).padStart(2,'0')}</span>
      </div>
      <div class="stream-card-body"><span>{a!.focus}</span><h3>{a!.name}</h3></div>
    </a>
    <button class="compare-toggle" type="button" data-compare={a!.slug} aria-pressed="false">＋ Comparar</button>
   </article>)}
  </div>
 </section>
})}
</div>

<section id="search-view" class="stream-section" hidden>
 <div class="stream-head"><div><span class="eyebrow">BUSCA</span><h2>Resultados</h2></div></div>
 <div id="search-grid" class="reference-grid"></div>
 <p id="search-empty" class="ref-empty">Nenhuma referência encontrada.</p>
</section>

<section class="section compare-lab" id="comparar" aria-labelledby="compare-title">
  <div class="section-head">
    <div><span class="eyebrow">MESA DE COMPARAÇÃO · 2–3 REFERÊNCIAS</span><h2 id="compare-title">Monte uma relação, não uma coleção infinita.</h2></div>
    <p>Escolha duas ou três referências do Atlas. Compare decisões, escreva o elo entre elas e saia com uma pergunta de desenho.</p>
  </div>
  <div id="compare-slots" class="compare-grid" aria-live="polite"></div>
  <div id="compare-empty" class="compare-empty">Use <b>＋ Comparar</b> nos cartões acima. A mesa guarda no máximo três referências neste aparelho.</div>
  <div id="compare-work" class="compare-work" hidden>
    <div class="compare-prompts">
      <article><span>01</span><strong>O que permanece?</strong><p>Que decisão visual aparece nas referências escolhidas apesar de estilos diferentes?</p></article>
      <article><span>02</span><strong>Onde divergem?</strong><p>Qual referência resolve o mesmo problema de maneira oposta ou mais econômica?</p></article>
      <article><span>03</span><strong>O que vira seu?</strong><p>Escolha uma decisão para testar em outro assunto, sem copiar a superfície.</p></article>
    </div>
    <label class="compare-note-label" for="compare-note">Sua relação entre as referências</label>
    <textarea id="compare-note" class="compare-note" rows="4" placeholder="Ex.: As três usam bordas perdidas para segurar a atenção, mas uma depende mais de massa do que de linha. Vou testar isso em uma figura diferente."></textarea>
    <div class="actions"><a class="btn gold" href={base+'cadernos'}>Levar a descoberta ao Caderno →</a><a class="btn" href={base+'atelier'}>Testar no Ateliê →</a><button id="compare-clear" class="btn compare-clear" type="button">Limpar mesa</button></div>
  </div>
</section>

<section class="section reference-protocol"><div class="section-head"><div><span class="eyebrow">PROTOCOLO DE ESTUDO · 10 MIN</span><h2>Não abra dez referências.</h2></div><p>Abra uma. Extraia uma decisão. Feche a tela e volte ao papel.</p></div><div class="path-index"><div class="path-index-card"><span>01</span><strong>Nomeie</strong><small>Qual problema você veio estudar: gesto, peso, borda, luz, estrutura?</small></div><div class="path-index-card"><span>02</span><strong>Isole</strong><small>Escolha uma única decisão do artista; não tente absorver o estilo inteiro.</small></div><div class="path-index-card"><span>03</span><strong>Teste</strong><small>Feche a referência e faça um estudo curto usando o princípio em outro assunto.</small></div><div class="path-index-card"><span>04</span><strong>Registre</strong><small>Anote o que mudou no seu desenho e leve essa pergunta ao Caderno.</small></div></div></section>
<section class="section" aria-labelledby="reference-close-title">
  <div class="section-head"><div><span class="eyebrow">SAÍDA DO ESTUDO</span><h2 id="reference-close-title">A referência precisa desaparecer da tela.</h2></div><p>Ao fim dos 10 minutos, você deve ter algo feito sem depender da imagem aberta.</p></div>
  <div class="path-index">
    <div class="path-index-card"><span>01</span><strong>Entrega</strong><small>1 estudo curto usando o princípio em outro assunto.</small></div>
    <div class="path-index-card"><span>02</span><strong>Conferência</strong><small>Consigo apontar qual decisão veio da observação e qual escolha passou a ser minha?</small></div>
    <div class="path-index-card"><span>03</span><strong>Registro</strong><small>Escreva uma frase: “funcionou quando…” ou “ainda preciso entender…”.</small></div>
    <div class="path-index-card"><span>04</span><strong>Continuação</strong><small>Leve a frase ao Caderno ou transforme-a em uma prática no Ateliê.</small></div>
  </div>
  <div class="actions" style="margin-top:18px"><a class="btn primary" href={base+'cadernos'}>Registrar no Caderno →</a><a class="btn" href={base+'atelier'}>Testar no Ateliê →</a><a class="btn" href={base+"rituais-de-olhar#rituais"}>Mudar o modo de olhar →</a></div>
</section>

<section class="section"><div class="journal"><div class="paper">
<div class="eyebrow" style="color:#8a734b">COMO USAR ESTE ATLAS</div>
<h2>Referência não é destino.</h2>
<p class="lead">Olhe para decisões, não para superfícies.</p>
<p>Abra uma referência, observe um princípio e volte para o papel. O Atlas existe para ampliar repertório, não para substituir linguagem própria.</p>
<a href={base+'roubar-como-artista'}>Roubar como artista, sem virar cópia →</a>
</div></div></section>

<script is:inline define:vars={{catalog,base}}>
(()=>{
 const data=JSON.parse(catalog);
 const search=document.querySelector('#stream-search');
 const collections=document.querySelector('#collections-view');
 const searchView=document.querySelector('#search-view');
 const grid=document.querySelector('#search-grid');
 const empty=document.querySelector('#search-empty');
 const status=document.querySelector('#search-status');
 const fallback=(a)=>base+'noir/visual-atlas/'+a.cover+'.webp';
 const card=(a)=>'<article class="reference-card reference-pick" data-ref-slug="'+a.slug+'"><a class="reference-card-link" href="'+base+'referencias/'+a.slug+'"><div class="reference-media"><img class="reference-fallback" src="'+fallback(a)+'" alt="" loading="lazy" decoding="async" width="640" height="640">'+(a.videoId?'<img class="reference-thumb" src="https://i.ytimg.com/vi/'+a.videoId+'/hqdefault.jpg" alt="" loading="lazy" onerror="this.remove()">':'')+'<span class="reference-rank">'+String(a.rank).padStart(2,'0')+'</span></div><div class="reference-body"><span class="card-kicker">'+a.focus+'</span><h2>'+a.name+'</h2><p>Entrar na ficha →</p></div></a><button class="compare-toggle" type="button" data-compare="'+a.slug+'" aria-pressed="false">＋ Comparar</button></article>';
 const apply=()=>{
   const q=(search?.value||'').toLowerCase().trim();
   if(!q){collections.hidden=false;searchView.hidden=true;status.textContent=data.length+' referências para explorar.';return;}
   collections.hidden=true;searchView.hidden=false;
   const found=data.filter(a=>(a.name+' '+a.focus+' '+a.lane).toLowerCase().includes(q));
   grid.innerHTML=found.map(card).join('');empty.style.display=found.length?'none':'block';
   status.textContent=found.length+(found.length===1?' referência encontrada.':' referências encontradas.');
 };
 search?.addEventListener('input',apply);
 document.querySelector('.collection-index')?.addEventListener('click',(event)=>{
   if(event.target.closest('a')){search.value='';apply();}
 });
 let raw;try{raw=JSON.parse(localStorage.getItem('noir_recent_refs')||'[]')}catch{raw=[]}
 const rec=(Array.isArray(raw)?raw:[]).filter(slug=>typeof slug==='string'&&data.some(a=>a.slug===slug)).slice(0,8);
 if(rec.length){const section=document.querySelector('#recent-section');const rail=document.querySelector('#recent-rail');rail.innerHTML=rec.map(slug=>card(data.find(a=>a.slug===slug))).join('');section.hidden=false;}

 const compareSlots=document.querySelector('#compare-slots');
 const compareEmpty=document.querySelector('#compare-empty');
 const compareWork=document.querySelector('#compare-work');
 const compareNote=document.querySelector('#compare-note');
 const compareClear=document.querySelector('#compare-clear');
 const compareKey='harum_noir_compare_refs_v1';
 const compareNoteKey='harum_noir_compare_note_v1';
 let selected=[];
 try{
   const saved=JSON.parse(localStorage.getItem(compareKey)||'[]');
   selected=(Array.isArray(saved)?saved:[]).filter(slug=>typeof slug==='string'&&data.some(a=>a.slug===slug)).slice(0,3);
   if(compareNote) compareNote.value=localStorage.getItem(compareNoteKey)||'';
 }catch{}
 const escapeHtml=(value)=>String(value||'').replace(/[&<>"']/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
 const syncCompareButtons=()=>{
   document.querySelectorAll('[data-compare]').forEach(button=>{
     const on=selected.includes(button.dataset.compare);
     button.setAttribute('aria-pressed',String(on));
     button.textContent=on?'✓ Na mesa':'＋ Comparar';
   });
 };
 const paintCompare=()=>{
   const refs=selected.map(slug=>data.find(a=>a.slug===slug)).filter(Boolean);
   if(compareSlots) compareSlots.innerHTML=refs.map((a,index)=>'<article class="compare-card"><div class="compare-card-art"><img src="'+fallback(a)+'" alt="" loading="lazy"><span>'+String(index+1).padStart(2,'0')+'</span></div><div><small>'+escapeHtml(a.focus)+'</small><h3>'+escapeHtml(a.name)+'</h3><button type="button" data-remove-compare="'+a.slug+'">Remover</button></div></article>').join('');
   if(compareEmpty) compareEmpty.hidden=refs.length>0;
   if(compareWork) compareWork.hidden=refs.length<2;
   try{localStorage.setItem(compareKey,JSON.stringify(selected))}catch{}
   syncCompareButtons();
 };
 document.addEventListener('click',(event)=>{
   const add=event.target.closest('[data-compare]');
   if(add){
     const slug=add.dataset.compare;
     if(selected.includes(slug)) selected=selected.filter(x=>x!==slug);
     else if(selected.length<3) selected=[...selected,slug];
     else{
       const old=add.textContent;
       add.textContent='Máximo de 3';
       setTimeout(()=>{add.textContent=old;syncCompareButtons()},900);
       return;
     }
     paintCompare();
     if(selected.length>=2) document.querySelector('#comparar')?.scrollIntoView({behavior:'smooth',block:'start'});
   }
   const remove=event.target.closest('[data-remove-compare]');
   if(remove){selected=selected.filter(x=>x!==remove.dataset.removeCompare);paintCompare();}
 });
 compareNote?.addEventListener('input',()=>{try{localStorage.setItem(compareNoteKey,compareNote.value)}catch{}});
 compareClear?.addEventListener('click',()=>{
   selected=[];
   if(compareNote) compareNote.value='';
   try{localStorage.removeItem(compareKey);localStorage.removeItem(compareNoteKey)}catch{}
   paintCompare();
 });
 paintCompare();
})();
</script>
<EcosystemRail current="referencias" limit={5} />
</main><Footer/></body></html>
<style>
 .reference-composition .stream-search-shell{display:grid;gap:8px;padding:16px 0}
 .reference-composition .stream-search-shell .eyebrow{font-size:.65rem;letter-spacing:.1em}
 .collection-index{display:flex;flex-wrap:wrap;gap:8px;padding:16px 0 8px}
 .collection-index a{font-size:.78rem;padding:9px 12px;border:1px solid var(--line);border-radius:4px;color:var(--paper-2);text-decoration:none}
 .collection-index a:hover,.collection-index a:focus-visible{border-color:var(--gold);color:var(--paper)}
 .search-status{font-size:.72rem;color:var(--muted);margin:0;line-height:1.5}
 .cover-note{font-size:.72rem;color:var(--muted);line-height:1.6;max-width:85ch;margin:12px 0 24px}
 .reference-composition .stream-section{padding:34px 0 18px;scroll-margin-top:170px}
 .reference-composition .stream-head{margin-bottom:18px}
 .reference-composition .stream-head p{font-size:.88rem;line-height:1.65}
 .reference-composition .stream-rail{gap:18px;padding-bottom:22px}
 .reference-composition .stream-card-media{border-radius:4px}
 .reference-composition .stream-card-body{padding:14px 2px 4px}
 .reference-composition .stream-card-body span{display:block;font-size:.7rem;letter-spacing:.06em;line-height:1.6}
 .reference-composition .stream-card-body h3{font-size:1.18rem;line-height:1.25;white-space:normal;overflow:visible;text-overflow:clip;display:block;margin:8px 0 0}
 .reference-composition .reference-card{border-radius:4px;text-decoration:none;color:inherit}
 .reference-composition .reference-body h2{font-size:1.5rem;line-height:1.2;overflow-wrap:anywhere}
 .reference-composition .reference-body p{min-height:0;margin-top:14px}
 .reference-composition .collection-head-hands{display:grid;grid-template-columns:minmax(0,1fr) 120px minmax(0,490px);align-items:center;gap:18px}
 .reference-composition .collection-hands-art{width:120px;display:grid;gap:5px;justify-items:center;margin:0}
 .reference-composition .collection-hands-art img{display:block;width:100%;height:auto;aspect-ratio:1;object-fit:cover;border:1px solid var(--line);border-radius:4px}
 .reference-composition .collection-hands-art figcaption{font-size:.58rem;line-height:1.4;text-align:center;color:var(--muted)}
 @media(max-width:900px){
  .reference-composition .collection-head-hands{grid-template-columns:minmax(0,1fr) 120px;gap:16px}
  .reference-composition .collection-head-hands .collection-hands-art{grid-column:2;grid-row:1/3;width:120px}
  .reference-composition .collection-head-hands>p{grid-column:1;grid-row:2;margin-top:0}
 }
 @media(max-width:760px){
  .reference-composition .stream-hero-copy .journey-next{font-size:.78rem;line-height:1.55}
  .collection-index{flex-wrap:nowrap;overflow-x:auto;scrollbar-width:thin;padding-bottom:14px}
  .collection-index a{flex-shrink:0}
  .reference-composition .stream-section{padding-top:26px}
  .reference-composition .collection-head-hands{grid-template-columns:minmax(0,1fr) 82px;align-items:start;gap:8px}
  .reference-composition .collection-head-hands .collection-hands-art{grid-column:2;grid-row:1/3;width:82px}
  .reference-composition .collection-head-hands>p{grid-column:1;grid-row:2;margin-top:0}
  .reference-composition .stream-card-body h3{font-size:1.12rem}
 }

 .stream-card-link,.reference-card-link{display:block;color:inherit;text-decoration:none}
 .compare-toggle{width:100%;margin-top:7px;padding:8px 10px;border:1px solid var(--line);border-radius:4px;background:#111214;color:var(--gold);font-size:.72rem;cursor:pointer}
 .compare-toggle:hover,.compare-toggle:focus-visible,.compare-toggle[aria-pressed="true"]{border-color:var(--gold);background:rgba(179,154,105,.09);color:var(--paper)}
 .compare-lab{scroll-margin-top:90px}
 .compare-empty{padding:18px;border:1px dashed var(--line);border-radius:6px;color:var(--muted);font-size:.86rem}
 .compare-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
 .compare-card{display:grid;grid-template-columns:110px 1fr;gap:14px;padding:12px;border:1px solid var(--line);border-radius:6px;background:#101011}
 .compare-card-art{position:relative;aspect-ratio:1;overflow:hidden;background:#161616}.compare-card-art img{width:100%;height:100%;object-fit:cover}.compare-card-art span{position:absolute;left:8px;top:8px;padding:4px 6px;background:#090909cc;border:1px solid var(--line);border-radius:999px;font-size:.62rem}
 .compare-card small{color:var(--gold);font-size:.66rem;line-height:1.4}.compare-card h3{font-size:1.35rem;line-height:1.05;margin:8px 0 14px}.compare-card button{border:0;background:none;color:var(--muted);padding:0;cursor:pointer;font-size:.7rem;text-decoration:underline}
 .compare-work{margin-top:16px}.compare-prompts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.compare-prompts article{padding:16px;border-top:1px solid var(--line)}.compare-prompts span{color:var(--gold);font-size:.64rem}.compare-prompts strong{display:block;margin:10px 0 6px}.compare-prompts p{margin:0;color:var(--muted);font-size:.8rem;line-height:1.5}
 .compare-note-label{display:block;margin:22px 0 8px;color:var(--gold);font-size:.7rem;letter-spacing:.1em;text-transform:uppercase}.compare-note{width:100%;resize:vertical;padding:14px;border:1px solid var(--line);border-radius:6px;background:#101011;color:var(--paper);font:inherit;line-height:1.55}.compare-note:focus{border-color:var(--gold);outline:none}.compare-clear{cursor:pointer;color:var(--paper);font:inherit}
 @media(max-width:900px){.compare-grid{grid-template-columns:1fr}.compare-prompts{grid-template-columns:1fr 1fr 1fr}}
 @media(max-width:650px){.compare-card{grid-template-columns:82px 1fr}.compare-prompts{grid-template-columns:1fr}.compare-work .actions{align-items:stretch}.compare-work .actions>*{justify-content:center}}

</style>
