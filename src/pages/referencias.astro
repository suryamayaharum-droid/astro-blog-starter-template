---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {referenceArtists,referenceCollections,byRank} from '../data/references';
const base=import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const featured=byRank(17)!;
const catalog=JSON.stringify(referenceArtists.map(a=>({rank:a.rank,slug:a.slug,name:a.name,focus:a.focus,videoId:a.videoId,lane:a.lane})));
---
<!doctype html><html lang="pt-BR"><head><BaseHead title="Atlas de Referências · Harum Noir" description="Um atlas visual de artistas, desenho, carvão, grafite, figura, processo e repertório."/></head>
<body><Header/><main class="stream-main">
<section class="stream-hero">
 <div class="stream-hero-media">
  <img src={featured.videoId ? 'https://i.ytimg.com/vi/'+featured.videoId+'/maxresdefault.jpg' : base+'noir/reference-fallback.svg'} alt="" onerror={"this.src='"+base+"noir/reference-fallback.svg'"}/>
 </div>
 <div class="stream-hero-shade"></div>
 <div class="stream-hero-copy">
   <span class="eyebrow">EM DESTAQUE · CARVÃO & MATÉRIA</span>
   <h1>{featured.name}</h1>
   <p>{featured.special}</p>
   <div class="actions"><a class="btn primary" href={base+'referencias/'+featured.slug}>Entrar nesta referência</a></div>
   <p class="journey-next">Fonte original: <a href={featured.youtube} target="_blank" rel="noreferrer">YouTube ↗</a></p>
 </div>
</section>

<section class="stream-search-shell">
  <input id="stream-search" class="stream-search" type="search" placeholder="Buscar artista, técnica, carvão, gesto…" aria-label="Buscar no atlas"/>
</section>

<section id="recent-section" class="stream-section" hidden>
 <div class="stream-head"><div><span class="eyebrow">SEU CAMINHO</span><h2>Continuar explorando</h2></div></div>
 <div id="recent-rail" class="stream-rail"></div>
</section>

<div id="collections-view">
{referenceCollections.map(col=>{
 const items=col.ranks.map(byRank).filter(Boolean);
 return <section class="stream-section" id={col.id}>
  <div class="stream-head"><div><span class="eyebrow">COLEÇÃO</span><h2>{col.title}</h2></div><p>{col.subtitle}</p></div>
  <div class="stream-rail">
   {items.map(a=><a class="stream-card" href={base+'referencias/'+a!.slug}>
    <div class="stream-card-media">
      <img class="stream-fallback" src={base+'noir/reference-fallback.svg'} alt="" />
      {a!.videoId&&<img class="stream-thumb" src={'https://i.ytimg.com/vi/'+a!.videoId+'/hqdefault.jpg'} alt={'Referência visual de '+a!.name} loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.remove()"/>}
      <span class="stream-rank">{String(a!.rank).padStart(2,'0')}</span>
    </div>
    <div class="stream-card-body"><span>{a!.focus}</span><h3>{a!.name}</h3></div>
   </a>)}
  </div>
 </section>
})}
</div>

<section id="search-view" class="stream-section" hidden>
 <div class="stream-head"><div><span class="eyebrow">BUSCA</span><h2>Resultados</h2></div></div>
 <div id="search-grid" class="reference-grid"></div>
 <p id="search-empty" class="ref-empty">Nenhuma referência encontrada.</p>
</section>

<section class="section"><div class="journal"><div class="paper">
<div class="eyebrow" style="color:#8a734b">COMO USAR ESTE ATLAS</div>
<h2>Referência não é destino.</h2>
<p class="lead">Olhe para decisões, não para superfícies.</p>
<p>Abra uma referência, observe um princípio e volte para o papel. O Atlas existe para ampliar repertório, não para substituir linguagem própria.</p>
<a href={base+'roubar-como-artista'}>Roubar como artista, sem virar cópia →</a>
</div></div></section>

<script is:inline define:vars={{catalog,base}}>
(()=>{
 const data=JSON.parse(catalog);
 const search=document.querySelector('#stream-search');
 const collections=document.querySelector('#collections-view');
 const searchView=document.querySelector('#search-view');
 const grid=document.querySelector('#search-grid');
 const empty=document.querySelector('#search-empty');
 const fallback=base+'noir/reference-fallback.svg';
 const card=(a)=>'<a class="reference-card" href="'+base+'referencias/'+a.slug+'"><div class="reference-media"><img class="reference-fallback" src="'+fallback+'" alt="">'+(a.videoId?'<img class="reference-thumb" src="https://i.ytimg.com/vi/'+a.videoId+'/hqdefault.jpg" alt="" loading="lazy" onerror="this.remove()">':'')+'<span class="reference-rank">'+String(a.rank).padStart(2,'0')+'</span></div><div class="reference-body"><span class="card-kicker">'+a.focus+'</span><h2>'+a.name+'</h2><p>Entrar na ficha →</p></div></a>';
 const apply=()=>{
   const q=(search?.value||'').toLowerCase().trim();
   if(!q){collections.hidden=false;searchView.hidden=true;return;}
   collections.hidden=true;searchView.hidden=false;
   const found=data.filter(a=>(a.name+' '+a.focus+' '+a.lane).toLowerCase().includes(q));
   grid.innerHTML=found.map(card).join('');empty.style.display=found.length?'none':'block';
 };
 search?.addEventListener('input',apply);
 const rec=JSON.parse(localStorage.getItem('noir_recent_refs')||'[]').filter(slug=>data.some(a=>a.slug===slug)).slice(0,8);
 if(rec.length){const section=document.querySelector('#recent-section');const rail=document.querySelector('#recent-rail');rail.innerHTML=rec.map(slug=>card(data.find(a=>a.slug===slug))).join('');section.hidden=false;}
})();
</script>
</main><Footer/></body></html>