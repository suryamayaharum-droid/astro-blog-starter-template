---
import LegacyRedirect from '../components/LegacyRedirect.astro';
const base=import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const target=`${base}carta/`;
---
<LegacyRedirect target={target} title="Carta HARUM NOIR" summary="Leia os textos editoriais e acompanhe as ideias que atravessam desenho, observação e processo." cta="Abrir a Carta" />
