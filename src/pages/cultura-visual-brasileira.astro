---
import PortugueseTopicHub from '../components/PortugueseTopicHub.astro';
const base=import.meta.env.BASE_URL.endsWith('/')?import.meta.env.BASE_URL:import.meta.env.BASE_URL+'/';
const cards=[
{kicker:'BNDIGITAL',title:'Comece pela Biblioteca Nacional.',text:'Pesquise gravuras, livros, mapas, periódicos e registros visuais brasileiros com contexto institucional e indicação de direitos.',href:base+'bancos/bndigital/',label:'Abrir guia BNDigital →'},
{kicker:'BAHIA & SALVADOR',title:'Leia o lugar como arquivo visual.',text:'Cruze Salvador e Bahia com gravuras oitocentistas, vistas portuárias, arquitetura, cartografia e publicações históricas.',href:base+'bancos/bndigital/',label:'Pesquisar Bahia e Salvador →'},
{kicker:'BOTÂNICA',title:'Estude a flora brasileira como forma.',text:'Ilustração botânica conecta observação científica, linha, ritmo, construção de ramos e repertório ornamental.',href:base+'bancos/',label:'Explorar arquivos visuais →'},
{kicker:'CULTURA IMPRESSA',title:'Observe como as imagens circularam.',text:'Periódicos ilustrados, gravuras, mapas e livros mostram como o formato de circulação muda a construção da imagem.',href:base+'historia-da-arte/',label:'Abrir História da Arte →'}
];
const answers=[
{question:'O que significa cultura visual brasileira aqui?',answer:'É estudar como o Brasil foi representado, impresso, cartografado e narrado visualmente em diferentes períodos, sempre retornando às fontes institucionais e ao contexto histórico.'},
{question:'Por que Bahia e Salvador são importantes?',answer:'Salvador e Bahia conectam história colonial, cultura portuária, arquitetura, imagens religiosas, registros botânicos, cartografia e cultura impressa do século XIX em um arquivo visual muito denso.'},
{question:'As imagens históricas são livres para reutilização?',answer:'Não automaticamente. Acesso público e domínio público são coisas diferentes. O status de direitos precisa ser confirmado na ficha institucional de cada item.'},
{question:'Como isso ajuda o desenho atual?',answer:'Imagens históricas ampliam repertório de composição, gesto, ornamento, vestuário, arquitetura, paisagem e botânica sem obrigar a imitar um estilo contemporâneo específico.'}
];
---
<PortugueseTopicHub title="Cultura Visual Brasileira · Bahia e Salvador | HARUM NOIR" description="Cultura visual brasileira através de Bahia, Salvador, Biblioteca Nacional Digital, gravuras, mapas, botânica e arquivos históricos." kicker="HARUM NOIR · CULTURA VISUAL BRASILEIRA" heading="Brasil como arquivo visual." lead="Pesquise Bahia, Salvador e a memória gráfica brasileira por coleções institucionais, gravuras históricas, mapas, periódicos e registros botânicos." cards={cards} answers={answers} enHref={base+'en/brazilian-visual-culture/'} esHref={base+'es/cultura-visual-brasilena/'} topics={['cultura visual brasileira','Bahia','Salvador','Biblioteca Nacional Digital','história gráfica brasileira','cartografia histórica','ilustração botânica']}/>