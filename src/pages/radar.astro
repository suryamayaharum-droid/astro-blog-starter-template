---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { radarHarumverso } from '../data/radarHarumverso';
const base=import.meta.env.BASE_URL.endsWith('/')?import.meta.env.BASE_URL:import.meta.env.BASE_URL+'/';
const laneLabels={processo:'PROCESSO',acervo:'ACERVO ABERTO',sketchbook:'SKETCHBOOK',outlier:'OUTLIER',escola:'ESCOLA'};
const grouped=['processo','acervo','sketchbook','escola','outlier'] as const;
const coveredRadar=radarHarumverso.filter(item=>item.cover);
---
<!doctype html><html lang="pt-BR"><head><BaseHead title="Radar · HARUM NOIR" description="Descobertas verificadas para o HARUM NOIR: desenho, carvão, figura, sketchbooks, processos, cursos, acervos e desvios editoriais."/></head><body class="has-page-wallpaper" style={"--page-wallpaper: url('" + base + "noir/visual-atlas/harum-cover-metalpoint.webp')"}><Header/><main class="radar-page">
<section class="page-hero"><div class="eyebrow">RADAR HARUM NOIR · PESQUISA VIVA</div><h1>O que entra no radar precisa voltar para a mão.</h1><p>{radarHarumverso.length} descobertas recentes, verificadas em fontes institucionais e organizadas pelo problema de desenho que ajudam a investigar. Cada cartão preserva fonte, direitos, princípio Noir e destino editorial.</p><div class="actions"><a class="btn gold" href="#ultimas">Ver últimas descobertas ↓</a><a class="btn" href={base+'biblioteca'}>Abrir Biblioteca</a></div></section>

<section class="section" id="ultimas"><div class="section-head"><div><div class="eyebrow">ÚLTIMAS ENTRADAS</div><h2>Pesquisa que já tem destino.</h2></div><p>Capas e estudos do HARUM NOIR são editoriais e não substituem a obra ou o vídeo original. A fonte primária permanece sempre a porta principal.</p></div>
<div class="radar-grid">{radarHarumverso.slice(0,8).map((item,i)=><a class="radar-card" href={item.url} target="_blank" rel="noreferrer"><span class="radar-index">{String(i+1).padStart(2,'0')}</span><small>{item.date} · {laneLabels[item.lane]}</small><h3>{item.title}</h3><b>{item.creator}</b><p>{item.note}</p><footer><span>{item.source}</span><span>{item.rights}</span></footer></a>)}</div></section>

<section class="section" id="capas-editoriais"><div class="section-head"><div><div class="eyebrow">CAPAS EDITORIAIS · HARUM NOIR</div><h2>Referência com identidade própria.</h2></div><p>Estas capas são composições editoriais originais do HARUM NOIR e não reproduções das obras citadas.</p></div><div class="cover-rail">{coveredRadar.map(item=><a class="cover-card" href={item.url} target="_blank" rel="noreferrer"><img src={base+'noir/visual-atlas/'+item.cover+'.webp'} alt={'Capa editorial HARUM NOIR para '+item.title} width="640" height="360" loading="lazy"/><div><small>{item.source}</small><h3>{item.title}</h3><p>{item.creator}</p><span>Abrir fonte original ↗</span></div></a>)}</div></section>

{grouped.map(lane=>{const items=radarHarumverso.filter(i=>i.lane===lane);return <section class="section" id={'lane-'+lane}><div class="stream-head"><div><span class="eyebrow">{laneLabels[lane]}</span><h2>{lane==='processo'?'Processos para observar':lane==='acervo'?'Obras abertas para estudar':lane==='sketchbook'?'Cadernos, arquivos e continuidade':lane==='escola'?'Recursos para praticar':'Desvios editoriais úteis'}</h2></div><p>{items.length} entradas nesta trilha.</p></div><div class="radar-rail">{items.map(item=><a class="radar-mini" href={item.url} target="_blank" rel="noreferrer"><small>{item.source}</small><h3>{item.title}</h3><p>{item.principle}</p><span>{item.destination} ↗</span></a>)}</div></section>})}

<section class="section"><div class="journal"><div class="paper"><div class="eyebrow" style="color:#8a734b">REGRA DO RADAR</div><h2>Descobrir não basta.</h2><p class="lead">Só entra o que consegue melhorar repertório, método, narrativa ou navegação.</p><p>Cada item deve ter fonte verificável, status de direitos, princípio assimilável sem imitação e um destino exato dentro do HARUM NOIR.</p></div></div></section>
</main><Footer/>
<style>
.radar-page .page-hero{max-width:1120px}.radar-page .page-hero h1{max-width:15ch;font-size:clamp(3.2rem,7vw,7rem)}
.radar-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.radar-card{position:relative;display:flex;flex-direction:column;min-height:330px;padding:24px;border:1px solid var(--line);border-radius:16px;background:linear-gradient(145deg,#111214,#0d0d0e);text-decoration:none;color:inherit;transition:.2s}.radar-card:hover{border-color:var(--gold);transform:translateY(-2px)}.radar-index{position:absolute;top:18px;right:18px;color:var(--gold);font-size:.7rem}.radar-card>small{color:var(--gold);font-size:.66rem;letter-spacing:.11em}.radar-card h3{font-size:clamp(1.65rem,3vw,2.5rem);line-height:1.02;margin:28px 0 7px}.radar-card>b{font-size:.82rem;color:var(--paper-2)}.radar-card>p{flex:1;max-width:52ch;color:var(--paper-2)}.radar-card footer{display:flex;flex-wrap:wrap;gap:7px;margin-top:18px}.radar-card footer span{padding:5px 8px;border:1px solid var(--line);border-radius:999px;font-size:.65rem;color:var(--muted)}
.radar-rail{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(270px,32vw);gap:12px;overflow-x:auto;scroll-snap-type:x mandatory;padding:4px 2px 16px}.radar-mini{scroll-snap-align:start;display:flex;flex-direction:column;min-height:230px;padding:20px;border:1px solid var(--line);border-radius:14px;background:#101011;text-decoration:none;color:inherit}.radar-mini small{color:var(--gold);letter-spacing:.1em;font-size:.63rem}.radar-mini h3{font-size:1.45rem;line-height:1.04;margin:18px 0 8px}.radar-mini p{color:var(--paper-2);flex:1}.radar-mini span{font-size:.72rem;color:var(--gold)}
.cover-rail{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(320px,46vw);gap:14px;overflow-x:auto;scroll-snap-type:x mandatory;padding:4px 2px 18px}.cover-card{scroll-snap-align:start;display:block;border:1px solid var(--line);border-radius:16px;overflow:hidden;background:#101011;text-decoration:none;color:inherit}.cover-card img{display:block;width:100%;aspect-ratio:16/9;object-fit:cover;filter:saturate(.72)}.cover-card>div{padding:18px}.cover-card small{color:var(--gold);font-size:.65rem;letter-spacing:.1em}.cover-card h3{font-size:1.55rem;line-height:1.06;margin:10px 0 6px}.cover-card p{color:var(--paper-2);margin:0 0 14px}.cover-card span{font-size:.72rem;color:var(--gold)}
@media(max-width:760px){.radar-grid{grid-template-columns:1fr}.radar-rail{grid-auto-columns:82vw}.radar-card{min-height:300px}.cover-rail{grid-auto-columns:88vw}}
</style></body></html>