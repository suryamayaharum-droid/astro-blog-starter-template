---
import LegacyRedirect from '../components/LegacyRedirect.astro';
const base=import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const target=`${base}historia-da-arte/`;
---
<LegacyRedirect target={target} title="História da arte" summary="Entre na linha do tempo e conecte períodos, obras e fontes institucionais a perguntas de desenho." cta="Abrir História da arte" />
