---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import {referenceArtists,referenceCollections} from '../../data/references';
export function getStaticPaths(){return referenceArtists.map(artist=>({params:{slug:artist.slug},props:{artist}}));}
const {artist}=Astro.props;
const base=import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const relatedRanks=referenceCollections.find(c=>c.ranks.includes(artist.rank))?.ranks.filter(r=>r!==artist.rank).slice(0,6)||[];
const related=relatedRanks.map(r=>referenceArtists.find(a=>a.rank===r)).filter(Boolean);
const visualFor=(focus:string)=>{const f=focus.toLowerCase();return f.includes("carv")?"harum-noir-caderno-estudo.webp":f.includes("jap")||f.includes("ukiyo")?"moonlit-landscape.webp":f.includes("museu")||f.includes("arquivo")?"museum-gallery.webp":f.includes("botan")||f.includes("flor")?"iris-study.webp":f.includes("gesto")||f.includes("mão")?"tools-paper.webp":f.includes("sketch")||f.includes("caderno")?"open-sketchbook.webp":"harum-noir-caderno-estudo.webp";};
const hero=base+"noir/visual-atlas/"+visualFor(artist.focus);
const videoId=/^[A-Za-z0-9_-]{11}$/.test(artist.videoId||"")?artist.videoId:"";
const videoChoices:{id:string;title:string}[]=[];
if(videoId)videoChoices.push({id:videoId,title:artist.refs.find((ref:any)=>ref.url==="https://www.youtube.com/watch?v="+videoId)?.title||"Vídeo principal"});
for(const ref of artist.refs){
 try{
  const url=new URL(ref.url);
  const id=url.searchParams.get("v")||"";
  if(url.protocol==="https:"&&["www.youtube.com","youtube.com"].includes(url.hostname)&&url.pathname==="/watch"&&/^[A-Za-z0-9_-]{11}$/.test(id)&&!videoChoices.some(v=>v.id===id))videoChoices.push({id,title:ref.title});
 }catch{}
}
const videoUrl=videoId?"https://www.youtube-nocookie.com/embed/"+videoId+"?rel=0&playsinline=1&hl=pt-BR":"";
const officialSources=[artist.site,artist.youtube,artist.instagram].filter(Boolean);
const displayedRefs=artist.refs.filter((ref:any)=>{
  const host=new URL(ref.url).hostname.toLowerCase();
  return host!=='vidiq.com'&&!host.endsWith('.vidiq.com');
}).filter((ref:any,index:number,list:any[])=>list.findIndex(item=>item.url===ref.url)===index);
const referenceSchema={
  '@context':'https://schema.org',
  '@type':'LearningResource',
  name:'Guia de estudo · '+artist.name,
  description:artist.special,
  inLanguage:'pt-BR',
  educationalUse:'Study',
  learningResourceType:'Artist reference profile',
  url:new URL(base+'referencias/'+artist.slug+'/',Astro.site).href,
  keywords:[artist.focus,artist.lane,artist.archetype].filter(Boolean),
  publisher:{'@type':'Organization','name':'Arte Harum · HARUM NOIR','url':new URL(base,Astro.site).href},
  isPartOf:{'@type':'CollectionPage','name':'Atlas de Referências · Harum Noir','url':new URL(base+'referencias/',Astro.site).href},
  about:{
    '@type':'Thing',
    name:artist.name,
    description:artist.focus,
    sameAs:officialSources
  },
  hasPart:displayedRefs.map((ref:any)=>({
    '@type':'CreativeWork',
    name:ref.title,
    description:ref.observe,
    url:ref.url,
    keywords:ref.tags
  }))
};
const breadcrumbSchema={
  '@context':'https://schema.org',
  '@type':'BreadcrumbList',
  itemListElement:[
    {'@type':'ListItem','position':1,'name':'HARUM NOIR','item':new URL(base,Astro.site).href},
    {'@type':'ListItem','position':2,'name':'Atlas de Referências','item':new URL(base+'referencias/',Astro.site).href},
    {'@type':'ListItem','position':3,'name':artist.name,'item':new URL(base+'referencias/'+artist.slug+'/',Astro.site).href}
  ]
};
---
<!doctype html><html lang="pt-BR"><head><BaseHead title={artist.name+' · Referências · Harum Noir'} description={artist.special}/><script type="application/ld+json" set:html={JSON.stringify(referenceSchema)} /><script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} /></head><body><Header/><main class="stream-main">
<section class="profile-hero">
 <div class="profile-media"><img src={hero} alt={"Capa temática HARUM NOIR; não representa obra de "+artist.name}/></div>
 <div class="profile-shade"></div>
 <div class="profile-copy"><span class="eyebrow">ATLAS · {String(artist.rank).padStart(2,'0')}</span><h1>{artist.name}</h1><p>{artist.special}</p><small class="cover-credit">Capa temática HARUM NOIR · criada com assistência de IA; não representa obra do artista.</small><div class="actions">
   {artist.youtube&&<a class="btn primary" href={artist.youtube} target="_blank" rel="noreferrer">YouTube ↗</a>}
   {artist.instagram&&<a class="btn" href={artist.instagram} target="_blank" rel="noreferrer">Instagram ↗</a>}
   {artist.site&&<a class="btn" href={artist.site} target="_blank" rel="noreferrer">Site oficial ↗</a>}
 </div></div>
</section>
<section class="section editorial-split">
 <div class="panel"><div class="eyebrow">O QUE OBSERVAR</div><h2>{artist.focus}</h2><p>{artist.special}</p></div>
 <div class="panel"><div class="eyebrow">LEITURA</div><div class="quote">{artist.archetype}</div><p>Use esta ficha como ponto de partida. O aprofundamento deve acontecer sempre nas fontes originais.</p></div>
</section>
{videoUrl&&<section class="section artist-player" data-artist-player><div class="stream-head"><div><span class="eyebrow">VÍDEO DA FONTE ORIGINAL</span><h2>Assistir a {artist.name}</h2></div><a class="btn" data-player-fallback href={"https://www.youtube.com/watch?v="+videoId} target="_blank" rel="noreferrer">Abrir no YouTube ↗</a></div><div class="player-frame"><iframe src={videoUrl} title={"Vídeo de referência de "+artist.name} loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe></div>{videoChoices.length>1&&<div class="player-queue-shell"><div class="player-queue-label">Continuar assistindo</div><div class="player-queue" role="list" aria-label={"Vídeos selecionados de "+artist.name}>{videoChoices.map((video,index)=><button type="button" class="player-choice" data-player-choice data-video-id={video.id} data-video-title={video.title} aria-pressed={index===0?"true":"false"}><span class="player-choice-media"><img src={"https://i.ytimg.com/vi/"+video.id+"/mqdefault.jpg"} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.remove()"/></span><span class="player-choice-copy"><small>{index===0?"EM REPRODUÇÃO":"VÍDEO"}</small><strong>{video.title}</strong></span></button>)}</div></div>}<p class="player-note">Vídeo da fonte original, sem reprodução automática. Alguns canais podem desativar a reprodução incorporada; nesse caso, use “Abrir no YouTube”.</p></section>}
{displayedRefs.length>0&&<section class="stream-section"><div class="stream-head"><div><span class="eyebrow">FONTES PARA CONFERIR</span><h2>Abra o registro original</h2></div><p>Use as fontes para confirmar autoria, título e contexto. Links de métricas de terceiros, sem o vídeo ou a obra citados, não aparecem como referências de estudo.</p></div><div class="reference-grid">
 {displayedRefs.map(ref=><a class="archive-item ref-source" href={ref.url} target="_blank" rel="noreferrer"><span class="card-kicker">{ref.type}</span><h3>{ref.title}</h3><p>{ref.observe}</p><span class="source-arrow">Abrir fonte ↗</span></a>)}
</div></section>}
<section class="section reference-practice" aria-labelledby="reference-practice-title">
 <div class="journal"><div class="paper">
  <div class="eyebrow">ESTUDO DE REFERÊNCIA · 10 MINUTOS</div>
  <h2 id="reference-practice-title">Leve uma decisão para o papel.</h2>
  <p class="lead">Use uma fonte original de {artist.name} como ponto de partida. Escolha uma decisão visual: gesto, valor, borda, ritmo ou composição.</p>
  <ol>
   <li><b>2 minutos · Observar.</b> Reduza o que viu a três linhas ou massas. Deixe os detalhes para depois.</li>
   <li><b>5 minutos · Estudar.</b> Faça um desenho pequeno concentrado naquela decisão, sem copiar a imagem inteira.</li>
   <li><b>3 minutos · Transformar.</b> Mude o corte, a direção ou o espaço e crie uma segunda versão com uma escolha sua.</li>
  </ol>
  <div class="rule"><b>Vestígio:</b> anote qual decisão mudou mais o desenho e registre a fonte que observou.</div>
  <div class="actions"><a class="btn gold" href={base+'cadernos/#presenca'}>Levar ao Caderno de Presença →</a></div>
 </div></div>
</section>
{related.length>0&&<section class="stream-section"><div class="stream-head"><div><span class="eyebrow">CONTINUE</span><h2>Na mesma vizinhança</h2></div></div><div class="stream-rail">
 {related.map(a=><a class="stream-card" href={base+'referencias/'+a!.slug}><div class="stream-card-media"><img class="stream-fallback" src={base+'noir/visual-atlas/'+visualFor(a!.focus)} alt=""/>{a!.videoId&&a!.slug!=='zin-lim'&&<img class="stream-thumb" src={'https://i.ytimg.com/vi/'+a!.videoId+'/hqdefault.jpg'} alt="" loading="lazy" onerror="this.remove()"/>}</div><div class="stream-card-body"><span>{a!.focus}</span><h3>{a!.name}</h3></div></a>)}
</div></section>}
<script>
document.querySelectorAll<HTMLElement>("[data-artist-player]").forEach(section=>{
 const frame=section.querySelector<HTMLIFrameElement>("iframe");
 const fallback=section.querySelector<HTMLAnchorElement>("[data-player-fallback]");
 const choices=[...section.querySelectorAll<HTMLButtonElement>("[data-player-choice]")];
 if(!frame||!fallback)return;
 const artistTitle=frame.title;
 const activate=(button:HTMLButtonElement)=>{
  const id=button.dataset.videoId||"";
  if(!/^[A-Za-z0-9_-]{11}$/.test(id))return;
  const title=button.dataset.videoTitle||button.textContent?.trim()||"Vídeo";
  const url=new URL(frame.src);
  url.pathname="/embed/"+id;
  frame.src=url.toString();
  frame.title=artistTitle+" — "+title;
  fallback.href="https://www.youtube.com/watch?v="+id;
  choices.forEach(choice=>{
   const active=choice===button;
   choice.setAttribute("aria-pressed",active?"true":"false");
   const label=choice.querySelector("small");
   if(label)label.textContent=active?"EM REPRODUÇÃO":"VÍDEO";
  });
 };
 choices.forEach(choice=>choice.addEventListener("click",()=>activate(choice)));
});
</script>
<script is:inline define:vars={{slug:artist.slug}}>
(()=>{try{const k='noir_recent_refs';let raw;try{raw=JSON.parse(localStorage.getItem(k)||'[]')}catch{raw=[]}const a=(Array.isArray(raw)?raw:[]).filter(x=>typeof x==='string'&&x!==slug);a.unshift(slug);localStorage.setItem(k,JSON.stringify(a.slice(0,12)))}catch{}})();
</script>
</main><Footer/><style>.cover-credit{display:block;max-width:580px;color:#aaa49b;font-size:.7rem;line-height:1.5;margin-bottom:12px}.artist-player{max-width:1160px;margin-inline:auto}.player-frame{aspect-ratio:16/9;min-height:220px;background:radial-gradient(circle at 70% 18%,rgba(179,154,105,.12),transparent 28%),#090909;border:1px solid rgba(179,154,105,.28);border-radius:16px;overflow:hidden;box-shadow:0 28px 80px rgba(0,0,0,.28)}.player-frame iframe{display:block;width:100%;height:100%;border:0}.player-queue-shell{margin-top:18px}.player-queue-label{font-size:.68rem;letter-spacing:.12em;text-transform:uppercase;color:#aaa49b;margin-bottom:10px}.player-queue{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(220px,30%);gap:12px;overflow-x:auto;overscroll-behavior-inline:contain;scroll-snap-type:x proximity;padding:0 2px 12px;scrollbar-width:thin}.player-choice{appearance:none;display:grid;grid-template-columns:112px minmax(0,1fr);gap:12px;align-items:center;min-height:78px;padding:0;border:1px solid rgba(179,154,105,.22);border-radius:12px;overflow:hidden;background:#11100f;color:#eee7dc;text-align:left;cursor:pointer;scroll-snap-align:start;transition:border-color .18s,transform .18s,background .18s}.player-choice:hover{border-color:rgba(179,154,105,.62);transform:translateY(-1px)}.player-choice[aria-pressed="true"]{border-color:#b39a69;background:#181510}.player-choice:focus-visible{outline:2px solid #b39a69;outline-offset:3px}.player-choice-media{display:block;height:100%;min-height:78px;background:radial-gradient(circle at 72% 22%,rgba(179,154,105,.18),transparent 32%),#090909}.player-choice-media img{display:block;width:100%;height:100%;min-height:78px;object-fit:cover}.player-choice-copy{display:grid;gap:6px;padding:10px 12px 10px 0;min-width:0}.player-choice-copy small{font-size:.6rem;letter-spacing:.09em;color:#b39a69}.player-choice-copy strong{font-size:.82rem;line-height:1.35;font-weight:600;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}.player-note{color:#aaa49b;font-size:.82rem;margin-top:10px}@media(max-width:760px){.player-queue{grid-auto-columns:minmax(260px,82%)}.player-choice{grid-template-columns:104px minmax(0,1fr)}}@media(prefers-reduced-motion:reduce){.player-choice{transition:none}.player-choice:hover{transform:none}}</style></body></html>

