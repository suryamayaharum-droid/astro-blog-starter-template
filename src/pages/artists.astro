---
import LegacyRedirect from '../components/LegacyRedirect.astro';
const base=import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const target=`${base}referencias/`;
---
<LegacyRedirect target={target} title="Referências de desenho" summary="Acesse o atlas de artistas e processos para comparar decisões visuais e voltar ao seu próprio estudo." cta="Abrir Referências" />
