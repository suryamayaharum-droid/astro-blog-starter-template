---
import EditorialScene from '../components/EditorialScene.astro';
import '../styles/composition.css';
import EcosystemRail from '../components/EcosystemRail.astro';
import BaseHead from '../components/BaseHead.astro';import Header from '../components/Header.astro';import Footer from '../components/Footer.astro';import {cadernos} from '../data/public';const base=import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const visualSets=[
 {items:[{file:"harum-noir-caderno-estudo.webp",alt:"Mão desenha um modelo articulado ao lado de caderno, íris botânica e tecido apagado.",caption:"Eixo, peso e relações entre formas."},{file:"exercicio-quatro-decisoes.webp",alt:"Quatro etapas de um estudo de pera e tecido: gesto, massas tonais, bordas e detalhes.",caption:"Separar massa, borda e foco."}]},
 {items:[{file:"maos-seis-gestos.webp",alt:"Seis posições de mãos para observar repouso, toque, pressão e tensão.",caption:"Direção e pressão da mão."},{file:"harum-noir-hands-study.webp",alt:"Estudos editoriais de mãos construídas em carvão.",caption:"Ritmo antes do contorno."}]},
 {items:[{file:"harum-noir-caderno-olhar.webp",alt:"Estudo de um olho em carvão e duas variações de direção do olhar.",caption:"Globo, pálpebras e direção."},{file:"iris-study.webp",alt:"Estudo botânico de íris em grafite e carvão.",caption:"Observar forma e valor."}]},
 {items:[{file:"open-sketchbook.webp",alt:"Caderno aberto em uma composição de ateliê.",caption:"A referência some; o caderno permanece."},{file:"harum-noir-caderno-estudo.webp",alt:"Caderno com desenho leve de planta feito a partir da memória.",caption:"Reconstruir sem consultar."}]},
 {items:[{file:"drapery-still-life.webp",alt:"Estudo de tecido e volume em carvão.",caption:"Deixar algumas bordas desaparecerem."},{file:"harum-noir-caderno-estudo.webp",alt:"Tecido com marcas apagadas e resíduos de carvão sobre papel.",caption:"Apagar também registra uma decisão."}]}
];
---
<!doctype html><html lang="pt-BR"><head><BaseHead title="Cadernos de Presença · Harum Noir" description="Uma série editorial de desenho, gesto, olhar, memória e vestígio."/></head><body><Header/><main class="history-composition notebooks-composition">
<section class="page-hero"><div class="editorial-opening-copy"><div class="eyebrow">CADERNOS DE PRESENÇA</div><h1>Desenhar para permanecer.</h1><p>Os cadernos são investigações abertas: uma pergunta, uma prática e um vestígio para carregar ao próximo encontro.</p></div><EditorialScene image="open-sketchbook" alt="Caderno aberto em composição temática de ateliê"/></section>
<nav class="notebook-index" aria-label="Escolher um caderno">{cadernos.map(c=><a href={'#'+c.slug}>{c.title}</a>)}</nav>
{cadernos.map((c,i)=><section class="section editorial-split" id={c.slug}>
  <div class="card"><div class="card-media" style="aspect-ratio:4/3"><img src={`${base}noir/${c.image}`} alt={c.imageAlt} loading="lazy" decoding="async"/><span class="media-credit">Prancha editorial HARUM NOIR · estudo com assistência de IA</span></div></div>
  <div class="panel"><div class="eyebrow">{c.kicker}</div><h2>{c.title}</h2><p>{c.summary}</p><div class="caderno-visual-set" aria-label={"Coleção visual · "+c.title}>{visualSets[i].items.map(item=><figure><img src={base+"noir/visual-atlas/"+item.file} alt={item.alt} loading="lazy" decoding="async"/><figcaption>{item.caption}</figcaption></figure>)}</div><div class="caderno-cycle"><p><b>Pergunta</b>{c.question}</p><p><b>Prática</b>{c.practice}</p><p><b>Vestígio</b>{c.residue}</p></div>{c.slug==="presenca"&&<div class="actions"><a class="btn" href={base+"cadernos/presenca"}>Entrar no Caderno Presença →</a></div>}{c.slug==="gesto"&&<div class="actions"><a class="btn" href={base+"cadernos/gesto"}>Entrar no Caderno Gesto →</a></div>}{c.slug==="olhar"&&<div class="actions"><a class="btn" href={base+"cadernos/olhar"}>Entrar no Caderno Olhar →</a></div>}{c.slug==="memoria"&&<div class="actions"><a class="btn" href={base+"cadernos/memoria"}>Entrar no Caderno Memória →</a></div>}{c.slug==="vestigio"&&<div class="actions"><a class="btn" href={base+"cadernos/vestigio"}>Entrar no Caderno Vestígio →</a></div>}</div>
</section>)}
<section class="section"><div class="journal"><div class="paper"><h2>Um caderno não termina quando a folha termina.</h2><p class="lead">Leve uma pergunta para o próximo desenho.</p><p>O objetivo não é completar todos os exercícios. É perceber quais problemas continuam voltando e merecem virar estudo, aula ou projeto.</p><ol><li><b>O que funcionou?</b> Nomeie uma decisão que você repetiria.</li><li><b>O que voltou a incomodar?</b> Transforme o erro recorrente em pergunta de estudo.</li><li><b>O que vem depois?</b> Escolha uma única prática seguinte.</li></ol><div class="actions"><a class="btn gold" href={base+'atelier'}>Levar a pergunta para o Ateliê →</a><a class="btn" href={base+'maos#exercicio'}>Prática de mãos · 15 min →</a></div></div></div></section>
<section class="section"><div class="panel"><div class="eyebrow">ARQUIVO VIVO</div><h2>O caderno como sequência de pensamento.</h2><p>Sketchbooks históricos ajudam a observar tentativa, pausa, repetição, anotação e retorno. Use a referência para entender como uma investigação continua entre páginas — não para transformar o caderno em galeria de peças prontas.</p><div class="actions"><a class="btn gold" href={base+'biblioteca#arquivo-vivo-sketchbooks'}>Abrir sketchbooks históricos →</a></div></div></section>
<EcosystemRail current="cadernos" limit={5} />
</main><Footer/></body></html>
<style>
.caderno-visual-set{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin:20px 0 24px}.caderno-visual-set figure{min-width:0;margin:0;border:1px solid var(--line);background:#101010}.caderno-visual-set img{display:block;width:100%;height:clamp(130px,17vw,230px);object-fit:cover}.caderno-visual-set figcaption,.media-credit{display:block;padding:8px 10px;color:var(--paper-2);font-size:.68rem;line-height:1.45;border-top:1px solid var(--line)}
.notebook-index{display:flex;flex-wrap:wrap;gap:10px;padding:12px 0 30px;border-bottom:1px solid var(--line)}
.notebook-index a{padding:12px 16px;border:1px solid var(--line);border-radius:4px;color:var(--paper);text-decoration:none;font-size:14px}
.notebook-index a:hover,.notebook-index a:focus-visible{border-color:var(--gold)}
.notebooks-composition .editorial-split{gap:clamp(24px,5vw,72px);padding-top:56px;scroll-margin-top:100px}
.notebooks-composition .editorial-split .card{border-radius:4px;overflow:hidden}
.notebooks-composition .editorial-split .panel{padding:clamp(22px,3vw,40px);border-radius:4px}
.notebooks-composition .editorial-split h2{font-size:clamp(2.3rem,4vw,4rem);line-height:1.05}
.notebooks-composition .editorial-split p{font-size:16px;line-height:1.7;max-width:54ch}
@media(max-width:760px){.notebooks-composition .editorial-split{padding-top:32px;gap:20px}.notebook-index a{padding:10px 12px}.caderno-visual-set{gap:8px}.caderno-visual-set img{height:150px}}
</style>
