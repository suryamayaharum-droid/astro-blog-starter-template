---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { regularLessons, regularModules } from '../data/regularProgram';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const movements = [
  {n:'01',name:'Notar',core:'Observação sem automatismos visuais',question:'O que realmente está à minha frente?',time:'15 minutos',image:'iris-study',study:'Desenhe uma folha em três passagens: contorno observado, espaço negativo e cinco relações medidas. Não corrija por memória.',check:'Marque três diferenças entre a imagem mental e a observação.',lesson:0},
  {n:'02',name:'Organizar',core:'Eixo, proporção e apoio',question:'O que sustenta esta forma?',time:'25 minutos',image:'figure-gesture',study:'Desenhe seis gestos de 60 segundos. Em dois deles, acrescente eixo, planos principais, gravidade e ponto de contato com o chão.',check:'A pose ainda é reconhecível sem olhos, mãos e detalhes?',lesson:1},
  {n:'03',name:'Inscrever',core:'Valor, matéria e superfície',question:'Onde o gesto vira corpo?',time:'35 minutos',image:'estudo-tonal-pera',study:'Traduza a mesma natureza-morta em linha, massa tonal e retirada de carvão. Reserve pelo menos um terço do papel sem marca.',check:'A luz é legível sem contorno fechado?',lesson:6},
  {n:'04',name:'Romper',core:'Acaso controlado e desenho automático',question:'O que aparece antes de eu decidir?',time:'20 minutos',image:'harum-noir-caderno-olhar',study:'Trace continuamente por quatro minutos sem planejar uma figura. Rode a folha, encontre três relações inesperadas e desenvolva só uma delas com estrutura observada.',check:'É possível localizar a marca livre e a decisão posterior sem confundi-las?',lesson:8},
  {n:'05',name:'Relembrar',core:'Memória, variação e edição',question:'O que permanece quando retiro a referência?',time:'30 minutos',image:'open-sketchbook',study:'Observe um objeto por 90 segundos. Esconda-o e desenhe da memória. Volte a observá-lo, anote os equívocos e produza outra versão alterando o enquadramento.',check:'Você anotou uma invenção involuntária e uma correção observada?',lesson:3},
  {n:'06',name:'Resolver',core:'Síntese autoral e presença',question:'Qual decisão pertence à minha linguagem?',time:'90 minutos',image:'harum-noir-caderno-estudo',study:'Reúna gesto humano, ramo botânico e campo vazio em três miniaturas. Escolha uma, execute em carvão e guarde referência, esboço e versão final separadamente.',check:'É possível explicar uma escolha de peso, borda e silêncio sem dizer apenas que gostou?',lesson:32},
];
const labs=[
  {title:'Linha sem roteiro',length:'4 min',action:'Deixe a linha percorrer o papel sem tema prévio. Não apague. Depois sublinhe, com outra ferramenta, as relações emergentes.'},
  {title:'Mão não dominante',length:'6 min',action:'Desenhe um objeto próximo com a mão não dominante. Troque a velocidade, não o objeto. Compare direção e ritmo.'},
  {title:'Desenho cego',length:'7 min',action:'Olhe apenas para a mão real e percorra seu contorno lentamente. Faça depois uma versão de medição acadêmica.'},
  {title:'Frottage e invenção',length:'12 min',action:'Obtenha a textura de uma superfície permitida por fricção. Identifique formas acidentais e componha ao redor, sem esconder a origem.'},
  {title:'Cadáver esquisito individual',length:'15 min',action:'Dobre a folha em três. Crie partes sem ver as anteriores, revele, compare ritmos e faça uma síntese observada.'},
  {title:'Da mancha ao eixo',length:'20 min',action:'Faça uma mancha gestual a carvão. Encontre uma figura possível e construa eixos/proporções sem apagar a primeira camada.'}
];
---
<!doctype html><html lang="pt-BR"><head><BaseHead title="Harum Noir Method · Fundamento, acaso e autoria" description="Método autoral de desenho HARUM NOIR: observar, organizar, inscrever, romper, relembrar e resolver. Exercícios de desenho acadêmico, gesto, esboço e automatismo com referências e fontes." /></head>
<body class="noir-method"><Header/>
<main>
<nav class="method-crumb" aria-label="Caminho"><a href={base}>Início</a><span>/</span><a href={base+'escola/'}>Escola</a><span>/</span><span>Harum Noir Method</span></nav>
<section class="method-hero">
 <div class="method-hero-copy"><span class="eyebrow">TRAÇO · CORPO · PRESENÇA / MÉTODO AUTORAL</span><h1>Dominar a forma.<br/><em>Permitir o inesperado.</em></h1><p>O <strong>Harum Noir Method</strong> une o rigor da observação acadêmica à liberdade do traço automático. A referência oferece uma pergunta, o corpo oferece uma experiência e a revisão transforma tudo em escolha própria.</p><div class="method-hero-actions"><a class="btn gold" href="#movimentos">Iniciar o percurso ↓</a><a class="btn" href={base+'galeria-viva/'}>Entrar na galeria viva ↗</a></div><p class="method-small">Método editorial independente: síntese didática autoral, não atribuição a um professor ou movimento histórico específico.</p></div>
 <figure><img src={base+'noir/visual-atlas/harum-noir-caderno-estudo.webp'} alt="Caderno, estudos de mão, figura e botânica em cenário editorial de carvão." width="1200" height="800" fetchpriority="high"/><figcaption>Composição editorial criada com assistência de IA; não é obra histórica.</figcaption></figure>
</section>
<section class="method-manifesto" aria-labelledby="manifesto-title"><span class="eyebrow">ARQUITETURA DO MÉTODO</span><h2 id="manifesto-title">Duas inteligências de desenho, uma mesma mão.</h2><div class="method-duo"><article><b>Estrutura</b><p>Contorno, comparação, perspectiva, eixos, anatomia artística, valor e direção da luz dão clareza e capacidade de corrigir.</p></article><article><b>Liberdade</b><p>Desenho cego, linha contínua, improvisação, frottage, memória e automatismo abrem caminhos que a representação planejada não prevê.</p></article></div><p class="method-rule">Regra Noir: <strong>ver → estruturar → soltar → selecionar → refazer.</strong> Não se confunde espontaneidade com ausência de estudo, nem técnica com repetição da assinatura de outra pessoa.</p></section>
<section class="method-section" id="movimentos"><div class="method-title"><div><span class="eyebrow">SEIS MOVIMENTOS · SEIS DECISÕES</span><h2>Um método que respira.</h2></div><p>Uma prática por movimento. Retorne ao primeiro sempre que a forma perder vida ou a liberdade perder direção.</p></div><div class="method-grid">{movements.map((m)=><article class="method-card" id={'movimento-'+m.n}><img src={base+'noir/visual-atlas/'+m.image+'.webp'} alt="" width="760" height="510" loading="lazy"/><div class="method-card-content"><span class="method-number">{m.n} / {m.core}</span><h3>{m.name}</h3><blockquote>{m.question}</blockquote><p>{m.study}</p><div class="method-verification"><b>Critério de revisão</b><p>{m.check}</p></div><div class="method-card-foot"><span>{m.time}</span><a href={base+'escola/programa-regular/'+regularLessons[m.lesson].slug+'/'}>Aula relacionada ↗</a></div></div></article>)}</div></section>
<section class="method-section" id="automatismo"><div class="method-title"><div><span class="eyebrow">LABORATÓRIO LIVRE</span><h2>Seis portas para o acaso.</h2></div><p>Exercícios inéditos na combinação e sequência editorial Noir, dialogando com tradições documentadas de automatismo e desenho de observação.</p></div><ol class="method-labs">{labs.map((l,i)=><li><span>{String(i+1).padStart(2,'0')}</span><div><h3>{l.title}</h3><p>{l.action}</p></div><small>{l.length}</small></li>)}</ol><div class="method-sources"><p><strong>Contexto histórico:</strong> o MoMA registra o automatismo entre as práticas exploradas por artistas surrealistas. Isso não significa que as obras do MoMA estejam em domínio público; aqui são indicadas como fonte de pesquisa, não reproduzidas sem licença.</p><a href="https://www.moma.org/collection/terms/automatism" target="_blank" rel="noopener noreferrer">MoMA · Automatism ↗</a><a href="https://www.moma.org/collection/works/38201" target="_blank" rel="noopener noreferrer">André Masson · Automatic Drawing ↗</a></div></section>
<section class="method-section" id="programa"><div class="method-title"><div><span class="eyebrow">PROGRAMA DE APROFUNDAMENTO</span><h2>33 aulas. Seis módulos.</h2></div><p>O programa regular já existente oferece a disciplina complementar: exercícios, erros recorrentes, verificação e aplicação. As 33 aulas são uma curadoria original do Harum Noir.</p></div><div class="method-modules">{regularModules.map((m)=><a href={base+'escola/programa-regular/#modulo-'+m.id}><span>{String(m.id).padStart(2,'0')}</span><strong>{m.title}</strong><small>{regularLessons.filter(l=>l.module===m.id).length} técnicas · {m.weeks}</small><i aria-hidden="true">↗</i></a>)}</div></section>
<section class="method-exit"><span class="eyebrow">DO ATELIÊ PARA A GALERIA</span><h2>Uma obra não termina quando o desenho acaba.</h2><p>Registre três vestígios: a referência identificada, um erro útil e a escolha que só você poderia ter feito. Na Galeria Viva, passe de um desenho histórico a uma pergunta para o seu próprio papel.</p><div class="method-hero-actions"><a class="btn gold" href={base+'galeria-viva/'}>Percorrer a Galeria Viva →</a><a class="btn" href={base+'cadernos/'}>Registrar no Caderno →</a><a class="btn" href={base+'escola/programa-regular/'}>Abrir as 33 aulas →</a></div></section>
</main><Footer/></body></html>
<style>
.noir-method main{width:min(1500px,100%);padding:0 clamp(18px,5vw,72px) 90px}.method-crumb{display:flex;align-items:center;gap:10px;padding:22px 0;color:var(--muted);font-size:.76rem}.method-crumb a{color:var(--paper-2)}.method-hero{display:grid;grid-template-columns:1.04fr .96fr;gap:clamp(25px,4vw,70px);align-items:center;padding:42px 0 75px;border-bottom:1px solid var(--line)}.method-hero h1{font-size:clamp(3.7rem,7vw,7.2rem);line-height:.95;letter-spacing:-.05em;margin:20px 0}.method-hero h1 em{color:var(--gold);font-weight:400}.method-hero-copy>p{max-width:63ch;color:var(--paper-2);font-size:1.04rem;line-height:1.8}.method-hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin:25px 0}.method-small{font-size:.72rem!important;color:var(--muted)!important}.method-hero figure{margin:0;border:1px solid var(--line);background:#141414}.method-hero img{width:100%;height:auto;aspect-ratio:4/5;object-fit:cover;filter:saturate(.56)}.method-hero figcaption{padding:10px;color:var(--muted);font-size:.67rem}.method-manifesto{max-width:1000px;margin:0 auto;padding:85px 0;text-align:center}.method-manifesto h2,.method-section h2,.method-exit h2{font-size:clamp(2.8rem,5vw,5.2rem);letter-spacing:-.04em;line-height:1;margin:12px 0 25px}.method-duo{display:grid;grid-template-columns:1fr 1fr;gap:15px;text-align:left}.method-duo article{padding:25px;border:1px solid var(--line);background:#121212;border-radius:8px}.method-duo b{font:400 2rem Georgia,serif;color:var(--gold)}.method-duo p,.method-rule{color:var(--paper-2);line-height:1.7}.method-rule{margin-top:25px}.method-section{padding:50px 0 90px;scroll-margin-top:90px}.method-title{display:flex;justify-content:space-between;align-items:end;gap:35px}.method-title>p{max-width:38ch;color:var(--paper-2);line-height:1.7}.method-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.method-card{background:#111;border:1px solid var(--line);border-radius:8px;overflow:hidden;scroll-margin-top:90px}.method-card>img{display:block;width:100%;aspect-ratio:16/8;object-fit:cover;filter:saturate(.5)}.method-card-content{padding:clamp(20px,2.7vw,35px)}.method-number{color:var(--gold);text-transform:uppercase;font-size:.68rem;letter-spacing:.12em}.method-card h3{font-size:clamp(2.4rem,4vw,4rem);line-height:1;margin:12px 0}.method-card blockquote{margin:0 0 15px;color:var(--paper);font:italic 1.3rem Georgia,serif}.method-card p{color:var(--paper-2);line-height:1.7}.method-verification{border-left:2px solid var(--gold);padding:3px 0 3px 15px;margin-top:22px}.method-verification b{color:var(--gold);font-size:.75rem}.method-verification p{margin:5px 0;font-size:.84rem}.method-card-foot{display:flex;justify-content:space-between;gap:12px;align-items:center;border-top:1px solid var(--line);padding-top:18px;margin-top:25px;font-size:.77rem}.method-card-foot span{color:var(--muted)}.method-card-foot a,.method-sources a{color:var(--gold)}.method-labs{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:1fr 1fr;gap:10px}.method-labs li{display:flex;gap:17px;align-items:start;background:#111;border:1px solid var(--line);border-radius:8px;padding:22px}.method-labs li>span{color:var(--gold);font-size:.76rem}.method-labs h3{font-size:1.65rem;margin:0 0 7px}.method-labs p{color:var(--paper-2);margin:0;line-height:1.6}.method-labs small{margin-left:auto;color:var(--gold);white-space:nowrap}.method-sources{margin-top:25px;padding:24px;border:1px solid var(--line);color:var(--paper-2)}.method-sources a{display:inline-block;margin-right:20px;margin-top:10px}.method-modules{display:grid;grid-template-columns:1fr 1fr;gap:10px}.method-modules a{display:grid;grid-template-columns:auto 1fr auto;gap:10px;align-items:baseline;padding:23px;border:1px solid var(--line);text-decoration:none;background:#111}.method-modules a:hover{border-color:var(--gold)}.method-modules a>span{color:var(--gold)}.method-modules a strong{font:400 1.5rem Georgia,serif}.method-modules small{grid-column:2;color:var(--muted)}.method-modules i{grid-column:3;grid-row:1;color:var(--gold);font-style:normal}.method-exit{padding:50px 0 20px;max-width:990px}.method-exit>p{max-width:65ch;color:var(--paper-2);line-height:1.7}
@media(max-width:820px){.method-hero{grid-template-columns:1fr}.method-hero figure{max-height:360px;overflow:hidden}.method-hero img{aspect-ratio:16/9}.method-title{display:block}.method-grid,.method-labs,.method-modules{grid-template-columns:1fr}}@media(max-width:560px){.method-hero{padding-top:18px}.method-hero h1{font-size:3.3rem}.method-duo{grid-template-columns:1fr}.method-labs li{flex-wrap:wrap}.method-hero-actions .btn{flex:1 1 100%;justify-content:center}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
