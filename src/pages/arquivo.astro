---
import EcosystemRail from '../components/EcosystemRail.astro';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { STUDIO_SITE } from '../consts';
const base=import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const itens=[
["Escola Aberta de Desenho","Plano de estudo gratuito em quatro movimentos, com primeira prática e progresso local.",base+"escola/","harum-noir-escola-hero"],
["Atlas Harum Noir","Mapa visual das rotas de estudo, referências, fontes e prática.",base+"atlas/","tools-paper"],
["Museus Abertos","Acervos institucionais, buscas e fontes com origem verificável.",base+"museus/","museum-gallery"],
["Outliers","Referências que deslocam o olhar por matéria, processo e imaginação.",base+"outliers/","graphite-texture"],
["Roubar como artista","Método para transformar referência em repertório sem copiar assinatura.",base+"roubar-como-artista/","charcoal-marks"],
["Atlas de Referências","Artistas, ateliês e professores organizados por decisões visuais.",base+"referencias/","drapery-still-life"],
["Biblioteca Aberta","Fontes públicas e institucionais organizadas por sketchbook, anatomia, ateliê, mãos e cabeça.",base+"biblioteca/","open-sketchbook"],
["Cadernos de Presença","Série editorial em torno de gesto, olhar, memória e vestígio.",base+"cadernos/","open-sketchbook"],
["Ateliê Aberto","Fundamentos e exercícios organizados para prática.",base+"atelier/","atelier-desk"],
["Temporadas","Sete percursos de aprofundamento.",base+"temporadas/","moonlit-landscape"],
["Carta do Ateliê","Edições públicas e gratuitas.",base+"carta/","iris-study"],
["Modelo Vivo e Gesto · texto aberto","Documento público da primeira temporada.",base+"vault/E01_MODELO_VIVO_GESTO.md","drapery-still-life"],
["RSS da Carta","Feed aberto para acompanhar novas edições.",base+"rss.xml","graphite-texture"],
["Site principal Studio 23","Atendimento, portfólio documental e canais oficiais do estúdio.",STUDIO_SITE,"atelier-desk"],
];
---
<!doctype html><html lang="pt-BR"><head><BaseHead title="Arquivo · HARUM NOIR" description="Portas visuais para a escola aberta, os museus, os cadernos, as cartas e os materiais públicos do HARUM NOIR."/></head><body><Header/><main>
<section class="page-hero"><div class="eyebrow">ARQUIVO ABERTO</div><h1>O que pode circular, circula.</h1><p>O arquivo público reúne materiais prontos para estudo e consulta. Cada cartão mostra o destino e uma capa temática.</p></section>
<section class="section"><div class="archive-grid">{itens.map(i=><a class="archive-item" href={i[2]}><img class="archive-cover" src={base+'noir/visual-atlas/'+i[3]+'.webp'} alt="" width="640" height="360" loading="lazy"/><span class="card-kicker">ABERTO</span><h3>{i[0]}</h3><p>{i[1]}</p><span class="archive-open">Abrir página <b aria-hidden="true">↗</b></span></a>)}</div></section>
<EcosystemRail current="arquivo" limit={5}/>
</main><Footer/></body></html>
<style>
.archive-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.archive-item{display:flex;flex-direction:column;overflow:hidden;text-decoration:none;color:inherit;border:1px solid var(--line);border-radius:10px;background:#101011;transition:border-color .2s,transform .2s}.archive-item:hover{border-color:var(--gold-dim);transform:translateY(-2px)}.archive-cover{width:100%;aspect-ratio:16/9;object-fit:cover;filter:saturate(.56)}.archive-item>.card-kicker,.archive-item h3,.archive-item p,.archive-open{margin-left:17px;margin-right:17px}.archive-item>.card-kicker{margin-top:16px;color:var(--gold);font-size:.65rem;letter-spacing:.14em}.archive-item h3{font-size:1.25rem;margin-top:8px;margin-bottom:6px}.archive-item p{color:var(--paper-2);font-size:.82rem;line-height:1.55;flex:1}.archive-open{display:flex;justify-content:space-between;border-top:1px solid var(--line);padding:12px 0;margin-top:10px;margin-bottom:14px;color:var(--gold);font-size:.73rem}
@media(max-width:900px){.archive-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.archive-grid{grid-template-columns:1fr}.archive-item h3{font-size:1.4rem}}
</style>