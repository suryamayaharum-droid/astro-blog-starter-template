---
import EcosystemRail from '../components/EcosystemRail.astro';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const base=import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const dias=[
  {n:'01',title:'Encontrar a matéria',text:'Conhecer pressão, lateral, ponta, pó e borracha antes de tentar controlar o carvão.'},
  {n:'02',title:'Capturar o gesto',text:'Observar direção, apoio e ritmo para fazer o corpo acontecer antes do contorno.'},
  {n:'03',title:'Construir massas',text:'Trocar detalhes por relações grandes entre figura, vazio, luz e sombra.'},
  {n:'04',title:'Organizar valores',text:'Separar claros, meios-tons e escuros para a imagem permanecer legível à distância.'},
  {n:'05',title:'Perder e recuperar bordas',text:'Usar apagamento e contraste para decidir onde o olhar entra e onde o desenho respira.'},
  {n:'06',title:'Escolher a composição',text:'Testar enquadramento, escala e espaço negativo antes de investir na versão final.'},
  {n:'07',title:'Fechar sem preencher',text:'Reunir gesto, massa, borda e silêncio em um estudo autoral e registrar o próximo passo.'},
];
---
<!doctype html>
<html lang="pt-BR">
<head><BaseHead title="Ritual do Carvão · 7 dias · Harum Noir" description="Conheça o percurso de sete dias do HARUM NOIR para praticar gesto, matéria, massa, borda e composição com carvão."/></head>
<body>
<Header/>
<main class="ritual-page">
  <section class="page-hero ritual-hero">
    <div>
      <div class="eyebrow">PERCURSO EM PREPARAÇÃO · HARUM NOIR</div>
      <h1>Ritual do Carvão</h1>
      <p>Sete dias para sair do medo da folha, compreender a matéria e terminar um estudo com intenção — sem transformar o desenho numa corrida por acabamento.</p>
      <div class="actions">
        <a class="btn gold" href="#sequencia">Conhecer os sete dias ↓</a>
        <a class="btn" href={base+'atelier#exercicio'}>Experimentar uma prática gratuita →</a>
      </div>
    </div>
    <aside class="ritual-status" aria-label="Status do percurso">
      <span>PRÉ-LANÇAMENTO</span>
      <strong>A compra ainda não está aberta.</strong>
      <p>Exercícios, imagens, formato de entrega e checkout estão em revisão antes da primeira venda.</p>
    </aside>
  </section>

  <section class="section ritual-outcome">
    <div class="section-head"><div><span class="eyebrow">O QUE MUDA EM SETE DIAS</span><h2>Uma sequência para enxergar melhor antes de desenhar mais.</h2></div><p>O percurso organiza decisões que hoje aparecem espalhadas pelo Ateliê e pelos Cadernos.</p></div>
    <div class="ritual-grid ritual-grid-3">
      <article class="panel"><span class="card-kicker">COMEÇO</span><h3>Menos hesitação</h3><p>Você começa com limites simples de tempo e material para não esperar a “ideia perfeita”.</p></article>
      <article class="panel"><span class="card-kicker">PROCESSO</span><h3>Mais leitura</h3><p>Gesto, massa, valor e borda deixam de competir e passam a entrar numa ordem observável.</p></article>
      <article class="panel"><span class="card-kicker">SAÍDA</span><h3>Um estudo autoral</h3><p>O sétimo dia reúne as escolhas numa composição e deixa um registro claro do que continuar estudando.</p></article>
    </div>
  </section>

  <section class="section" id="sequencia">
    <div class="section-head"><div><span class="eyebrow">A SEQUÊNCIA</span><h2>Sete encontros com a mesma matéria.</h2></div><p>Cada dia acrescenta uma decisão. O percurso evita pular direto para o detalhe.</p></div>
    <div class="ritual-days">
      {dias.map(dia=><article><span>{dia.n}</span><div><h3>{dia.title}</h3><p>{dia.text}</p></div></article>)}
    </div>
  </section>

  <section class="section editorial-split">
    <article class="panel">
      <div class="eyebrow">PARA QUEM É</div>
      <h2>Para começar ou voltar ao desenho.</h2>
      <ul class="ritual-list">
        <li>Quem se sente travado diante da folha ou abandona estudos cedo.</li>
        <li>Quem desenha por cópia, mas quer compreender as próprias decisões.</li>
        <li>Quem deseja experimentar carvão com uma sequência curta e possível.</li>
        <li>Quem busca uma ponte entre observação, repertório e linguagem autoral.</li>
      </ul>
    </article>
    <article class="panel">
      <div class="eyebrow">FORMATO PREVISTO</div>
      <h2>Um caderno para usar, não apenas ler.</h2>
      <p>A edição está sendo organizada como material digital de sete dias, com instruções, campos de registro, critérios de autoavaliação e uma prática final.</p>
      <p>Quantidade de páginas, materiais complementares, preço e condições de acesso serão confirmados antes da abertura.</p>
    </article>
  </section>

  <section class="section">
    <div class="journal"><div class="paper ritual-check">
      <div class="eyebrow">PORTÃO DE ABERTURA</div>
      <h2>O pagamento só entra quando a entrega estiver pronta.</h2>
      <div class="ritual-readiness">
        <div><span>01</span><p><b>Sequência</b>Sete dias revisados e compreensíveis sem acompanhamento obrigatório.</p></div>
        <div><span>02</span><p><b>Imagens</b>Direitos e créditos conferidos para cada uso no material.</p></div>
        <div><span>03</span><p><b>Entrega</b>Arquivo final testado em celular e computador.</p></div>
        <div><span>04</span><p><b>Compra</b>Preço, checkout e acesso testados de ponta a ponta.</p></div>
      </div>
      <p class="ritual-note">Hoje, a página apresenta o percurso e oferece caminhos gratuitos. Ela não coleta dados nem encaminha para um pagamento inexistente.</p>
    </div></div>
  </section>

  <section class="section ritual-faq">
    <div class="section-head"><div><span class="eyebrow">ANTES DE COMEÇAR</span><h2>Perguntas frequentes</h2></div></div>
    <details><summary>Preciso saber desenhar?</summary><p>Não. O percurso parte de relações simples de gesto, massa e contraste. Experiência anterior pode ajudar, mas não é requisito.</p></details>
    <details><summary>Preciso comprar muitos materiais?</summary><p>A lista final será publicada antes da abertura. A proposta é trabalhar com poucos materiais de carvão e papel, sem montar um ateliê caro.</p></details>
    <details><summary>Já posso comprar?</summary><p>Ainda não. O botão de pagamento só aparecerá depois que conteúdo, direitos de imagem, entrega e checkout forem confirmados.</p></details>
    <details><summary>Posso começar gratuitamente?</summary><p>Sim. O Ateliê e os Cadernos já oferecem exercícios abertos que usam os mesmos princípios de observação.</p></details>
  </section>

  <section class="section">
    <div class="panel ritual-final">
      <div><div class="eyebrow">PRIMEIRO GESTO</div><h2>Experimente antes de decidir comprar.</h2><p>Faça uma prática aberta, observe como o método organiza o desenho e depois percorra os Cadernos.</p></div>
      <div class="actions"><a class="btn gold" href={base+'atelier#exercicio'}>Fazer a prática gratuita →</a><a class="btn" href={base+'cadernos'}>Abrir os Cadernos →</a></div>
    </div>
  </section>
  <EcosystemRail current="atelier" limit={5} />
</main>
<Footer/>
<style>
.ritual-page{--ritual-gold:#c0a36a}
.ritual-hero{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(280px,.65fr);gap:clamp(28px,6vw,86px);align-items:end;min-height:min(720px,78vh)}
.ritual-hero>div>p{max-width:720px}.ritual-status{padding:24px;border:1px solid rgba(192,163,106,.38);background:rgba(8,8,8,.72);backdrop-filter:blur(12px)}
.ritual-status span{display:block;color:var(--ritual-gold);font-size:.64rem;font-weight:800;letter-spacing:.16em}.ritual-status strong{display:block;margin:12px 0 8px;font:500 1.65rem/1.05 "Cormorant Garamond",Georgia,serif}.ritual-status p{margin:0;color:var(--paper-2);font-size:.86rem}
.ritual-grid{display:grid;gap:12px}.ritual-grid-3{grid-template-columns:repeat(3,minmax(0,1fr))}.ritual-grid .panel{min-height:210px}.ritual-grid h3{font-size:1.7rem;margin:16px 0 8px}
.ritual-days{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.ritual-days article{display:grid;grid-template-columns:52px 1fr;gap:16px;min-height:150px;padding:22px;border:1px solid var(--line);background:rgba(12,12,13,.76)}.ritual-days article:last-child{grid-column:1/-1}.ritual-days>article>span{color:var(--ritual-gold);font:500 1.35rem/1 "Cormorant Garamond",Georgia,serif}.ritual-days h3{margin:0 0 7px;font-size:1.42rem}.ritual-days p{margin:0;color:var(--paper-2)}
.ritual-list{display:grid;gap:12px;padding-left:1.2rem}.ritual-list li{padding-left:5px;color:var(--paper-2)}
.ritual-readiness{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin:26px 0}.ritual-readiness>div{display:grid;grid-template-columns:38px 1fr;gap:12px;padding:15px;border-top:1px solid rgba(138,115,75,.34)}.ritual-readiness span{color:#8a734b;font:500 1.15rem/1 Georgia,serif}.ritual-readiness p{margin:0}.ritual-readiness b{display:block;margin-bottom:4px}.ritual-note{padding-top:18px;border-top:1px solid rgba(138,115,75,.25)}
.ritual-faq{max-width:980px}.ritual-faq details{border-top:1px solid var(--line);padding:18px 2px}.ritual-faq details:last-child{border-bottom:1px solid var(--line)}.ritual-faq summary{cursor:pointer;font:500 1.25rem/1.2 "Cormorant Garamond",Georgia,serif}.ritual-faq details p{max-width:70ch;color:var(--paper-2)}
.ritual-final{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:30px;align-items:center}.ritual-final h2{margin-bottom:8px}.ritual-final p{max-width:62ch}
@media(max-width:820px){.ritual-hero,.ritual-final{grid-template-columns:1fr}.ritual-hero{min-height:0}.ritual-grid-3,.ritual-days,.ritual-readiness{grid-template-columns:1fr}.ritual-days article:last-child{grid-column:auto}.ritual-final .actions{justify-content:flex-start}}
@media(max-width:520px){.ritual-days article{grid-template-columns:36px 1fr;padding:18px 15px}.ritual-status{padding:20px}.ritual-final .actions{display:grid}.ritual-final .btn{text-align:center}}
</style>
</body>
</html>
