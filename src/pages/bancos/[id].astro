---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { imageBanks, studyFans, themedStudyLenses } from '../../data/imageBanks';
import { artworkForLens, institutionalBankCovers, visualStudyCollection } from '../../data/visualStudyCollection';
import '../../styles/imageBanks.css';
export function getStaticPaths(){
  const institutional=imageBanks.map(bank=>({params:{id:bank.id},props:{bank,themedGuide:null}}));
  const themed=studyFans.map(fan=>{
    const sources=fan.bankIds.map(id=>imageBanks.find(bank=>bank.id===id)).filter(Boolean);
    const source=sources[0]||imageBanks[0];
    const bank={
      ...source,
      id:fan.id,
      name:fan.title,
      place:'Leque temático · HARUM NOIR',
      kind:'archive',
      access:'Guia visual com caminhos para fontes institucionais',
      rights:'As obras e os direitos permanecem nas instituições de origem; confira a licença de cada ficha.',
      strengths:[fan.title],
      periods:[],
      lenses:themedStudyLenses[fan.id],
      caution:'As pranchas HARUM NOIR são estudos editoriais originais. Não representam documentos ou obras de acervo.'
    };
    return {params:{id:fan.id},props:{bank,themedGuide:fan}};
  });
  return [...institutional,...themed];
}
const {bank,themedGuide=null}=Astro.props;
const base=import.meta.env.BASE_URL.endsWith('/')?import.meta.env.BASE_URL:import.meta.env.BASE_URL+'/';
const bankCover=themedGuide
  ? {file:'noir/visual-atlas/'+themedGuide.image,alt:themedGuide.alt,caption:'Composição temática HARUM NOIR; não é registro do acervo.'}
  : institutionalBankCovers[bank.id]||visualStudyCollection[0];
const usedLensArtwork=new Set<string>();
const lensCards=bank.lenses.map((lens,index)=>({lens,artwork:artworkForLens(lens.label,bank.id,index,usedLensArtwork)}));
const liveBase=bank.liveFederated?base+'museus?q=':null;
const bankSearchUrl=bank.id==='bndigital'?'https://acervobndigital.bn.gov.br/sophia/index.asp':bank.collectionUrl;
const sourceType=bank.kind==='museum'?'Museum':bank.kind==='archive'?'ArchiveOrganization':'Organization';
const bankSchema={
  '@context':'https://schema.org',
  '@type':'LearningResource',
  name:bank.name+' · guia de pesquisa visual',
  description:'Guia de estudo, direitos e caminhos de pesquisa para '+bank.name+'.',
  inLanguage:'pt-BR',
  educationalUse:'Research',
  learningResourceType:'Institutional collection research guide',
  url:new URL(base+'bancos/'+bank.id+'/',Astro.site).href,
  keywords:bank.strengths,
  about:{
    '@type':sourceType,
    name:bank.name,
    url:bank.collectionUrl,
    location:bank.place,
    sameAs:[bank.collectionUrl,bank.rightsUrl,bank.docsUrl].filter(Boolean)
  },
  hasPart:bank.lenses.map((lens,index)=>({
    '@type':'CreativeWork',
    position:index+1,
    name:lens.label,
    description:lens.note,
    keywords:lens.query
  }))
};
---
<!doctype html><html lang="pt-BR"><head><BaseHead title={bank.name+' · Bancos de Imagens · Harum Noir'} description={'Leques de estudo, direitos e portas para '+bank.name+'.'} /><script type="application/ld+json" set:html={JSON.stringify(bankSchema)} /></head>
<body class="has-page-wallpaper" style={`--page-wallpaper: url('${base+bankCover.file}')`}><Header/><main>
<section class="section bank-top">
  <div class="bank-title"><div class="meta">{bank.kind} · {bank.place}</div><h1>{bank.name}</h1><p>{bank.rights}</p><div class="bank-strengths">{bank.strengths.map(x=><span>{x}</span>)}</div></div>
  <div class="bank-door" style={`--bank-door-cover: url('${base+bankCover.file}')`}><div class="door-mark">↗</div><div class="eyebrow">PORTA ORIGINAL</div><h2>Abra o acervo na fonte.</h2><p>{themedGuide?'Este leque reúne diferentes instituições; escolha uma abaixo para abrir o acervo e conferir os direitos.':`${bank.access}. O HARUM NOIR não espelha esta biblioteca; ele organiza caminhos de estudo para ela.`}</p><div class="actions">{themedGuide?<a class="btn gold" href="#fontes-do-tema">Ver acervos deste tema ↓</a>:<a class="btn gold" href={bankSearchUrl} target="_blank" rel="noreferrer">{bank.id==='bndigital'?'Abrir catálogo Sophia ↗':'Abrir coleção ↗'}</a>}{!themedGuide&&bank.id==='bndigital'&&<a class="btn" href={bank.collectionUrl} target="_blank" rel="noreferrer">Ver Acervo Digital ↗</a>}{!themedGuide&&<a class="btn" href={bank.rightsUrl} target="_blank" rel="noreferrer">Direitos / Open Access ↗</a>}</div><small class="bank-visual-credit">{bankCover.caption}</small></div>
</section>
{themedGuide&&<section class="section theme-guide" id="fontes-do-tema">
  <div class="theme-guide-visual"><img src={base+'noir/visual-atlas/'+themedGuide.image} alt={themedGuide.alt} loading="lazy" decoding="async"/><small>Estudo editorial original · não é imagem de acervo</small></div>
  <div class="theme-guide-copy"><div class="eyebrow">GUIA VISUAL · {themedGuide.title}</div><h2>Observe este problema antes de abrir as fontes.</h2><p>{themedGuide.thought}</p><h3>Experimento visual</h3><p>{themedGuide.practice}</p><div class="actions">{themedGuide.bankIds.map(id=>imageBanks.find(source=>source.id===id)).filter(Boolean).map(source=><a class="btn" href={base+'bancos/'+source!.id+'/'}>{source!.name}</a>)}</div></div>
</section>}
{bank.id==='bndigital'&&<section class="section">
  <div class="section-head"><div><div class="eyebrow">ATALHOS OFICIAIS</div><h2>Quatro portas que realmente levam ao acervo.</h2></div><p>Use estes caminhos diretos da Fundação Biblioteca Nacional para pesquisar, entender o sistema e confirmar as condições de reutilização.</p></div>
  <div class="bank-protocol bank-official-grid">
    <a class="protocol-step bank-official-link" href="https://bndigital.bn.gov.br/acervodigital/" target="_blank" rel="noreferrer"><b>01 · Acervo Digital</b><p>Entrada oficial para explorar documentos digitalizados da BNDigital.</p><span>Abrir acervo ↗</span></a>
    <a class="protocol-step bank-official-link" href="https://acervobndigital.bn.gov.br/sophia/index.asp" target="_blank" rel="noreferrer"><b>02 · Catálogo Sophia</b><p>Busca rápida e combinada diretamente no catálogo da Biblioteca Nacional Digital.</p><span>Abrir catálogo ↗</span></a>
    <a class="protocol-step bank-official-link" href="https://bndigital.bn.gov.br/perguntas-e-respostas/?taxonomia=faq_categorias&tv=pesquisa-no-acervo-digitalizado" target="_blank" rel="noreferrer"><b>03 · Como pesquisar</b><p>Orientação oficial para busca rápida, busca avançada e combinação de campos.</p><span>Ler instruções ↗</span></a>
    <a class="protocol-step bank-official-link" href="https://bndigital.bn.gov.br/orientacoes-de-uso-de-arquivos-digitais/" target="_blank" rel="noreferrer"><b>04 · Direitos de uso</b><p>Regras da Fundação Biblioteca Nacional para reutilização, atribuição e obras protegidas.</p><span>Conferir direitos ↗</span></a>
  </div>
</section>}
<section class="section"><div class="fan-head"><div><div class="eyebrow">LEQUES DE ESTUDO</div><h2>Entre por uma pergunta.</h2></div><p>{bank.id==='bndigital'?'Copie um termo e abra o catálogo Sophia. Cole em Busca rápida; use Busca combinada para restringir por título, autoria ou assunto.':'Copie um termo para levar à busca do acervo original. Nas integrações vivas, o botão já abre a busca com o tema preenchido.'} As capas são estudos editoriais, não resultados dos acervos.</p></div>
<div class="bank-fan browse-rail" role="region" aria-roledescription="carrossel" tabindex="0" aria-label={'Leques de pesquisa para '+bank.name}>{lensCards.map(({lens,artwork},i)=><article class="fan-card"><figure class="fan-card-art"><img src={base+artwork.file} alt="" loading="lazy" decoding="async"/><figcaption>Estudo editorial · não é imagem de acervo</figcaption></figure><div class="n">{String(i+1).padStart(2,'0')}</div><div class="eyebrow">LEQUE</div><h3>{lens.label}</h3><p>{lens.note}</p><span class="fan-query">{lens.query}</span>{liveBase?<a href={liveBase+encodeURIComponent(lens.query)}>pesquisar nos museus conectados →</a>:<div class="fan-actions"><a href={bankSearchUrl} target="_blank" rel="noreferrer">{bank.id==='bndigital'?'abrir catálogo Sophia ↗':'abrir acervo oficial ↗'}</a><button type="button" data-copy-query={lens.query}>copiar termo</button></div>}<span class="fan-copy-status" data-copy-status role="status" aria-live="polite"></span></article>)}</div></section>
{!themedGuide&&<section class="section"><div class="section-head"><div><div class="eyebrow">PERÍODOS FORTES</div><h2>Onde este banco ajuda mais.</h2></div></div><div class="bank-strengths">{bank.periods.map(x=><span>{x}</span>)}</div><div class="bank-caution"><b>Cuidado de proveniência:</b> {bank.caution}</div></section>}
<section class="section"><div class="section-head"><div><div class="eyebrow">MÉTODO</div><h2>Quatro movimentos.</h2></div></div><div class="bank-protocol"><div class="protocol-step"><b>01 · Abrir</b><p>Entre pelo acervo institucional, não por uma cópia perdida na web.</p></div><div class="protocol-step"><b>02 · Ler</b><p>Veja autoria, data, técnica, coleção e aviso de direitos.</p></div><div class="protocol-step"><b>03 · Observar</b><p>Escolha uma decisão visual: peso, linha, luz, recorte, padrão ou espaço.</p></div><div class="protocol-step"><b>04 · Refazer</b><p>Feche a referência e reconstrua a ideia com outra solução e outra mão.</p></div></div></section>
<section class="section"><div class="journal"><div class="paper"><div class="eyebrow" style="color:#8a734b">CONEXÃO HARUM NOIR</div><h2>Use esta porta junto com o Atlas.</h2><p class="lead">A história aponta o problema. O banco oferece material. O desenho transforma a pesquisa.</p><p><a href={base+'historia-da-arte'}>Voltar para História da Arte →</a></p></div></div></section>
</main><Footer/><style>
.bank-door{position:relative;isolation:isolate;overflow:hidden;background:linear-gradient(180deg,rgba(8,8,8,.2),rgba(8,8,8,.62) 46%,rgba(8,8,8,.96)),var(--bank-door-cover),linear-gradient(145deg,#171719,#0c0c0d);background-size:cover;background-position:center}.bank-visual-credit{display:block;margin-top:16px;padding-top:10px;border-top:1px solid rgba(238,231,220,.14);color:#b6ac9c;font-size:.64rem;line-height:1.45}
.bank-fan.browse-rail{grid-auto-flow:column;grid-auto-columns:minmax(280px,330px);grid-template-columns:none;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;padding:8px 2px 16px}.bank-fan.browse-rail::-webkit-scrollbar{display:none}.bank-fan.browse-rail .fan-card,.bank-fan.browse-rail .fan-card:nth-child(n){min-height:0;transform:none;scroll-snap-align:start}.fan-card-art{position:relative;display:block;width:100%;aspect-ratio:16/10;overflow:hidden;border:1px solid rgba(238,231,220,.15);border-radius:11px;background:#201d18;margin:0 0 13px}.fan-card-art img{width:100%;height:100%;object-fit:cover;filter:saturate(.52) contrast(1.04)}.fan-card-art figcaption{position:absolute;inset:auto 0 0;padding:22px 9px 7px;background:linear-gradient(transparent,rgba(8,8,8,.92));color:#d8cfc1;font-size:9px;line-height:1.3}
@media(max-width:760px){.bank-fan.browse-rail{grid-auto-columns:minmax(78vw,320px)}}
</style>
<script>
  document.addEventListener('click', async (event) => {
    const target = event.target;
    const button = target instanceof Element ? target.closest('[data-copy-query]') : null;
    if (!button) return;
    const query = button.getAttribute('data-copy-query') || '';
    const status = button.closest('.fan-card')?.querySelector('[data-copy-status]');
    if (!query || !status) return;

    let copied = false;
    try {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(query);
        copied = true;
      }
    } catch {}

    if (!copied) {
      const field = document.createElement('textarea');
      field.value = query;
      field.setAttribute('aria-hidden', 'true');
      field.style.position = 'fixed';
      field.style.opacity = '0';
      document.body.append(field);
      field.select();
      try { copied = document.execCommand('copy'); } catch {}
      field.remove();
    }

    status.textContent = copied
      ? `Termo “${query}” copiado. Cole na busca do acervo.`
      : `Copie este termo para pesquisar: ${query}`;
  });
</script>
</body></html>
