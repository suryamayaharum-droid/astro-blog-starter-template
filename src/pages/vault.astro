---
import LegacyRedirect from '../components/LegacyRedirect.astro';
const base=import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const target=`${base}arquivo/`;
---
<LegacyRedirect target={target} title="Arquivo editorial" summary="Consulte materiais publicados, percursos e estudos que podem circular neste acervo." cta="Abrir o Arquivo" />
