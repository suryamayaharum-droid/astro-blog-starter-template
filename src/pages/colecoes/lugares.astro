---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
const base=import.meta.env.BASE_URL.endsWith('/')?import.meta.env.BASE_URL:import.meta.env.BASE_URL+'/';
const places=[
  {n:'01',name:'Ateliê e janela',image:'atelier-desk',alt:'Mesa de ateliê com caderno, ferramentas e luz lateral, em imagem editorial.',question:'De onde vem a luz? Marque a direção da sombra e três valores grandes.',practice:'Faça três miniaturas de dois minutos: mesma mesa, três enquadramentos. Compare o espaço vazio e escolha um para desenvolver.',bank:'met',bankLabel:'Abrir guia de pesquisa do The Met',source:'https://www.metmuseum.org/art/collection'},
  {n:'02',name:'Sala de museu',image:'museum-gallery',alt:'Galeria de museu em imagem editorial para estudo de escala e espaço.',question:'Como a distância entre obra, parede e visitante organiza a cena?',practice:'Desenhe primeiro o retângulo da sala. Depois, coloque apenas três massas: obra, arquitetura e pessoa. Termine com uma linha de perspectiva.',bank:'cma',bankLabel:'Abrir guia de pesquisa do Cleveland Museum of Art',source:'https://www.clevelandart.org/art/collection'},
  {n:'03',name:'Jardim botânico',image:'collections/botanica-iris',alt:'Estudo editorial de íris botânica em grafite e carvão.',question:'Que eixo sustenta a planta? Onde as folhas se sobrepõem?',practice:'Escolha uma planta real. Trace o eixo, conte os grupos de folhas e reserve os detalhes para o fim. Não copie cada folha: compare direção e intervalo.',bank:'cma',bankLabel:'Abrir guia de pesquisa de coleção botânica',source:'https://www.clevelandart.org/art/collection'},
  {n:'04',name:'Arquivo brasileiro',image:'collections/arquivo-bahia',alt:'Composição editorial inspirada em arquivos visuais brasileiros; não é documento histórico.',question:'Que pistas visuais indicam lugar, época ou uso sem transformar hipótese em fato?',practice:'Abra um item do acervo, leia autor, data, material e direitos. Faça um estudo de formas e anote o que é observação e o que ainda é hipótese.',bank:'bndigital',bankLabel:'Abrir guia da Biblioteca Nacional Digital',source:'https://bndigital.bn.gov.br/'}
];
---
<!doctype html>
<html lang="pt-BR">
<head><BaseHead title="Lugares para desenhar · HARUM NOIR" description="Quatro ambientes para treinar composição, luz, escala e leitura de fontes com imagens, exercícios curtos e acervos institucionais." alternates={[{hreflang:'pt-BR',href:base+'colecoes/lugares/'}]}/></head>
<body><Header/><main class="places">
<section class="hero"><div><span class="eyebrow">COLEÇÃO 08 · ESPAÇO · OBSERVAÇÃO</span><h1>Lugares para desenhar.</h1><p>Um lugar ensina por suas relações: luz e sombra, obra e parede, planta e vazio, documento e contexto. Use as imagens editoriais como mapas de observação; consulte as fontes originais antes de tratar qualquer registro como evidência.</p><a class="btn gold" href="#lugares">Escolher um lugar ↓</a></div><figure><img src={base+'noir/visual-atlas/museum-gallery.webp'} alt="Galeria editorial usada para estudar escala, arquitetura e espaço." width="1200" height="800" fetchpriority="high"/><figcaption>Imagem editorial de estudo. Não representa uma instituição ou obra específica.</figcaption></figure></section>
<section class="intro section" id="lugares"><div><span class="eyebrow">QUATRO PORTAS · UMA PRÁTICA</span><h2>Veja relações antes dos detalhes.</h2></div><p>As artes desta coleção são editoriais e servem para praticar o olhar. Para pesquisar obras e documentos, abra o acervo institucional, confira a ficha e leia as condições de uso de cada item.</p></section>
<div class="place-grid">{places.map((item)=><article class="place-card"><figure><img src={base+'noir/visual-atlas/'+item.image+'.webp'} alt={item.alt} width="900" height="650" loading="lazy" decoding="async"/><figcaption>Estudo editorial · não é registro do acervo</figcaption></figure><div class="copy"><span class="eyebrow">LUGAR {item.n}</span><h2>{item.name}</h2><h3>Pergunta de observação</h3><p>{item.question}</p><h3>Prática de 8 minutos</h3><p>{item.practice}</p><div class="links"><a href={base+'bancos/'+item.bank+'/'}>{item.bankLabel} →</a><a href={item.source} target="_blank" rel="noreferrer">Abrir acervo oficial ↗</a></div></div></article>)}</div>
<section class="section exercise"><div class="paper"><span class="eyebrow">RITUAL DE 8 MINUTOS</span><h2>Da visita ao caderno.</h2><ol><li><b>2 min · enquadrar.</b> Escolha um recorte e desenhe apenas os limites grandes.</li><li><b>3 min · relacionar.</b> Marque três massas e um espaço vazio que ajude a leitura.</li><li><b>3 min · registrar.</b> Anote uma observação confirmada pela fonte e uma pergunta para investigar.</li></ol><p class="note">As imagens deste site são estudos editoriais, não reproduções das coleções institucionais. Direitos e condições de reutilização devem ser conferidos na ficha de cada acervo.</p><a href={base+'colecoes/'}>Voltar às Coleções Visuais →</a></div></section>
<section class="section next"><a href={base+'escola/'}>Continuar na Escola Aberta →</a><a href={base+'referencias/'}>Comparar referências →</a></section>
</main><Footer/></body></html>
<style>
.places{--ink:#101011;max-width:1380px;margin:auto}.hero{padding:clamp(28px,6vw,80px);display:grid;grid-template-columns:1fr 1fr;gap:clamp(24px,5vw,70px);align-items:center;border-bottom:1px solid var(--line)}.hero h1{font-size:clamp(3.3rem,8vw,7.5rem);line-height:.9;letter-spacing:-.055em;margin:18px 0}.hero p{max-width:54ch;color:var(--paper-2);line-height:1.75}.hero figure,.place-card figure{position:relative;margin:0;overflow:hidden;background:#111;border:1px solid var(--line)}.hero figure img{width:100%;display:block;aspect-ratio:4/3;object-fit:cover}.hero figcaption,.place-card figcaption{position:absolute;bottom:0;left:0;right:0;padding:22px 12px 9px;background:linear-gradient(transparent,#080808e8);color:#d0c8bd;font-size:.68rem}.eyebrow{color:var(--gold);font-size:.68rem;letter-spacing:.14em}.intro{display:grid;grid-template-columns:1fr 1fr;gap:36px;align-items:end}.intro h2,.paper h2{font-size:clamp(2.2rem,5vw,4rem);line-height:1;margin:14px 0}.intro p{color:var(--paper-2);line-height:1.75}.place-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;padding:0 clamp(18px,5vw,68px)}.place-card{overflow:hidden;border:1px solid var(--line);border-radius:14px;background:#111214}.place-card figure img{display:block;width:100%;aspect-ratio:16/10;object-fit:cover;filter:saturate(.65)}.copy{padding:clamp(20px,3vw,34px)}.copy h2{font-size:clamp(1.8rem,3vw,2.5rem);margin:12px 0 22px}.copy h3{font-size:.77rem;text-transform:uppercase;letter-spacing:.1em;color:var(--gold);margin:18px 0 5px}.copy p{color:var(--paper-2);line-height:1.65;font-size:.9rem}.links{display:flex;flex-wrap:wrap;gap:12px;margin-top:24px;padding-top:16px;border-top:1px solid var(--line)}.links a,.next a,.paper>a{color:var(--gold);font-size:.8rem;text-decoration:none}.exercise{max-width:900px;margin:auto}.paper{padding:clamp(24px,5vw,54px);background:#f1eadc;color:#191817;border-radius:4px}.paper .eyebrow{color:#876d40}.paper h2{font-weight:400}.paper ol{padding-left:1.3rem;line-height:1.8}.paper li{padding:.25rem 0}.note{margin:24px 0;color:#585147;font-size:.8rem;line-height:1.6}.next{display:flex;gap:20px;flex-wrap:wrap;justify-content:center;border-top:1px solid var(--line)}
@media(max-width:760px){.hero,.intro{grid-template-columns:1fr}.hero figure{order:-1}.place-grid{grid-template-columns:1fr;padding-inline:16px}.hero{padding-inline:20px}.intro{gap:12px}}
</style>