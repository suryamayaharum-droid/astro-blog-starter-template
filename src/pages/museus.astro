---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { museumCatalog } from '../data/museums';
import { radarByLane } from '../data/radarHarumverso';
import '../styles/museums.css';
const base=import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const liveCount=museumCatalog.filter(x=>x.mode==='live').length;
const radarAcervo=radarByLane('acervo').slice(0,6);
const museumCovers=['museum-gallery.webp','open-sketchbook.webp','drapery-still-life.webp','moonlit-landscape.webp','iris-study.webp','atelier-desk.webp','tools-paper.webp'];
const modeLabel={live:'conectado agora',advanced:'API avançada',dataset:'dataset aberto',key:'requer chave'};
const museumsSchema={
  '@context':'https://schema.org',
  '@type':'CollectionPage',
  name:'Museus Abertos · Harum Noir',
  description:'Catálogo de museus e fontes abertas para pesquisa visual, com retorno às instituições de origem.',
  inLanguage:'pt-BR',
  mainEntity:{
    '@type':'ItemList',
    numberOfItems:museumCatalog.length,
    itemListElement:museumCatalog.map((m,i)=>({
      '@type':'ListItem',
      position:i+1,
      url:new URL(base+'museus/#museum-'+m.id,Astro.site).href,
      item:{'@type':'Museum','name':m.name,'location':{'@type':'Place','name':m.city+' · '+m.country},'url':m.collectionUrl}
    }))
  }
};
---
<!doctype html>
<html lang="pt-BR">
<head><BaseHead title="Museus Abertos · Harum Noir" description="Catálogo de museus e busca integrada em APIs Open Access, Public Domain e CC0 para estudo visual no Harum Noir." alternates={[{hreflang:'en',href:base+'en/museums/'},{hreflang:'es',href:base+'es/museos/'}]} /><script type="application/ld+json" set:html={JSON.stringify(museumsSchema)} /></head>
<body>
<Header/>
<main>
  <section class="museum-hero" aria-labelledby="museum-title">
    <div class="museum-hero__copy">
      <p class="eyebrow">HARUM NOIR · CADERNO DE PESQUISA</p>
      <h1 id="museum-title">Museus<br /><em>abertos.</em></h1>
      <p>Estude obras direto das instituições. Busque por artista, tema ou material e abra a ficha oficial para conferir contexto e direitos.</p>
      <div class="museum-hero__actions">
        <a class="btn gold" href="#busca-viva">Pesquisar nas APIs →</a>
        <a class="btn" href="#catalogo">Percorrer o catálogo</a>
      </div>
    </div>
    <figure class="museum-hero__visual">
      <img src={base + 'noir/visual-atlas/museum-gallery.webp'} alt="" loading="eager" fetchpriority="high" decoding="async" />
      <figcaption>
        <span>IMAGEM EDITORIAL</span>
        Ilustração atmosférica; não é fotografia de museu nem representa um acervo específico.
      </figcaption>
    </figure>
  </section>

  <nav class="museum-highlights" aria-label="Acervos conectados em destaque">
    <p class="eyebrow">NÚCLEO VIVO · {liveCount} ACERVOS</p>
    <div class="museum-highlights__items">
      {museumCatalog.filter((m) => m.mode === 'live').map((m) => (
        <a class="museum-highlight" href={'#museum-' + m.id}>
          <small>API CONECTADA</small>
          <strong>{m.name}</strong>
          <span>{m.city} · {m.country} · Ver no catálogo →</span>
        </a>
      ))}
    </div>
  </nav>

  <section class="section" id="radar-acervo"><div class="section-head"><div><div class="eyebrow">RADAR · ACERVO ABERTO</div><h2>Obras novas para estudar.</h2></div><p>Entradas recentes com direitos claros e um problema de desenho definido.</p></div><div class="museum-highlights__items">{radarAcervo.map(item=><a class="museum-highlight" href={item.url} target="_blank" rel="noreferrer"><small>{item.rights}</small><strong>{item.creator} · {item.title}</strong><span>{item.principle} →</span></a>)}</div><div class="actions" style="margin-top:18px"><a class="btn gold" href={base+'radar'}>Abrir Radar completo →</a></div></section>
  <section class="section museum-study-loop" id="estudo-guiado">
    <div class="section-head"><div><div class="eyebrow">ESTUDO GUIADO · 20 MIN</div><h2>Do acervo para o papel.</h2></div><p>Uma busca só vira aprendizagem quando termina em uma decisão desenhada.</p></div>
    <div class="path-index">
      <div class="path-index-card"><span>01 · 3 MIN</span><strong>Escolha uma pergunta</strong><small>Gesto, estrutura, luz, borda ou composição. Uma por vez.</small></div>
      <div class="path-index-card"><span>02 · 5 MIN</span><strong>Leia a obra</strong><small>Abra a ficha institucional e localize autoria, técnica, contexto e direitos.</small></div>
      <div class="path-index-card"><span>03 · 10 MIN</span><strong>Faça uma tradução</strong><small>Sem copiar a obra inteira: teste o princípio em outro assunto, pose ou composição.</small></div>
      <div class="path-index-card"><span>04 · 2 MIN</span><strong>Registre a diferença</strong><small>Anote o que você percebeu antes e o que passou a perceber depois do estudo.</small></div>
    </div>
    <div class="actions" style="margin-top:18px"><a class="btn gold" href="#busca-viva">Escolher uma obra →</a><a class="btn" href={base+'cadernos'}>Registrar no Caderno →</a></div>
  </section>
  <section class="section museum-intro">
    <div class="panel">
      <div class="eyebrow">REDE ABERTA</div>
      <h2>Uma ficha é o começo do estudo.</h2>
      <p>Metadados, autoria, técnica, data e direitos ajudam a observar uma obra com contexto e a voltar sempre à instituição que a preserva.</p>
      <div class="actions"><a class="btn gold" href="#busca-viva">Pesquisar agora →</a><a class="btn" href={base+'bancos'}>Abrir bancos de imagens</a><a class="btn" href={base+'historia-da-arte'}>Ir para História da Arte</a></div>
    </div>
    <div class="panel museum-source-map">
      <div class="eyebrow">MAPA DE FONTES</div>
      <div class="quote">{museumCatalog.length} instituições mapeadas.</div>
      <div class="museum-status-grid">
        <div><strong>{liveCount}</strong><span>consultas ao vivo</span></div>
        <div><strong>{museumCatalog.filter((m) => m.mode === 'advanced').length}</strong><span>APIs avançadas</span></div>
        <div><strong>{museumCatalog.filter((m) => m.mode === 'dataset').length}</strong><span>datasets abertos</span></div>
        <div><strong>{museumCatalog.filter((m) => m.mode === 'key').length}</strong><span>serviço com chave</span></div>
      </div>
      <p>“Aberto” não elimina a verificação individual dos direitos de cada registro.</p>
    </div>
  </section>

  <section class="museum-live" id="busca-viva" aria-labelledby="museum-search-title">
    <div class="museum-search-head">
      <div><div class="eyebrow">BUSCA VIVA · 3 ACERVOS</div><h2 id="museum-search-title">Uma pergunta, três museus — sem copiar o acervo.</h2></div>
      <p>O HARUM NOIR consulta metadados abertos e devolve portas para as fichas originais. Nada é espelhado na nossa biblioteca.</p>
    </div>
    <form class="museum-search" id="museum-search">
      <input id="museum-q" type="search" name="q" value="rembrandt" autocomplete="off" aria-label="Buscar em acervos abertos" aria-describedby="museum-message" placeholder="Ex.: Rembrandt, Hokusai, hands, charcoal…" />
      <button type="submit">Pesquisar</button>
    </form>
    <div class="museum-suggestions" role="group" aria-label="Sugestões de pesquisa">
      {['rembrandt','hokusai','hands','charcoal','portrait','flowers'].map(x=><button type="button" data-q={x}>{x}</button>)}
    </div>
    <div class="museum-provider-line">
      <span class="provider ready" data-provider="met" data-state="ready">MET · pronto</span>
      <span class="provider ready" data-provider="aic" data-state="ready">AIC · pronto</span>
      <span class="provider ready" data-provider="cma" data-state="ready">CMA · pronto</span>
      <p class="museum-message" id="museum-message" role="status" aria-live="polite" aria-atomic="true">Pesquise um artista, obra, tema ou material.</p>
    </div>
    <div class="museum-results" id="museum-results" role="list" aria-busy="false"></div>
  </section>

  <section class="section" id="catalogo">
    <div class="section-head">
      <div><div class="eyebrow">CATÁLOGO DE MUSEUS</div><h2>Fontes que valem voltar.</h2></div>
      <p>“Aberto” pode significar API sem chave, dados CC0, imagens Open Access, IIIF ou dataset para ingestão. A licença da obra continua sendo verificada individualmente.</p>
    </div>
    <div class="museum-catalog">
      {museumCatalog.map(m=><article class="museum-card" id={'museum-' + m.id} tabindex="-1" aria-labelledby={'museum-name-' + m.id}>
        <div class="museum-card-visual"><img src={base+'noir/visual-atlas/'+museumCovers[museumCatalog.indexOf(m)%museumCovers.length]} alt="" loading="lazy" decoding="async"/><span class="museum-mode">{modeLabel[m.mode]}</span><span class="museum-card-source">{m.city} · {m.country}</span></div>
        <h3 id={'museum-name-' + m.id}>{m.name}</h3>
        <p><strong>{m.access}</strong></p><p>{m.rights}</p><p>{m.note}</p>
        <div class="museum-links"><a class="museum-collection-link" href={m.collectionUrl} target="_blank" rel="noreferrer">Abrir coleção oficial ↗</a><a href={m.docsUrl} target="_blank" rel="noreferrer">documentação ↗</a><a href={m.apiUrl} target="_blank" rel="noreferrer">dados/API ↗</a></div>
      </article>)}
    </div>
  </section>

  <section class="section">
    <div class="journal"><div class="paper">
      <div class="eyebrow" style="color:#8a734b">PROTOCOLO HARUM NOIR</div>
      <h2>API não substitui curadoria.</h2>
      <p class="lead">Uma obra só entra no acervo visual reutilizável quando direitos, autoria, instituição e contexto ficam claros.</p>
      <ol><li>Buscar na API institucional.</li><li>Filtrar Public Domain / Open Access / CC0.</li><li>Abrir a ficha original.</li><li>Registrar URL, licença e instituição.</li><li>Usar a imagem para estudo, comparação e construção — não para fingir autoria.</li></ol>
      <p><a href={base+'historia-da-arte'}>Aplicar isso no Atlas Histórico →</a></p>
    </div></div>
  </section>
</main>
<Footer/>
<script>
const esc=(s)=>String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
const form=document.querySelector('#museum-search');
const input=document.querySelector('#museum-q');
const out=document.querySelector('#museum-results');
const msg=document.querySelector('#museum-message');
const providerIds=['met','aic','cma'];
const providerNames={met:'MET',aic:'AIC',cma:'CMA'};
const providerStates={ready:'pronto',loading:'consultando',ok:'disponível',down:'indisponível'};
const badges={met:document.querySelector('[data-provider="met"]'),aic:document.querySelector('[data-provider="aic"]'),cma:document.querySelector('[data-provider="cma"]')};
const API_TIMEOUT_MS=12000;
let requestSequence=0;
let requestControllers=[];
const setBadge=(id,state)=>{