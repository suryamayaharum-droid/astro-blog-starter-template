---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { museumCatalog } from '../data/museums';
import '../styles/museums.css';
const base=import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const liveCount=museumCatalog.filter(x=>x.mode==='live').length;
const modeLabel={live:'conectado agora',advanced:'API avançada',dataset:'dataset aberto',key:'requer chave'};
---
<!doctype html>
<html lang="pt-BR">
<head><BaseHead title="Museus Abertos · Harum Noir" description="Catálogo de museus e busca integrada em APIs Open Access, Public Domain e CC0 para estudo visual no Harum Noir." /></head>
<body>
<Header/>
<main>
  <section class="page-hero">
    <div class="eyebrow">HARUM NOIR · MUSEUS ABERTOS</div>
    <h1>Museus.</h1>
    <p>Um catálogo de acervos digitais para estudar direto da fonte. Parte deles já conversa com o HARUM NOIR em tempo real; os demais ficam mapeados para integrações progressivas.</p>
  </section>

  <section class="section museum-intro">
    <div class="panel">
      <div class="eyebrow">REDE ABERTA</div>
      <h2>O museu como biblioteca de estudo.</h2>
      <p>Em vez de depender de imagens soltas da internet, o ecossistema começa pelas instituições: metadados, direitos, imagem, data, técnica, autoria e ficha original.</p>
      <div class="actions"><a class="btn gold" href="#busca-viva">Pesquisar agora →</a><a class="btn" href={base+'bancos'}>Abrir bancos de imagens</a><a class="btn" href={base+'historia-da-arte'}>Ir para História da Arte</a></div>
    </div>
    <div class="panel">
      <div class="eyebrow">ESTADO DA CONEXÃO</div>
      <div class="quote">{liveCount} APIs sem chave já conectadas.</div>
      <p>Met, Art Institute of Chicago e Cleveland Museum formam o primeiro núcleo vivo. Getty, Rijksmuseum, Smithsonian e NGA entram como catálogo técnico para as próximas camadas.</p>
    </div>
  </section>

  <section class="museum-live" id="busca-viva">
    <div class="museum-search-head">
      <div><div class="eyebrow">BUSCA VIVA · 3 ACERVOS</div><h2>Uma pergunta, três museus — sem copiar o acervo.</h2></div>
      <p>O HARUM NOIR consulta metadados abertos e devolve portas para as fichas originais. Nada é espelhado na nossa biblioteca.</p>
    </div>
    <form class="museum-search" id="museum-search">
      <input id="museum-q" value="rembrandt" aria-label="Buscar em acervos abertos" placeholder="Ex.: Rembrandt, Hokusai, hands, charcoal…" />
      <button type="submit">Pesquisar</button>
    </form>
    <div class="museum-suggestions">
      {['rembrandt','hokusai','hands','charcoal','portrait','flowers'].map(x=><button type="button" data-q={x}>{x}</button>)}
    </div>
    <div class="museum-provider-line">
      <span class="provider" data-provider="met">MET · pronto</span>
      <span class="provider" data-provider="aic">AIC · pronto</span>
      <span class="provider" data-provider="cma">CMA · pronto</span>
      <span class="museum-message" id="museum-message">Pesquise um artista, obra, tema ou material.</span>
    </div>
    <div class="museum-results" id="museum-results" aria-live="polite"></div>
  </section>

  <section class="section" id="catalogo">
    <div class="section-head">
      <div><div class="eyebrow">CATÁLOGO DE MUSEUS</div><h2>Fontes que valem voltar.</h2></div>
      <p>“Aberto” pode significar API sem chave, dados CC0, imagens Open Access, IIIF ou dataset para ingestão. A licença da obra continua sendo verificada individualmente.</p>
    </div>
    <div class="museum-catalog">
      {museumCatalog.map(m=><article class="museum-card">
        <div class="museum-mode">{modeLabel[m.mode]}</div>
        <h3>{m.name}</h3><div class="place">{m.city} · {m.country}</div>
        <p><strong>{m.access}</strong></p><p>{m.rights}</p><p>{m.note}</p>
        <div class="museum-links"><a href={m.docsUrl} target="_blank" rel="noreferrer">documentação ↗</a><a href={m.apiUrl} target="_blank" rel="noreferrer">dados/API ↗</a></div>
      </article>)}
    </div>
  </section>

  <section class="section">
    <div class="journal"><div class="paper">
      <div class="eyebrow" style="color:#8a734b">PROTOCOLO HARUM NOIR</div>
      <h2>API não substitui curadoria.</h2>
      <p class="lead">Uma obra só entra no acervo visual reutilizável quando direitos, autoria, instituição e contexto ficam claros.</p>
      <ol><li>Buscar na API institucional.</li><li>Filtrar Public Domain / Open Access / CC0.</li><li>Abrir a ficha original.</li><li>Registrar URL, licença e instituição.</li><li>Usar a imagem para estudo, comparação e construção — não para fingir autoria.</li></ol>
      <p><a href={base+'historia-da-arte'}>Aplicar isso no Atlas Histórico →</a></p>
    </div></div>
  </section>
</main>
<Footer/>
<script>
const esc=(s)=>String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
const form=document.querySelector('#museum-search');
const input=document.querySelector('#museum-q');
const out=document.querySelector('#museum-results');
const msg=document.querySelector('#museum-message');
const badges={met:document.querySelector('[data-provider="met"]'),aic:document.querySelector('[data-provider="aic"]'),cma:document.querySelector('[data-provider="cma"]')};
const setBadge=(id,state)=>{const b=badges[id]; if(!b)return; b.className='provider '+(state==='ok'?'ok':'down'); b.textContent=id.toUpperCase()+' · '+(state==='ok'?'ok':'indisponível');};
const card=(w)=>'<a class="museum-work" href="'+esc(w.url)+'" target="_blank" rel="noreferrer"><div class="museum-work-body"><span>'+esc(w.museum)+'</span><h3>'+esc(w.title)+'</h3><p>'+esc(w.artist)+(w.date?' · '+esc(w.date):'')+'</p><small>'+esc(w.rights)+'</small></div></a>';
async function met(q){
  const s=await fetch('https://collectionapi.metmuseum.org/public/collection/v1.1/search?q='+encodeURIComponent(q)+'&hasImages=true&isPublicDomain=true&offset=0&limit=8');
  if(!s.ok)throw 0; const j=await s.json(); const ids=(j.objectIDs||[]).slice(0,5);
  const rows=await Promise.all(ids.map(async id=>{try{const r=await fetch('https://collectionapi.metmuseum.org/public/collection/v1/objects/'+id);const x=await r.json();if(!x.isPublicDomain||!(x.primaryImageSmall||x.primaryImage))return null;return{museum:'The Met',title:x.title,artist:x.artistDisplayName||x.culture||'Autor não identificado',date:x.objectDate||'',image:x.primaryImageSmall||x.primaryImage,url:x.objectURL,rights:'Public Domain · Open Access'}}catch{return null}}));
  return rows.filter(Boolean);
}
async function aic(q){
  const u='https://api.artic.edu/api/v1/artworks/search?q='+encodeURIComponent(q)+'&query%5Bterm%5D%5Bis_public_domain%5D=true&limit=6&fields=id,title,artist_title,date_display,image_id,is_public_domain';
  const r=await fetch(u); if(!r.ok)throw 0; const j=await r.json(); const iiif=j.config?.iiif_url||'https://www.artic.edu/iiif/2';
  return (j.data||[]).filter(x=>x.is_public_domain&&x.image_id).map(x=>({museum:'Art Institute of Chicago',title:x.title,artist:x.artist_title||'Autor não identificado',date:x.date_display||'',image:iiif+'/'+x.image_id+'/full/843,/0/default.jpg',url:'https://www.artic.edu/artworks/'+x.id,rights:'Public Domain · IIIF'}));
}
async function cma(q){
  const r=await fetch('https://openaccess-api.clevelandart.org/api/artworks/?q='+encodeURIComponent(q)+'&cc0&has_image=1&limit=6'); if(!r.ok)throw 0; const j=await r.json();
  return (j.data||[]).filter(x=>x.share_license_status==='CC0'&&x.images?.web?.url).map(x=>({museum:'Cleveland Museum of Art',title:x.title,artist:x.creators?.[0]?.description||'Autor não identificado',date:x.creation_date||'',image:x.images.web.url,url:x.url,rights:'CC0 · Open Access'}));
}
async function run(q){
  q=(q||input.value||'').trim(); if(q.length<2){msg.textContent='Digite pelo menos 2 caracteres.';return}
  msg.textContent='Consultando acervos abertos…'; out.innerHTML='';
  const rs=await Promise.allSettled([met(q),aic(q),cma(q)]); const ids=['met','aic','cma']; let works=[];
  rs.forEach((r,i)=>{if(r.status==='fulfilled'){setBadge(ids[i],'ok');works=works.concat(r.value)}else setBadge(ids[i],'down')});
  out.innerHTML=works.map(card).join(''); msg.textContent=works.length?works.length+' resultados abertos reunidos.':'Nenhuma obra aberta encontrada nesta busca.';
}
form?.addEventListener('submit',e=>{e.preventDefault();run()});
document.querySelectorAll('[data-q]').forEach(b=>b.addEventListener('click',()=>{input.value=b.dataset.q;run(b.dataset.q)}));
const incoming=new URLSearchParams(location.search).get('q');
if(incoming&&incoming.trim().length>=2){input.value=incoming;run(incoming)}
</script>
</body></html>