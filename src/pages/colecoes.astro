---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const base=import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const collections=[
  {id:'gesto',number:'01',eyebrow:'GESTO · CORPO',title:'A mão em ação.',text:'Repousar, tocar, segurar, pressionar. Leia a direção e a pressão antes de separar os dedos.',image:'maos-seis-gestos',alt:'Seis estudos de mãos em repouso, toque, preensão, pressão, tensão e proteção.',href:'maos/#exercicio',link:'Praticar seis gestos'},
  {id:'forma',number:'02',eyebrow:'FORMA · LUZ',title:'Do volume à borda.',text:'Reduza o objeto a massas grandes. Compare luz, sombra e bordas antes de procurar acabamento.',image:'exercicio-quatro-decisoes',alt:'Quatro etapas de um estudo de pera e tecido: gesto, massas tonais, bordas e seleção de detalhes.',href:'escola/#primeira-pratica',link:'Fazer a primeira prática'},
  {id:'materia',number:'03',eyebrow:'MATÉRIA · CARVÃO',title:'Marcar, apagar, revelar.',text:'Experimente pressão, textura e apagamento para fazer a luz surgir do papel escuro.',image:'charcoal-marks',alt:'Marcas de carvão em diferentes pressões e texturas sobre papel de estudo.',href:'cadernos/vestigio/',link:'Abrir o Caderno Vestígio'},
  {id:'caderno',number:'04',eyebrow:'CADERNO · MEMÓRIA',title:'O caderno como universo.',text:'Uma pergunta, uma prática e um vestígio organizam o pensamento entre uma página e a próxima.',image:'open-sketchbook',alt:'Caderno aberto em uma composição editorial de ateliê.',href:'cadernos/',link:'Percorrer os Cadernos'}
];
---
<!doctype html><html lang="pt-BR"><head><BaseHead title="Coleções Visuais · HARUM NOIR" description="Coleções visuais de desenho: gesto e corpo, forma e luz, matéria e carvão. Cada estudo termina em uma prática." alternates={[{hreflang:"en",href:base+"en/collections/"},{hreflang:"es",href:base+"es/colecciones/"}]} /></head><body><Header/><main class="collections">
<section class="collection-hero">
  <figure><img src={base+'noir/visual-atlas/harum-noir-colecoes-atlas.webp'} alt="Tríptico de estudos em carvão: volumes iluminados, gestos de mãos e texturas de matéria." width="1400" height="600" fetchpriority="high"/><figcaption>Prancha editorial criada com assistência de IA para forma, gesto e matéria; o Caderno abre uma trilha própria.</figcaption></figure>
  <div class="collection-hero-copy"><div class="eyebrow">HARUM NOIR · ATLAS DE ESTUDO</div><h1>Aprender pelo olhar.</h1><p>Quatro portas para sair da explicação e chegar à prática: gesto, forma, matéria e caderno. Escolha uma imagem, observe uma decisão e teste-a no papel.</p><a class="btn gold" href="#colecoes">Explorar as coleções ↓</a><div class="collection-languages"><a href={base+'en/collections/'}>English</a><a href={base+'es/colecciones/'}>Español</a></div></div>
</section>
<section class="section" id="colecoes"><div class="section-head"><div><div class="eyebrow">QUATRO PORTAS · UM CADERNO</div><h2>Comece pelo que quer enxergar.</h2></div><p>Imagens didáticas criadas com assistência de IA; não representam obras históricas nem substituem referência anatômica clínica.</p></div>
<div class="collection-grid">{collections.map((item)=><article class="collection-card" id={item.id}>
<a class="collection-image" href={base+item.href}><img src={base+'noir/visual-atlas/'+item.image+'.webp'} alt={item.alt} width="900" height="600" loading="lazy"/><span>{item.number}</span></a>
<div class="collection-copy"><small>{item.eyebrow}</small><h3>{item.title}</h3><p>{item.text}</p><a href={base+item.href}>{item.link} <span aria-hidden="true">↗</span></a></div>
</article>)}</div>
</section>
<section class="section"><div class="journal"><div class="paper"><div class="eyebrow" style="color:#8a734b">COMO USAR</div><h2>Uma imagem, uma pergunta, um estudo.</h2><p class="lead">A imagem ajuda a ver; a prática confirma o que você aprendeu.</p><p>Escolha uma coleção, faça um desenho curto e anote uma decisão que seja sua. Guarde a referência como ponto de partida, não como resultado.</p><p><a href={base+'escola/'}>Voltar à Escola Aberta →</a></p></div></div></section>
</main><Footer/></body></html>
<style>
.collections .collection-hero{max-width:1320px;margin:auto;padding:28px clamp(18px,5vw,70px) 52px;display:grid;grid-template-columns:1.1fr .9fr;gap:clamp(24px,5vw,70px);align-items:center;border-bottom:1px solid var(--line)}
.collection-hero figure{margin:0;min-width:0;border:1px solid var(--line);background:#111}.collection-hero figure img{display:block;width:100%;height:auto;aspect-ratio:7/3;object-fit:cover}.collection-hero figcaption{padding:8px 11px;color:var(--paper-2);font-size:.68rem;border-top:1px solid var(--line)}
.collection-languages{display:flex;gap:16px;margin-top:18px;font-size:.76rem}.collection-languages a{color:var(--paper-2)}.collection-hero-copy h1{font-size:clamp(3.2rem,7vw,6.6rem);line-height:.92;letter-spacing:-.055em;margin:16px 0}.collection-hero-copy p{max-width:44ch;color:var(--paper-2);line-height:1.7;margin-bottom:24px}
.collection-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.collection-card{overflow:hidden;border:1px solid var(--line);border-radius:14px;background:#111214}.collection-image{position:relative;display:block;aspect-ratio:4/3;overflow:hidden}.collection-image img{display:block;width:100%;height:100%;object-fit:cover;filter:saturate(.58);transition:transform .25s}.collection-image:hover img{transform:scale(1.025)}.collection-image>span{position:absolute;top:12px;left:12px;padding:5px 8px;background:#090909d9;border:1px solid var(--line);border-radius:999px;color:var(--paper);font-size:.68rem}
.collection-copy{padding:20px}.collection-copy small{color:var(--gold);letter-spacing:.12em;font-size:.65rem}.collection-copy h3{font-size:1.7rem;line-height:1.05;margin:12px 0}.collection-copy p{min-height:4.5em;color:var(--paper-2);font-size:.86rem;line-height:1.6}.collection-copy>a{display:flex;justify-content:space-between;gap:8px;padding-top:12px;border-top:1px solid var(--line);color:var(--gold);font-size:.76rem;text-decoration:none}
.collections .journal{max-width:100%}.collections .journal .paper{border-radius:4px}
@media(max-width:850px){.collections .collection-hero{grid-template-columns:1fr}.collection-hero-copy{order:-1}}
@media(max-width:580px){.collections .collection-hero{padding-top:16px;padding-bottom:36px}.collection-hero-copy h1{font-size:clamp(2.8rem,13vw,4.2rem)}.collection-grid{grid-template-columns:1fr}.collection-copy p{min-height:0}}
@media(prefers-reduced-motion:reduce){.collection-image img{transition:none}.collection-image:hover img{transform:none}}
</style>
