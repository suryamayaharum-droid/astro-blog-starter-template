---
import EcosystemRail from '../components/EcosystemRail.astro';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {referenceArtists} from '../data/references';
const base=import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const find=(slug)=>referenceArtists.find(a=>a.slug===slug);
const paths=[
  {id:"carvao",n:"01",title:"Carvão & presença",text:"Matéria, gesto, borda, apagamento e a decisão de onde a figura realmente existe.",image:"visual-atlas/harum-noir-caderno-estudo.webp",refs:["mad-charcoal","silvie-mahdal","zin-lim","dirk-dzimirsky"],caderno:"presenca",temporada:"01",biblioteca:"atelier-historico-aberto"},
  {id:"figura",n:"02",title:"Figura viva",text:"Peso, ritmo, centro de massa, anatomia e movimento antes do acabamento.",image:"visual-atlas/maos-seis-gestos.webp",refs:["proko","love-life-drawing","chommang","steve-huston"],caderno:"gesto",temporada:"01",biblioteca:"anatomias-do-mundo"},
  {id:"silencio",n:"03",title:"Silêncio & processo",text:"Quando o processo, o tempo, a mão e o som do material carregam a narrativa.",image:"visual-atlas/drapery-still-life.webp",refs:["peter-draws","akihito-yoshitomi","daria-callie","jono-dry"],caderno:"vestigio",temporada:"07",biblioteca:"caderno-como-universo"},
  {id:"estrutura",n:"04",title:"Estrutura & anatomia",text:"Construção, proporção, perspectiva, cabeça, mãos e organização antes da superfície.",image:"visual-atlas/harum-noir-caderno-olhar.webp",refs:["proko","sinix-design","moderndayjames","stephen-bauman","new-masters-academy"],caderno:"olhar",temporada:"03",biblioteca:"maos-sem-formula"},
  {id:"mundo",n:"05",title:"Sketchbook & mundo autoral",text:"Caderno como laboratório, arquivo, narrativa e lugar onde uma linguagem começa a acumular memória.",image:"visual-atlas/open-sketchbook.webp",refs:["karl-kopinski","kim-jung-gi-super-ani","drawingwiffwaffles","aaron-blaise"],caderno:"memoria",temporada:"04",biblioteca:"caderno-como-universo"},
];
---
<!doctype html><html lang="pt-BR"><head><BaseHead title="Percursos · Harum Noir" description="Caminhos curatoriais que ligam referências, cadernos, ateliê, temporadas e prática."/></head>
<body><Header/><main>
<section class="page-hero"><div class="eyebrow">PERCURSOS</div><h1>Escolha por onde entrar.</h1><p>O site não precisa ser lido em ordem. Cada percurso aproxima referências, estudo e prática em torno de uma pergunta diferente.</p></section>

<section class="path-index">
 {paths.map(p=><a class="path-index-card" href={'#'+p.id}><span>{p.n}</span><strong>{p.title}</strong><small>{p.text}</small></a>)}
</section>

{paths.map(p=>{
 const refs=p.refs.map(find).filter(Boolean);
 return <section class="journey" id={p.id}>
   <div class="journey-intro">
     <div class="journey-image"><img src={base+'noir/'+p.image} alt=""/></div>
     <div><span class="eyebrow">PERCURSO {p.n}</span><h2>{p.title}</h2><p>{p.text}</p>
       <div class="actions"><a class="btn primary" href={base+'cadernos#'+p.caderno}>Abrir caderno</a><a class="btn" href={base+'biblioteca#'+p.biblioteca}>Abrir fontes</a></div>
       <p class="journey-next">Depois, se quiser aprofundar: <a href={base+'temporadas#t'+p.temporada}>temporada</a><a href={base+'atelier'}>ateliê</a></p>
     </div>
   </div>
   {p.id==="mundo"&&<div class="journal" style="margin-top:28px"><div class="paper">
     <div class="eyebrow" style="color:#8a734b">CADERNO COMO UNIVERSO</div>
     <h2>O mundo autoral aparece antes de virar estilo.</h2>
     <p class="lead">Primeiro vêm as recorrências.</p>
     <p>Uma mão desenhada muitas vezes. Um animal que volta. A mesma janela. Um tipo de sombra. Uma anotação que só faz sentido para quem desenhou. O sketchbook fica interessante quando deixa de ser vitrine e começa a registrar relações.</p>
     <div class="path-index" style="margin-top:18px">
       <div class="path-index-card"><span>01</span><strong>Repertório</strong><small>Desenhe coisas diferentes sem exigir que cada página prove alguma coisa.</small></div>
       <div class="path-index-card"><span>02</span><strong>Recorrência</strong><small>Observe o que reaparece espontaneamente: temas, formas, gestos, personagens e lugares.</small></div>
       <div class="path-index-card"><span>03</span><strong>Conexão</strong><small>Comece a aproximar elementos que antes estavam separados. É aí que um universo começa.</small></div>
     </div>
     <p style="font-size:.82rem;opacity:.72;margin-top:18px">Fontes abertas para observar o caderno como processo: <a href="https://www.rijksmuseum.nl/en/collection/object/Schetsboek--8ac2d7c29817cfff23657152a2165d3a" target="_blank" rel="noreferrer">Leo Gestel · Rijksmuseum</a> · <a href="https://www.si.edu/object/sketchbook-page%3Achndm_1984-86-4-46" target="_blank" rel="noreferrer">Kenyon Cox · Smithsonian</a> · <a href="https://www.metmuseum.org/art/collection/search/14878" target="_blank" rel="noreferrer">Francis William Edmonds · The Met</a>.</p><p><a href={base+"biblioteca#caderno-como-universo"}>Abrir a coleção completa na Biblioteca →</a></p>
   </div></div>}
   <div class="stream-head"><div><span class="eyebrow">REFERÊNCIAS DO PERCURSO</span><h3>Olhe por ângulos diferentes</h3></div></div>
   <div class="stream-rail">{refs.map(a=><a class="stream-card" href={base+'referencias/'+a!.slug}><div class="stream-card-media"><img class="stream-fallback" src={base+'noir/visual-atlas/harum-noir-caderno-estudo.webp'} alt=""/>{a!.videoId&&a!.slug!=="zin-lim"&&<img class="stream-thumb" src={'https://i.ytimg.com/vi/'+a!.videoId+'/hqdefault.jpg'} alt={'Referência visual de '+a!.name} loading="lazy" onerror="this.remove()"/>}</div><div class="stream-card-body"><span>{a!.focus}</span><h3>{a!.name}</h3></div></a>)}</div>
 </section>
})}

<section class="section"><div class="journal"><div class="paper"><div class="eyebrow" style="color:#8a734b">UMA REGRA</div><h2>O percurso termina no papel.</h2><p class="lead">Navegar é só a primeira metade.</p><p>Escolha uma referência, extraia uma pergunta e faça um estudo. O jardim só funciona quando alguma coisa volta para a mão.</p><a href={base+'roubar-como-artista'}>Como estudar referência sem virar cópia →</a></div></div></section>
<EcosystemRail current="percursos" limit={5} />
</main><Footer/></body></html>
