---
import BaseHead from '../../components/BaseHead.astro';
const base=import.meta.env.BASE_URL.endsWith('/')?import.meta.env.BASE_URL:import.meta.env.BASE_URL+'/';
const alternates=[{hreflang:'pt-BR',href:''},{hreflang:'es',href:'es/'}];
---
<!doctype html><html lang="en"><head><BaseHead title="HARUM NOIR · Drawing, charcoal and visual research from Brazil" description="Explore HARUM NOIR, an editorial atelier from Salvador, Brazil: charcoal drawing, figure, anatomy, art history, visual references and tattoo composition." locale="en" alternates={alternates}/></head>
<body class="international-page">
<header class="intl-header"><a class="intl-brand" href={base}>HARUM NOIR</a><nav aria-label="Languages"><a href={base}>PT</a><a aria-current="page" href={base+'en/'}>EN</a><a href={base+'es/'}>ES</a></nav></header>
<main>
<section class="intl-hero"><img src={base+'noir/visual-atlas/atelier-desk.webp'} alt="HARUM NOIR editorial atelier" width="1200" height="800"/><div class="intl-shade"></div><div class="intl-copy"><span>EDITORIAL ATELIER · SALVADOR · BRAZIL</span><h1>Drawing as a way to <em>see deeper.</em></h1><p>HARUM NOIR is the editorial world of Arte Harum: charcoal, figure, anatomy, gesture, art history and visual research connected to an authorial tattoo practice.</p><div class="intl-actions"><a href={base+'referencias/'}>Explore artist references</a><a href={base+'historia-da-arte/'}>Art history</a><a href={base+'biblioteca/'}>Visual library</a></div></div></section>
<section class="intl-grid">
<article><b>01 · REFERENCES</b><h2>Artists to study, not copy.</h2><p>A curated atlas of artists, methods, drawing processes and visual languages, with links back to original sources.</p><a href={base+'referencias/'}>Open the reference atlas →</a></article>
<article><b>02 · ARCHIVES</b><h2>Museums and public collections.</h2><p>Research routes through museums, libraries and open-access collections while preserving provenance and attribution.</p><a href={base+'bancos/'}>Explore image banks →</a></article>
<article><b>03 · PRACTICE</b><h2>Return research to the hand.</h2><p>Study notebooks, short sessions and guided pathways transform observation into drawing practice.</p><a href={base+'cadernos/'}>Open study notebooks →</a></article>
<article><b>04 · TATTOO</b><h2>From repertoire to the body.</h2><p>The related Studio 23 practice develops authorial tattoo projects in Salvador, Bahia.</p><a href="https://tattoostudio23.suryamaya-harum.chatgpt.site/" target="_blank" rel="noreferrer">Visit Tattoo Studio 23 ↗</a></article>
</section>
<section class="intl-note"><p><strong>Language note.</strong> The international gateway is in English; much of the deeper archive remains in Portuguese for now. Visual collections are intentionally language-light, and additional localized paths can be added without changing the archive structure.</p></section>
</main>
<footer class="intl-footer"><span>HARUM NOIR · Arte Harum · Salvador, Bahia, Brazil</span><a href={base}>Português</a><a href={base+'es/'}>Español</a></footer>
<style>
:global(body){margin:0;background:#090909;color:#f4efe6;font-family:Manrope,Arial,sans-serif}.intl-header{position:sticky;top:0;z-index:10;display:flex;justify-content:space-between;align-items:center;padding:18px clamp(18px,5vw,72px);background:rgba(7,7,7,.92);border-bottom:1px solid rgba(240,236,227,.18);backdrop-filter:blur(14px)}.intl-brand{font-family:"Cormorant Garamond",serif;letter-spacing:.14em;text-decoration:none}.intl-header nav{display:flex;gap:8px}.intl-header nav a{padding:6px 9px;border:1px solid rgba(240,236,227,.18);text-decoration:none;font-size:12px}.intl-header nav a[aria-current]{border-color:#d2b477;color:#d2b477}.intl-hero{min-height:68svh;position:relative;display:flex;align-items:end;overflow:hidden}.intl-hero>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.intl-shade{position:absolute;inset:0;background:linear-gradient(0deg,rgba(5,5,5,.96),rgba(5,5,5,.25))}.intl-copy{position:relative;z-index:2;max-width:920px;padding:clamp(80px,12vw,150px) clamp(18px,6vw,90px) 70px}.intl-copy>span,.intl-grid b{color:#d2b477;font-size:12px;letter-spacing:.16em}.intl-copy h1{font:400 clamp(58px,9vw,118px)/.88 "Cormorant Garamond",serif;margin:16px 0}.intl-copy h1 em{color:#d2b477;font-weight:400}.intl-copy p{max-width:740px;color:#d8d0c4;font-size:18px}.intl-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:28px}.intl-actions a,.intl-grid a{color:#d2b477}.intl-actions a{padding:12px 16px;border:1px solid #d2b477;text-decoration:none}.intl-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;background:rgba(240,236,227,.18)}.intl-grid article{padding:clamp(28px,5vw,70px);background:#0b0b0b}.intl-grid h2{font:400 clamp(34px,5vw,64px)/1 "Cormorant Garamond",serif;margin:14px 0}.intl-grid p,.intl-note{color:#c8c0b5}.intl-note{padding:40px clamp(18px,6vw,90px);border-top:1px solid rgba(240,236,227,.18)}.intl-note p{max-width:900px}.intl-footer{display:flex;flex-wrap:wrap;gap:18px;padding:28px clamp(18px,6vw,90px);border-top:1px solid rgba(240,236,227,.18);font-size:13px}.intl-footer a{color:#d2b477}@media(max-width:760px){.intl-grid{grid-template-columns:1fr}.intl-hero{min-height:62svh}.intl-copy{padding-top:90px}.intl-copy h1{font-size:clamp(48px,16vw,76px)}.intl-actions a{width:100%;text-align:center}.intl-header{padding-inline:14px}}
</style>
</body></html>