---
import InternationalHub from '../../components/InternationalHub.astro';
const base=import.meta.env.BASE_URL.endsWith('/')?import.meta.env.BASE_URL:import.meta.env.BASE_URL+'/';
const cards=[
{kicker:'GESTURE · BODY',title:'The hand in action.',text:'Resting, touching, holding and pressing. Read direction and pressure before separating the fingers.',href:base+'en/drawing/',label:'Study gesture and figure →'},
{kicker:'FORM · LIGHT',title:'From volume to edge.',text:'Reduce an object to large masses. Compare light, shadow and edges before searching for finish.',href:base+'en/school/#primeira-pratica',label:'Try the first practice →'},
{kicker:'MATERIAL · CHARCOAL',title:'Press, erase, decide.',text:'Study the hand at work, compare marks and erasures, then keep the decisions that preserve form and light.',href:base+'en/drawing/',label:'Explore charcoal practice →'},
{kicker:'FIGURE · BALANCE',title:'Gesture, weight and presence.',text:'Find the action line, body tilt and point of support before building details.',href:base+'en/collections/figure-gesture/',label:'Study gesture and balance →'},
{kicker:'NOTEBOOK · MEMORY',title:'The sketchbook as a world.',text:'A question, a practice and a trace organize thought between one page and the next.',href:base+'en/references/',label:'Continue visual research →'}
];
---
<InternationalHub lang="en" title="Visual Collections · HARUM NOIR" description="Four visual collections for drawing study: gesture and body, form and light, charcoal and material, notebook and memory." kicker="HARUM NOIR · STUDY ATLAS" heading="Learn through looking." lead="Four visual entry points from explanation to practice. Choose an image, notice one decision and test it on paper." cards={cards} alternateHref={base+'es/colecciones/'} alternateLang="es" alternateLabel="Colecciones visuales" ptHref={base+'colecoes/'} topics={['gesture','drawing','charcoal','visual research']}/>