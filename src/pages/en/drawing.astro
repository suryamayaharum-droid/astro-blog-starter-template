---
import InternationalHub from '../../components/InternationalHub.astro';
import { STUDIO_SITE } from '../../consts';
const base=import.meta.env.BASE_URL.endsWith('/')?import.meta.env.BASE_URL:import.meta.env.BASE_URL+'/';
const cards=[
{kicker:'CHARCOAL',title:'Mass before contour.',text:'Study pressure, lost edges, tonal blocks and the material behavior of charcoal.',href:base+'en/references/',label:'Open visual library →'},
{kicker:'FIGURE',title:'Gesture, weight and anatomy.',text:'Move from line of action into torso, pelvis, hands, expression and structural observation.',href:base+'en/collections/',label:'Open study notebooks →'},
{kicker:'PATHWAYS',title:'Study in short sequences.',text:'Use guided pathways to turn references into drawing decisions instead of passive browsing.',href:base+'en/drawing/',label:'Open pathways →'},
{kicker:'TATTOO',title:'Translate repertoire to the body.',text:'The related Studio 23 practice turns drawing research into authorial tattoo composition in Salvador, Brazil.',href:STUDIO_SITE,label:'Visit Studio 23 ↗'}
];
const answers=[
  {
    "question": "What does HARUM NOIR mean by charcoal drawing?",
    "answer": "Charcoal is treated as mass, pressure, edge, atmosphere and rhythm—not only as a black line. Studies focus on tonal structure before detail."
  },
  {
    "question": "How is figure drawing approached?",
    "answer": "Through gesture, balance, weight, torso-pelvis relationships, hands, expression and anatomical landmarks. Observation leads; anatomy supports it."
  },
  {
    "question": "Do I need to copy photographs exactly?",
    "answer": "No. Reference is used to understand structure and visual decisions. The practice aims to build an authorial response rather than a photographic duplicate."
  },
  {
    "question": "Why connect drawing practice to tattoo composition?",
    "answer": "Both depend on proportion, hierarchy, negative space, readability and the relationship between image and body. Drawing research gives tattoo composition a stronger visual foundation."
  }
];
---
<InternationalHub lang="en" title="Charcoal and Figure Drawing · HARUM NOIR" description="Charcoal drawing, figure study, artistic anatomy, gesture and authorial visual research from HARUM NOIR in Salvador, Brazil." kicker="HARUM NOIR · DRAWING PRACTICE" heading="Charcoal, figure and presence." lead="A drawing practice built around observation, gesture, anatomy, contrast and material. Research becomes useful only when it returns to the hand." cards={cards} answers={answers} alternateHref={base+'es/dibujo/'} alternateLang="es" alternateLabel="Ver esta página en español →" ptHref={base+'desenho/'} topics={['charcoal drawing','figure drawing','artistic anatomy','gesture drawing','tattoo composition']}/>