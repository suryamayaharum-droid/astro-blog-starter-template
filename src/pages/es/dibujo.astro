---
import InternationalHub from '../../components/InternationalHub.astro';
const base=import.meta.env.BASE_URL.endsWith('/')?import.meta.env.BASE_URL:import.meta.env.BASE_URL+'/';
const cards=[
{kicker:'CARBÓN',title:'Masa antes que contorno.',text:'Estudia presión, bordes perdidos, bloques tonales y comportamiento material del carbón.',href:base+'biblioteca/',label:'Abrir biblioteca visual →'},
{kicker:'FIGURA',title:'Gesto, peso y anatomía.',text:'Pasa de la línea de acción al torso, pelvis, manos, expresión y observación estructural.',href:base+'cadernos/',label:'Abrir cuadernos →'},
{kicker:'RECORRIDOS',title:'Estudia en secuencias breves.',text:'Usa recorridos guiados para convertir referencias en decisiones de dibujo, no navegación pasiva.',href:base+'percursos/',label:'Abrir recorridos →'},
{kicker:'TATUAJE',title:'Traduce repertorio al cuerpo.',text:'La práctica vinculada Studio 23 transforma investigación de dibujo en composición de tatuaje autoral en Salvador, Brasil.',href:'https://tattoostudio23.suryamaya-harum.chatgpt.site/',label:'Visitar Studio 23 ↗'}
];
---
<InternationalHub lang="es" title="Dibujo al Carbón y Figura · HARUM NOIR" description="Dibujo al carbón, estudio de figura, anatomía artística, gesto e investigación visual autoral desde Salvador, Brasil." kicker="HARUM NOIR · PRÁCTICA DE DIBUJO" heading="Carbón, figura y presencia." lead="Una práctica construida sobre observación, gesto, anatomía, contraste y materia. La investigación solo se vuelve útil cuando vuelve a la mano." cards={cards} alternateHref={base+'en/drawing/'} alternateLang="en" alternateLabel="View this page in English →"/>