---
import InternationalHub from '../../components/InternationalHub.astro';
import { STUDIO_SITE } from '../../consts';
const base=import.meta.env.BASE_URL.endsWith('/')?import.meta.env.BASE_URL:import.meta.env.BASE_URL+'/';
const cards=[
{kicker:'CARBÓN',title:'Masa antes que contorno.',text:'Estudia presión, bordes perdidos, bloques tonales y comportamiento material del carbón.',href:base+'es/referencias/',label:'Abrir biblioteca visual →'},
{kicker:'FIGURA',title:'Gesto, peso y anatomía.',text:'Pasa de la línea de acción al torso, pelvis, manos, expresión y observación estructural.',href:base+'es/colecciones/',label:'Abrir cuadernos →'},
{kicker:'RECORRIDOS',title:'Estudia en secuencias breves.',text:'Usa recorridos guiados para convertir referencias en decisiones de dibujo, no navegación pasiva.',href:base+'es/dibujo/',label:'Abrir recorridos →'},
{kicker:'TATUAJE',title:'Traduce repertorio al cuerpo.',text:'La práctica vinculada Studio 23 transforma investigación de dibujo en composición de tatuaje autoral en Salvador, Brasil.',href:STUDIO_SITE,label:'Visitar Studio 23 ↗'}
];
const answers=[
  {
    "question": "¿Qué significa dibujo al carbón en HARUM NOIR?",
    "answer": "El carbón se estudia como masa, presión, borde, atmósfera y ritmo, no solo como línea negra. Los ejercicios priorizan la estructura tonal antes del detalle."
  },
  {
    "question": "¿Cómo se aborda el dibujo de figura?",
    "answer": "A través de gesto, equilibrio, peso, relación torso-pelvis, manos, expresión y referencias anatómicas. La observación guía y la anatomía ayuda a entender."
  },
  {
    "question": "¿Es necesario copiar una fotografía exactamente?",
    "answer": "No. La referencia sirve para comprender estructura y decisiones visuales. La práctica busca construir una respuesta autoral, no un duplicado fotográfico."
  },
  {
    "question": "¿Por qué relacionar dibujo y composición para tatuaje?",
    "answer": "Ambos dependen de proporción, jerarquía, espacio negativo, legibilidad y relación entre imagen y cuerpo. La investigación de dibujo fortalece la composición del tatuaje."
  }
];
---
<InternationalHub lang="es" title="Dibujo al Carbón y Figura · HARUM NOIR" description="Dibujo al carbón, estudio de figura, anatomía artística, gesto e investigación visual autoral desde Salvador, Brasil." kicker="HARUM NOIR · PRÁCTICA DE DIBUJO" heading="Carbón, figura y presencia." lead="Una práctica construida sobre observación, gesto, anatomía, contraste y materia. La investigación solo se vuelve útil cuando vuelve a la mano." cards={cards} answers={answers} alternateHref={base+'en/drawing/'} alternateLang="en" alternateLabel="View this page in English →" ptHref={base+'desenho/'} topics={['dibujo al carbón','figura','anatomía artística','gesto','composición para tatuaje']}/>