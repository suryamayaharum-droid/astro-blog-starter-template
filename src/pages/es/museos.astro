---
import InternationalHub from '../../components/InternationalHub.astro';
const base=import.meta.env.BASE_URL.endsWith('/')?import.meta.env.BASE_URL:import.meta.env.BASE_URL+'/';
const cards=[
{kicker:'APIS DE MUSEOS',title:'Busca en colecciones abiertas.',text:'Explora instituciones con APIs abiertas, registros de dominio público y metadatos de la fuente original.',href:base+'museus/',label:'Abrir búsqueda de museos →'},
{kicker:'BANCOS DE IMÁGENES',title:'Usa archivos como mapas de investigación.',text:'Compara museos, bibliotecas y archivos por acceso, derechos, fortalezas y períodos.',href:base+'bancos/',label:'Explorar bancos de imágenes →'},
{kicker:'BRASIL',title:'Investiga la memoria visual brasileña.',text:'Sigue la ruta de la Biblioteca Nacional Digital para Bahia, Salvador, grabados del siglo XIX y memoria gráfica.',href:base+'bancos/bndigital/',label:'Abrir guía BNDigital →'},
{kicker:'DERECHOS',title:'Mantén visible la procedencia.',text:'HARUM NOIR trata a la institución como fuente canónica y no copia colecciones enteras.',href:base+'bancos/',label:'Revisar rutas de fuentes →'}
];
---
<InternationalHub lang="es" title="Museos Abiertos y Archivos Visuales · HARUM NOIR" description="Explora museos, colecciones de dominio público, archivos visuales y rutas Open Access para dibujo e historia del arte." kicker="HARUM NOIR · COLECCIONES ABIERTAS" heading="Los museos son fuentes, no decoración." lead="Busca colecciones, preserva la procedencia y vuelve a la institución que conserva el registro. HARUM NOIR añade rutas de estudio, no bibliotecas copiadas." cards={cards} alternateHref={base+'en/museums/'} alternateLang="en" alternateLabel="View this page in English →"/>