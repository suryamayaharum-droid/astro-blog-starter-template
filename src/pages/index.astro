---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { cadernos, fundamentos, temporadas } from '../data/public';
import { referenceArtists, byRank } from '../data/references';
import { artHistoryPeriods } from '../data/artHistory';
import { imageBanks, studyFans } from '../data/imageBanks';
import '../styles/browse.css';

const base=import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const startRanks=[17,39,9,18,38,36,27,50];
const startRefs=startRanks.map(byRank).filter(Boolean);
const periodIds=["grecia-roma","renascimento","barroco","ukiyoe","impressionismo","modernismos"];
const bankIds=["bndigital","met","rijks","getty","aic","paris-musees","walters"];
const periods=periodIds.map(id=>artHistoryPeriods.find(p=>p.id===id)).filter(Boolean);
const banks=bankIds.map(id=>imageBanks.find(b=>b.id===id)).filter(Boolean);
const studySessions=[
  {time:"12 min",title:"Gesto sem contorno",text:"Linha de ação, peso e três tempos de pose.",href:base+"cadernos#gesto"},
  {time:"18 min",title:"Carvão & noite",text:"Massa escura, borda perdida e uma zona de luz.",href:base+"bancos#leques"},
  {time:"20 min",title:"Mãos que fazem algo",text:"A mão como verbo: segurar, apoiar, puxar, proteger.",href:base+"busca?q="+encodeURIComponent("hands gesture drawing")},
  {time:"22 min",title:"Barroco em duas luzes",text:"Diagonal, descoberta e narrativa antes do acabamento.",href:base+"historia-da-arte#barroco"},
  {time:"15 min",title:"Linha japonesa",text:"Recorte, padrão, vazio e síntese gráfica.",href:base+"historia-da-arte#ukiyoe"},
  {time:"25 min",title:"Bahia em arquivo",text:"Paisagem, cidade e memória visual pela Biblioteca Nacional Digital.",href:base+"bancos/bndigital/"}
];
---
<!doctype html><html lang="pt-BR"><head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION}/></head>
<body><Header/><main>
<section class="browse-hero">
  <div class="browse-hero-art"><img src={base+'noir/visual-atlas/atelier-desk.webp'} alt="Mesa de ateliê em natureza-morta editorial HARUM NOIR"/></div>
  <div class="browse-hero-shade"></div>
  <div class="browse-hero-copy">
    <div class="browse-badge">ATELIÊ EDITORIAL · SALVADOR</div>
    <h1>Estude como quem entra num mundo.</h1>
    <p>História da arte, desenho, carvão, figura, museus e cadernos organizados como uma biblioteca de streaming: escolha uma trilha, atravesse referências e volte para o papel.</p>
    <div class="actions"><a class="btn primary" href={base+'percursos'}>Começar um percurso</a><a class="btn gold" href={base+'bancos'}>Abrir bancos de imagens</a><a class="btn" href={base+'historia-da-arte'}>História da arte</a><button class="btn surprise-btn" id="surprise-door" type="button">✦ Surpreenda-me</button></div>
  </div>
</section>

<div class="browse-quick">
  <a href={base+'busca'}>Buscar</a>
  <a href={base+'referencias'}>Referências</a><a href={base+'cadernos'}>Cadernos</a><a href={base+'temporadas'}>Temporadas</a><a href={base+'biblioteca'}>Biblioteca</a><a href={base+'museus'}>Museus</a><a href={base+'atelier'}>Ateliê</a><a href={base+'composicoes-autorais'}>Autorais</a>
</div>

<section class="stream-section" id="continue-section" hidden>
  <div class="stream-head"><div><span class="eyebrow">CONTINUAR ESTUDANDO</span><h2>Volte de onde parou.</h2></div><p>Fica salvo apenas neste aparelho.</p></div>
  <div class="browse-rail" id="continue-rail"></div>
</section>

<section class="stream-section" id="shelf-section" hidden>
  <div class="stream-head"><div><span class="eyebrow">MINHA ESTANTE</span><h2>O que você guardou.</h2></div><p>Favoritos ficam somente neste navegador.</p></div>
  <div class="browse-rail" id="shelf-rail"></div>
</section>

<section class="stream-section">
  <div class="stream-head"><div><span class="eyebrow">SESSÕES CURTAS</span><h2>Escolha pelo tempo que você tem.</h2></div><p>Uma sessão não tenta ensinar tudo. Ela entrega uma pergunta, uma porta e um retorno para o papel.</p></div>
  <div class="feature-rail">{studySessions.map((s,i)=><a class="feature-card session-card" href={s.href}>
    <span class="tag">{s.time} · SESSÃO {String(i+1).padStart(2,'0')}</span><h3>{s.title}</h3><p>{s.text}</p><div class="session-play">▶ começar</div>
  </a>)}</div>
</section>

<section class="stream-section">
  <div class="stream-head"><div><span class="eyebrow">EM FOCO</span><h2>Leques de estudo.</h2></div><p>Comece por uma pergunta visual e atravesse vários acervos sem copiar bibliotecas para dentro do site.</p></div>
  <div class="feature-rail">{studyFans.map((fan,i)=><article class="feature-card">
    <span class="tag">LEQUE {String(i+1).padStart(2,'0')}</span><h3>{fan.title}</h3><p>{fan.thought}</p><div class="actions"><a class="btn" href={base+'bancos#leques'}>Abrir portas →</a></div>
  </article>)}</div>
</section>

<section class="stream-section">
  <div class="stream-head"><div><span class="eyebrow">JARDIM DE REFERÊNCIAS</span><h2>Presenças para observar.</h2></div><p>Carvão, gesto, processo, figura, memória visual e sketchbook.</p></div>
  <div class="stream-rail">{startRefs.map(a=><a class="stream-card" href={base+'referencias/'+a!.slug}><div class="stream-card-media"><img class="stream-fallback" src={base+'noir/reference-fallback.svg'} alt=""/>{a!.videoId&&a!.slug!=="zin-lim"&&<img class="stream-thumb" src={'https://i.ytimg.com/vi/'+a!.videoId+'/hqdefault.jpg'} alt={'Referência visual de '+a!.name} loading="lazy" onerror="this.remove()"/>}<span class="stream-rank">{String(a!.rank).padStart(2,'0')}</span></div><div class="stream-card-body"><span>{a!.focus}</span><h3>{a!.name}</h3></div></a>)}</div>
  <div class="actions"><a class="btn" href={base+'referencias'}>Ver atlas completo →</a></div>
</section>

<section class="stream-section">
  <div class="stream-head"><div><span class="eyebrow">CADERNOS</span><h2>Escolha uma prática.</h2></div><p>Cada caderno começa por uma pergunta e termina devolvendo alguma coisa para a mão.</p></div>
  <div class="browse-rail">{cadernos.map((c,i)=><a class="browse-tile" href={base+'cadernos#'+c.slug}>
    <div class="browse-visual"><img src={base+'noir/'+c.image} alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.48"/><span class="num">{String(i+1).padStart(2,'0')}</span><div class="big">{c.title}</div></div>
    <div class="browse-body"><span>{c.kicker}</span><h3>{c.question}</h3></div>
  </a>)}</div>
</section>

<section class="stream-section">
  <div class="stream-head"><div><span class="eyebrow">HISTÓRIA DA ARTE</span><h2>Viaje por períodos.</h2></div><p>Portas para problemas diferentes de corpo, espaço, luz, padrão e narrativa.</p></div>
  <div class="browse-rail">{periods.map((p,i)=><a class="browse-tile" href={base+'historia-da-arte#'+p!.id}>
    <div class="browse-visual"><span class="num">{String(i+1).padStart(2,'0')}</span><div class="big">{p!.title}</div></div>
    <div class="browse-body"><span>{p!.dates}</span><h3>{p!.diagramLabel}</h3><p>{p!.region}</p></div>
  </a>)}</div>
  <div class="actions"><a class="btn gold" href={base+'historia-da-arte'}>Abrir Atlas Histórico →</a></div>
</section>

<section class="stream-section">
  <div class="stream-head"><div><span class="eyebrow">BANCOS DE IMAGENS</span><h2>Portas para os acervos.</h2></div><p>O site guarda a rota e a pergunta; o museu continua sendo a fonte original.</p></div>
  <div class="browse-rail">{banks.map((b,i)=><a class="browse-tile" href={base+'bancos/'+b!.id+'/'}>
    <div class="browse-visual"><span class="num">{String(i+1).padStart(2,'0')}</span><div class="big">{b!.name}</div></div>
    <div class="browse-body"><span>{b!.kind} · {b!.place}</span><h3>{b!.access}</h3><p>{b!.strengths.slice(0,3).join(' · ')}</p></div>
  </a>)}</div>
  <div class="actions"><a class="btn" href={base+'bancos'}>Ver todos os bancos →</a><a class="btn" href={base+'museus'}>Busca federada →</a></div>
</section>

<section class="stream-section">
  <div class="stream-head"><div><span class="eyebrow">TEMPORADAS</span><h2>Sete universos.</h2></div><p>Corpo, expressão, anatomia, personagem, relação, matéria e síntese.</p></div>
  <div class="browse-rail">{temporadas.map(t=><a class="browse-tile" href={base+'temporadas#t'+t.n}>
    <div class="browse-visual"><span class="num">{t.n}</span><div class="big">{t.title}</div></div>
    <div class="browse-body"><span>TEMPORADA {t.n}</span><p>{t.text}</p></div>
  </a>)}</div>
</section>

<section class="section">
  <div class="section-head"><div><div class="eyebrow">QUATRO MOVIMENTOS</div><h2>Aprender a olhar.</h2></div><p>O algoritmo aqui é humano: observar, estruturar, organizar e traduzir.</p></div>
  <div class="paper-grid">{fundamentos.map(f=><article class="paper-card"><div class="num">{f.n}</div><h3>{f.title}</h3><p>{f.text}</p></article>)}</div>
</section>

<section class="section editorial-split">
  <div class="panel"><div class="eyebrow">ATELIÊ ABERTO</div><h2>Menos catálogo. Mais percurso.</h2><p>O ambiente pode crescer como uma plataforma de streaming sem perder o que importa: cada sessão de navegação precisa devolver uma observação, uma pergunta ou um exercício para o desenho.</p><div class="actions"><a class="btn gold" href={base+'atelier'}>Entrar no ateliê</a></div></div>
  <div class="panel"><div class="quote">Veja.<br/>Escolha.<br/>Estude.<br/>Volte à mão.</div></div>
</section>
</main><Footer/>
<script define:vars={{base}}>
const esc=(s)=>String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
const readSaved=(key)=>{try{const value=JSON.parse(localStorage.getItem(key)||'[]');return Array.isArray(value)?value:[]}catch{return[]}};
const isLocalPath=(path)=>{try{if(typeof path!=='string')return false;const url=new URL(path,location.origin);return url.origin===location.origin&&url.pathname.startsWith(base)}catch{return false}};
try{
  const xs=readSaved('harum_noir_recent');
  const root=document.querySelector('#continue-rail');
  const section=document.querySelector('#continue-section');
  const items=Array.isArray(xs)?xs.filter(x=>x&&isLocalPath(x.path)&&x.path!==location.pathname).slice(0,8):[];
  if(root&&section&&items.length){
    const ago=(ts)=>{const d=Math.max(0,Date.now()-Number(ts||0));const m=Math.floor(d/60000);if(m<2)return'agora';if(m<60)return'há '+m+' min';const h=Math.floor(m/60);if(h<24)return'há '+h+' h';const days=Math.floor(h/24);return days===1?'ontem':'há '+days+' dias'};
    root.innerHTML=items.map((x,i)=>'<a class="continue-card" href="'+esc(x.path)+'"><div class="continue-visual"><span>'+String(i+1).padStart(2,'0')+'</span><b>HARUM NOIR</b></div><div class="continue-body"><span>VISITADO '+esc(ago(x.visitedAt))+'</span><h3>'+esc(String(x.title||'HARUM NOIR').replace(/ · Harum Noir.*/i,''))+'</h3></div></a>').join('');
    section.hidden=false;
  }
  const saved=readSaved('harum_noir_shelf');
  const shelf=document.querySelector('#shelf-rail');
  const shelfSection=document.querySelector('#shelf-section');
  const shelfItems=Array.isArray(saved)?saved.filter(x=>x&&isLocalPath(x.path)).slice(0,12):[];
  if(shelf&&shelfSection&&shelfItems.length){
    shelf.innerHTML=shelfItems.map((x,i)=>'<a class="browse-tile" href="'+esc(x.path)+'"><div class="browse-visual"><span class="num">'+String(i+1).padStart(2,'0')+'</span><div class="big">'+esc(String(x.title||'HARUM NOIR').replace(/ · Harum Noir.*/i,''))+'</div></div><div class="browse-body"><span>SALVO</span><h3>Voltar para este estudo →</h3></div></a>').join('');
    shelfSection.hidden=false;
  }
}catch{}
const surprise=document.querySelector('#surprise-door');
if(surprise){
  const doors=[
    base+'cadernos#gesto',
    base+'historia-da-arte#barroco',
    base+'historia-da-arte#ukiyoe',
    base+'bancos/bndigital/',
    base+'bancos/met/',
    base+'percursos#figura',
    base+'percursos#mundo',
    base+'busca?q='+encodeURIComponent('charcoal drawing'),
    base+'busca?q='+encodeURIComponent('hands gesture'),
    base+'referencias'
  ];
  surprise.addEventListener('click',()=>{location.href=doors[Math.floor(Math.random()*doors.length)]});
}
</script>
</body></html>