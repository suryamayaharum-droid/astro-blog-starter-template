---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/browse.css';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const lessons = [
  {n:'01', title:'Observar', question:'O que faz o olhar parar?', text:'Aprenda a escolher uma imagem, perceber sua estrutura e formular uma pergunta visual.', image:'museum-gallery', href:'museus/', alt:'Sala de museu usada como ponto de partida para observar obras e imagens.'},
  {n:'02', title:'Estruturar', question:'O que sustenta o gesto?', text:'Leia direção, peso e relação entre as partes antes de separar os detalhes.', image:'harum-noir-hands-study', href:'maos/', alt:'Quatro estudos editoriais de gestos de mãos desenhados a carvão.'},
  {n:'03', title:'Organizar', question:'O que merece permanecer?', text:'Use o caderno para comparar, editar e guardar descobertas que possam voltar ao desenho.', image:'open-sketchbook', href:'sketchbooks/', alt:'Caderno aberto preparado para organizar estudos e observações.'},
  {n:'04', title:'Traduzir', question:'Como a observação vira desenho?', text:'Escolha uma matéria, teste uma decisão e termine com algo feito pela sua mão.', image:'harum-noir-caderno-estudo', href:'percursos/#carvao', alt:'Estudo editorial com carvão: modelo articulado, mão em ação, tecido e caderno.'}
];
---
<!doctype html>
<html lang="pt-BR">
<head><BaseHead title="HARUM NOIR — Escola Aberta de Desenho" description="Uma escola aberta para aprender a observar, estruturar, organizar referências e desenhar com intenção." /></head>
<body>
<Header/>
<main class="school-home">
  <section class="home-hero">
    <div class="home-hero-copy">
      <span class="home-kicker">HARUM NOIR · ESCOLA ABERTA DE DESENHO</span>
      <h1>Aprenda a ver.<br/><em>Desenhe o que importa.</em></h1>
      <p>Um lugar para estudar desenho com calma: observe uma imagem, descubra sua estrutura e leve uma pergunta de volta ao papel.</p>
      <div class="home-actions">
        <a class="home-button home-button-primary" href={base+'escola/#primeira-pratica'}>Começar pela primeira aula <span aria-hidden="true">↗</span></a>
        <a class="home-button" href={base+'percursos/'}>Escolher um percurso</a>
      </div>
      <p class="home-note">Primeira prática gratuita · 12 minutos · papel e lápis · sem conta · progresso salvo só neste aparelho</p>
    </div>
    <figure class="home-hero-art">
      <img src={base+'noir/visual-atlas/harum-noir-escola-hero.webp'} alt="Natureza-morta editorial para estudo: caderno, lápis e tecido iluminados sobre uma mesa." width="1200" height="485" fetchpriority="high"/>
      <figcaption>Cenário editorial criado com assistência de IA</figcaption>
    </figure>
  </section>
  <section class="home-lessons" aria-labelledby="home-lessons-title">
    <div class="home-section-head">
      <div><span class="home-kicker">QUATRO MOVIMENTOS</span><h2 id="home-lessons-title">Da primeira olhada ao desenho.</h2></div>
      <a href={base+'escola/'}>Ver o plano de estudo <span aria-hidden="true">→</span></a>
    </div>
    <div class="home-lesson-grid">
      {lessons.map(lesson=><a class="home-lesson" href={base+lesson.href}>
        <div class="home-lesson-art"><img src={base+'noir/visual-atlas/'+lesson.image+'.webp'} alt={lesson.alt} width="900" height="600" loading="lazy"/><span>{lesson.n}</span></div>
        <div class="home-lesson-copy"><span>{lesson.title}</span><h3>{lesson.question}</h3><p>{lesson.text}</p><b>Entrar nesta etapa <span aria-hidden="true">↗</span></b></div>
      </a>)}
    </div>
  </section>
  <nav class="home-body-path" aria-label="Trilha de linguagem corporal">
    <span class="home-body-path-label">LINGUAGEM CORPORAL</span>
    <a href={base+'maos/'} data-astro-prefetch><small>01</small><b>Mãos</b><span>ação & contato</span></a>
    <i aria-hidden="true">→</i>
    <a href={base+'corpo-em-relacao/'} data-astro-prefetch><small>02</small><b>Corpo</b><span>peso & relação</span></a>
    <i aria-hidden="true">→</i>
    <a href={base+'cabeca-expressao/'} data-astro-prefetch><small>03</small><b>Cabeça</b><span>direção & expressão</span></a>
  </nav>
  <section class="home-choose" aria-labelledby="home-choose-title">
    <div><span class="home-kicker">COMECE PELO QUE LHE CHAMA</span><h2 id="home-choose-title">Uma porta basta.</h2></div>
    <div class="home-choose-links">
      <a href={base+'escola/#fundamentos'}><span>01</span><b>Estou começando</b><small>Quero um plano simples para estudar</small><i aria-hidden="true">↗</i></a>
      <a href={base+'percursos/#figura'}><span>02</span><b>Figura e gesto</b><small>Quero entender corpo, ação e peso</small><i aria-hidden="true">↗</i></a>
      <a href={base+'percursos/#carvao'}><span>03</span><b>Carvão e matéria</b><small>Quero explorar luz, borda e textura</small><i aria-hidden="true">↗</i></a>
    </div>
  </section>
</main>
<Footer/>
<style>
.school-home{max-width:1500px;margin:0 auto;padding:0 clamp(18px,5vw,76px) 96px}.home-hero{display:grid;grid-template-columns:1.02fr .98fr;align-items:center;gap:clamp(24px,5vw,72px);min-height:590px;padding:42px 0 48px;border-bottom:1px solid var(--line)}.home-hero-copy{max-width:660px}.home-kicker{color:var(--gold);font-size:.68rem;font-weight:700;letter-spacing:.16em;text-transform:uppercase}.home-hero h1{font-size:clamp(3.5rem,7vw,6.8rem);line-height:.91;letter-spacing:-.055em;margin:24px 0}.home-hero h1 em{font-family:Georgia,serif;font-weight:400;color:var(--gold);letter-spacing:-.04em}.home-hero-copy>p{max-width:54ch;color:var(--paper-2);font-size:1.06rem;line-height:1.7}.home-actions{display:flex;flex-wrap:wrap;gap:10px;margin:28px 0 16px}.home-button{display:inline-flex;align-items:center;gap:12px;padding:13px 17px;border:1px solid var(--line);border-radius:4px;text-decoration:none;color:var(--paper);font-size:.85rem}.home-button-primary{background:var(--gold);border-color:var(--gold);color:#111}.home-note{font-size:.74rem!important;color:var(--muted)!important}.home-hero-art{position:relative;margin:0;min-width:0}.home-hero-art img{display:block;width:100%;aspect-ratio:1.48;object-fit:cover;border-radius:3px;filter:saturate(.72)}.home-hero-art figcaption{margin-top:9px;color:var(--muted);font-size:.68rem;text-align:right}.home-lessons,.home-choose{padding:66px 0 0}.home-body-path{display:grid;grid-template-columns:auto 1fr auto 1fr auto 1fr;align-items:center;gap:14px;margin-top:50px;padding:14px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.home-body-path-label{color:var(--gold);font-size:.62rem;font-weight:700;letter-spacing:.14em}.home-body-path>a{display:grid;grid-template-columns:auto auto 1fr;align-items:baseline;gap:8px;text-decoration:none;padding:8px 4px}.home-body-path small{color:var(--gold);font-size:.6rem}.home-body-path b{font-family:"Cormorant Garamond",Georgia,serif;font-size:1.2rem;font-weight:400}.home-body-path a>span{color:var(--muted);font-size:.68rem}.home-body-path>i{color:var(--gold);font-style:normal;opacity:.6}.home-section-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:22px}.home-section-head h2,.home-choose h2{font-size:clamp(2.1rem,4.7vw,4.2rem);line-height:.98;letter-spacing:-.04em;margin:10px 0 0}.home-section-head>a{color:var(--gold);text-decoration:none;white-space:nowrap}.home-lesson-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}.home-lesson{min-width:0;overflow:hidden;text-decoration:none;color:inherit;border:1px solid var(--line);border-radius:8px;background:#101011;transition:transform .2s,border-color .2s}.home-lesson:hover{transform:translateY(-3px);border-color:var(--gold-dim)}.home-lesson-art{position:relative;aspect-ratio:1.25;overflow:hidden;background:#171717}.home-lesson-art img{width:100%;height:100%;object-fit:cover;filter:saturate(.55);transition:transform .25s}.home-lesson:hover img{transform:scale(1.035)}.home-lesson-art>span{position:absolute;left:12px;top:12px;padding:5px 8px;border:1px solid rgba(255,255,255,.3);border-radius:999px;background:#090909aa;color:var(--paper);font-size:.67rem}.home-lesson-copy{padding:17px}.home-lesson-copy>span{color:var(--gold);font-size:.68rem;letter-spacing:.13em;text-transform:uppercase}.home-lesson h3{font-size:1.3rem;line-height:1.1;margin:10px 0}.home-lesson p{min-height:4.8em;color:var(--paper-2);font-size:.82rem;line-height:1.55;margin:0 0 18px}.home-lesson b{display:flex;justify-content:space-between;padding-top:12px;border-top:1px solid var(--line);font-size:.72rem;color:var(--gold)}.home-choose{display:grid;grid-template-columns:.65fr 1.35fr;gap:30px}.home-choose-links{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px}.home-choose-links a{position:relative;min-height:120px;padding:15px;border-top:1px solid var(--line);text-decoration:none;color:inherit}.home-choose-links a>span{color:var(--gold);font-size:.65rem}.home-choose-links b,.home-choose-links small{display:block}.home-choose-links b{margin:16px 0 5px;font-size:.9rem}.home-choose-links small{max-width:24ch;color:var(--muted);font-size:.72rem;line-height:1.45}.home-choose-links i{position:absolute;right:14px;top:12px;color:var(--gold);font-style:normal}
@media(max-width:1000px){.home-lesson-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.home-choose{grid-template-columns:1fr;gap:16px}}
@media(max-width:700px){.home-body-path{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;gap:7px;padding:10px 0}.home-body-path-label{flex:0 0 110px}.home-body-path>a{flex:0 0 180px;scroll-snap-align:start}.home-body-path>i{flex:0 0 auto}.school-home{padding-bottom:72px}.home-hero{grid-template-columns:1fr;gap:17px;min-height:0;padding:20px 0 30px}.home-hero-art{order:-1}.home-hero-art img{aspect-ratio:1.55}.home-hero h1{font-size:clamp(3.3rem,14vw,5.1rem);margin:17px 0}.home-hero-copy>p{font-size:.95rem}.home-actions{display:grid;grid-template-columns:1fr}.home-button{justify-content:space-between}.home-section-head{align-items:start;flex-direction:column}.home-section-head h2,.home-choose h2{font-size:2.6rem}.home-lesson-grid{grid-template-columns:1fr 1fr;gap:9px}.home-lesson-copy{padding:12px}.home-lesson h3{font-size:1.08rem}.home-lesson p{min-height:0;font-size:.74rem}.home-choose-links{grid-template-columns:1fr}.home-choose-links a{min-height:0;padding:14px 4px}.home-choose-links b{margin-top:9px}}
@media(prefers-reduced-motion:reduce){.home-lesson,.home-lesson-art img{transition:none}.home-lesson:hover{transform:none}.home-lesson:hover img{transform:none}}
</style>
</body>
</html>