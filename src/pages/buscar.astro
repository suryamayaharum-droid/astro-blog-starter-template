---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import EcosystemRail from '../components/EcosystemRail.astro';
import { ecosystemHubs } from '../data/ecosystem';
import { openLibraryCollections } from '../data/openLibrary';
import { referenceArtists } from '../data/references';
import { artHistoryPeriods } from '../data/artHistory';
import { cadernos, temporadas } from '../data/public';
import { radarHarumverso, radarSlug } from '../data/radarHarumverso';

const base=import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';

const items=[
  {type:"Percurso",title:"Ritual do Carvão · 7 dias",subtitle:"Percurso em preparação com amostra gratuita de 10 minutos para gesto, matéria, massa, borda e composição.",href:"ritual-do-carvao/",terms:"carvão sete dias gesto matéria massa valor borda composição percurso prática amostra gratuita 10 minutos dia zero"},
  {type:"Acesso",title:"Área de alunos · Hotmart",subtitle:"Entrada para quem já possui um produto HARUM NOIR liberado na Hotmart.",href:"alunos/",terms:"alunos hotmart acesso compra material curso produto"},
  ...radarHarumverso.map(x=>({type:"Radar",title:x.title,subtitle:x.creator+" · "+x.source,href:"radar#radar-"+radarSlug(x),terms:[x.kind,x.note,x.principle,x.destination,x.rights].join(" ")})),
  ...ecosystemHubs.map(x=>({
    type:"Rota",
    title:x.title,
    subtitle:x.description,
    href:x.href,
    terms:[x.kicker,x.description].join(" ")
  })),
  ...openLibraryCollections.map(x=>({
    type:"Biblioteca",
    title:x.title,
    subtitle:x.destination,
    href:`biblioteca#${x.id}`,
    terms:[x.theme,x.kicker,x.thesis,x.rule,x.practice].join(" ")
  })),
  ...referenceArtists.map(x=>({
    type:"Referência",
    title:x.name,
    subtitle:x.focus,
    href:`referencias/${x.slug}`,
    terms:[x.archetype,x.focus,x.special,x.lane].join(" ")
  })),
  ...artHistoryPeriods.map(x=>({
    type:"História da Arte",
    title:x.title,
    subtitle:`${x.dates} · ${x.region}`,
    href:`historia-da-arte#${x.id}`,
    terms:[x.thesis,x.thought,x.curiosity,x.construction.join(" "),x.artists.map(a=>a.name+" "+a.focus).join(" ")].join(" ")
  })),
  ...cadernos.map(x=>({
    type:"Caderno",
    title:`Caderno · ${x.title}`,
    subtitle:x.summary,
    href:`cadernos/${x.slug}`,
    terms:[x.question,x.practice,x.residue].join(" ")
  })),
  ...temporadas.map(x=>({
    type:"Temporada",
    title:`Temporada ${x.n} · ${x.title}`,
    subtitle:x.text,
    href:`temporadas#t${x.n}`,
    terms:x.text
  }))
];
const catalog=JSON.stringify(items);
---
<!doctype html>
<html lang="pt-BR">
<head><BaseHead title="Buscar · Harum Noir" description="Busca transversal no HARUM NOIR: escola, rotas, referências, Biblioteca, História da Arte, Cadernos e Temporadas."/></head>
<body class="has-page-wallpaper" style={"--page-wallpaper: url('" + base + "noir/visual-atlas/bndigital-study-atlas.webp')"}>
<Header/>
<main class="stream-main">
  <section class="page-hero">
    <div class="eyebrow">BUSCA TRANSVERSAL</div>
    <h1>Uma pergunta, várias portas.</h1>
    <p>Pesquise um artista, técnica, material, período, problema de desenho ou palavra que ficou na memória. A busca atravessa o HARUM NOIR sem depender de servidor externo.</p>
  </section>

  <section class="stream-search-shell">
    <input id="global-search" class="stream-search" type="search" placeholder="Ex.: carvão, gesto, mãos, memória, Degas…" aria-label="Buscar no HARUM NOIR" autocomplete="off"/>
    <div class="search-prompts" role="group" aria-label="Perguntas de entrada">
      <span>PERGUNTAS DE ENTRADA</span>
      <button type="button" data-search-prompt="gesto">Onde está a ação?</button>
      <button type="button" data-search-prompt="peso">O que sustenta o corpo?</button>
      <button type="button" data-search-prompt="carvão">Como a matéria constrói forma?</button>
      <button type="button" data-search-prompt="sketchbook">Como um caderno pensa?</button>
      <button type="button" data-search-prompt="mãos">Como a mão mostra intenção?</button>
      <button type="button" data-search-prompt="open access">Quero uma fonte aberta</button>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <div><div class="eyebrow">RESULTADOS</div><h2 id="search-title">Portas para começar.</h2></div>
      <p id="search-count"></p>
    </div>
    <div id="search-results" class="archive-grid"></div>
    <div id="search-empty" class="panel" hidden>
      <div class="eyebrow">NENHUMA CORRESPONDÊNCIA</div>
      <h2>Tente uma pergunta menor.</h2>
      <p>Busque por material, gesto, parte do corpo, artista, período ou princípio. Você também pode abrir o Atlas para navegar sem palavra-chave.</p>
      <div class="actions"><a class="btn gold" href={base+'atlas'}>Abrir Atlas →</a></div>
    </div>
  </section>

  <EcosystemRail current="buscar" limit={6} />

  <script is:inline define:vars={{catalog,base}}>
  (()=>{
    const data=JSON.parse(catalog);
    const input=document.querySelector('#global-search');
    const grid=document.querySelector('#search-results');
    const empty=document.querySelector('#search-empty');
    const count=document.querySelector('#search-count');
    const title=document.querySelector('#search-title');
    const norm=(v)=>String(v||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().trim();
    const esc=(v)=>String(v||'').replace(/[&<>"']/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
    const card=(item)=>'<a class="archive-item" href="'+base+esc(item.href)+'"><span class="card-kicker">'+esc(item.type)+'</span><h3>'+esc(item.title)+'</h3><p>'+esc(item.subtitle)+'</p></a>';

    const apply=()=>{
      const q=norm(input?.value);
      const found=q
        ? data.filter(item=>norm([item.title,item.subtitle,item.type,item.terms].join(' ')).includes(q))
        : data.slice(0,24);
      grid.innerHTML=found.map(card).join('');
      empty.hidden=found.length!==0;
      count.textContent=found.length+' resultado'+(found.length===1?'':'s');
      title.textContent=q ? 'Encontrado no HARUM NOIR.' : 'Portas para começar.';
      const url=new URL(location.href);
      if(q) url.searchParams.set('q',input.value.trim()); else url.searchParams.delete('q');
      history.replaceState(null,'',url);
    };

    const initial=new URLSearchParams(location.search).get('q')||'';
    if(input) input.value=initial;
    input?.addEventListener('input',apply);
    document.querySelectorAll('[data-search-prompt]').forEach(button=>button.addEventListener('click',()=>{
      if(!input) return;
      input.value=button.dataset.searchPrompt||'';
      input.focus();
      apply();
    }));
    apply();
  })();
  </script>
</main>
<Footer/>
<style>
.search-prompts{display:flex;gap:7px;align-items:center;overflow-x:auto;padding:10px 0 2px;scrollbar-width:none}.search-prompts::-webkit-scrollbar{display:none}.search-prompts>span{flex:0 0 auto;color:var(--gold);font-size:.62rem;letter-spacing:.13em}.search-prompts button{flex:0 0 auto;display:inline-flex;align-items:center;min-height:44px;border:1px solid var(--line);border-radius:999px;background:#151517;color:var(--paper-2);padding:7px 12px;font-size:.72rem;cursor:pointer}.search-prompts button:hover,.search-prompts button:focus-visible{border-color:var(--gold);color:var(--paper)}
</style>
</body>
</html>
