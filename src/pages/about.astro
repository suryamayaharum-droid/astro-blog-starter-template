---
import LegacyRedirect from '../components/LegacyRedirect.astro';
const base=import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const target=`${base}sobre/`;
---
<LegacyRedirect target={target} title="Sobre o HARUM NOIR" summary="Conheça a proposta editorial, a linguagem visual e o caminho entre pesquisa, prática e arquivo." cta="Abrir a página Sobre" />
