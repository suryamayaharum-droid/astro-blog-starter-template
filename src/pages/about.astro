---
const base=import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const target=`${base}sobre`;
const canonical=new URL(target,Astro.site).href;
---
<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"/><meta name="robots" content="noindex,follow"/><meta http-equiv="refresh" content={`0;url=${target}`}/><link rel="canonical" href={canonical}/><title>Harum Noir</title></head><body><a href={target}>Continuar</a></body></html>
