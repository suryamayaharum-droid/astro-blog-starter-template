---
import { researchHighlights } from '../data/researchHighlights';
const base=import.meta.env.BASE_URL.endsWith('/')?import.meta.env.BASE_URL:import.meta.env.BASE_URL+'/';
const featured=researchHighlights.filter(x=>x.featured);
const archive=researchHighlights.filter(x=>!x.featured);
---
<section class="research-highlights section" id="radar-aplicado" aria-labelledby="radar-aplicado-title">
  <div class="research-head">
    <div><span class="eyebrow">RADAR APLICADO · FONTES VERIFICADAS</span><h2 id="radar-aplicado-title">Pesquisa que já virou site.</h2></div>
    <p>Fontes institucionais entram com uma pergunta de desenho, um princípio Harum Noir e um destino claro. Abra a fonte original; use a capa apenas como porta editorial.</p>
  </div>
  <div class="feature-rail" aria-label="Destaques recentes">
    {featured.map(item=><a class="feature-card" href={item.url} target="_blank" rel="noreferrer">
      <img src={base+'noir/visual-atlas/'+item.cover} alt={`Capa editorial HARUM NOIR para ${item.title}`} width="640" height="360" loading="lazy" decoding="async"/>
      <div class="feature-copy"><span>{item.source}</span><h3>{item.title}</h3><p>{item.observe}</p><small>{item.rights}</small><b>Fonte original ↗</b></div>
    </a>)}
  </div>
  <p class="cover-disclosure">As quatro capas acima são composições editoriais HARUM NOIR criadas com assistência de IA. Não reproduzem as obras, páginas ou frames das instituições vinculadas.</p>
  <div class="research-subhead"><span class="eyebrow">ACERVO RECÉM-INTEGRADO</span><h3>Figura, corpo em relação, sketchbook e matéria.</h3></div>
  <div class="research-rail" aria-label="Descobertas integradas">
    {archive.map(item=><a class="research-card" href={item.url} target="_blank" rel="noreferrer">
      <div class="research-media"><img src={base+'noir/visual-atlas/'+item.cover} alt="" width="480" height="300" loading="lazy" decoding="async"/><span>{item.source}</span></div>
      <div class="research-body"><small>{item.creator}</small><h4>{item.title}</h4><p>{item.observe}</p><dl><dt>Princípio</dt><dd>{item.principle}</dd><dt>Destino</dt><dd>{item.destination}</dd><dt>Direitos</dt><dd>{item.rights}</dd></dl></div>
    </a>)}
  </div>
</section>
<style>
.research-highlights{overflow:hidden}.research-head{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(260px,.9fr);gap:30px;align-items:end;margin-bottom:24px}.research-head h2{font-size:clamp(2.3rem,5vw,4.9rem);line-height:.95;margin:10px 0 0}.research-head p{max-width:56ch;color:var(--paper-2);justify-self:end}.feature-rail,.research-rail{display:flex;gap:14px;overflow-x:auto;scroll-snap-type:x mandatory;overscroll-behavior-inline:contain;padding:2px 2px 18px}.feature-card{flex:0 0 min(620px,78vw);scroll-snap-align:start;display:grid;grid-template-columns:1.2fr .8fr;overflow:hidden;border:1px solid var(--line);border-radius:16px;background:#101011;color:inherit;text-decoration:none}.feature-card>img{width:100%;height:100%;min-height:330px;object-fit:cover}.feature-copy{padding:22px;display:flex;flex-direction:column}.feature-copy>span,.research-body>small{color:var(--gold);font-size:.65rem;letter-spacing:.1em;text-transform:uppercase}.feature-copy h3{font-size:1.45rem;line-height:1.08;margin:13px 0}.feature-copy p{font-size:.84rem;color:var(--paper-2);line-height:1.6;flex:1}.feature-copy small{font-size:.67rem;color:var(--muted)}.feature-copy b{margin-top:18px;color:var(--gold);font-size:.75rem}.cover-disclosure{font-size:.7rem;color:var(--muted);max-width:90ch;margin:0 0 46px}.research-subhead{margin-bottom:18px}.research-subhead h3{font-size:clamp(1.7rem,3vw,2.7rem);margin:7px 0}.research-card{flex:0 0 min(390px,82vw);scroll-snap-align:start;overflow:hidden;border:1px solid var(--line);border-radius:14px;background:#111214;text-decoration:none;color:inherit}.research-media{height:190px;position:relative;overflow:hidden}.research-media img{width:100%;height:100%;object-fit:cover;filter:saturate(.5)}.research-media span{position:absolute;left:10px;bottom:10px;background:#090909c9;border:1px solid var(--line);border-radius:999px;padding:5px 8px;font-size:.6rem;color:var(--paper-2)}.research-body{padding:18px}.research-body h4{font-size:1.2rem;line-height:1.1;margin:10px 0}.research-body p{font-size:.82rem;color:var(--paper-2);line-height:1.55}.research-body dl{display:grid;grid-template-columns:70px 1fr;gap:6px 10px;border-top:1px solid var(--line);padding-top:13px;margin-top:14px;font-size:.68rem}.research-body dt{color:var(--gold)}.research-body dd{margin:0;color:var(--muted)}
@media(max-width:800px){.research-head{grid-template-columns:1fr}.research-head p{justify-self:start}.feature-card{grid-template-columns:1fr;flex-basis:86vw}.feature-card>img{min-height:0;aspect-ratio:16/9}.feature-copy{padding:18px}.research-card{flex-basis:84vw}}
@media(prefers-reduced-motion:reduce){.feature-rail,.research-rail{scroll-behavior:auto}}
</style>
