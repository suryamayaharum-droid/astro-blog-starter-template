---
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
---

<aside class="lume-host" data-lume data-base={base} aria-label="Lume, guia local do Harum Noir">
  <button class="lume-toggle" type="button" data-lume-toggle aria-controls="lume-panel" aria-expanded="false">
    <span class="lume-sigil" aria-hidden="true">
      <svg viewBox="0 0 48 48" focusable="false">
        <circle class="lume-orbit" cx="24" cy="24" r="19"></circle>
        <path class="lume-lantern" d="M24 8.5c-6.2 4.2-10 9.2-10 15.2 0 7 4.6 12.6 10 16.4 5.4-3.8 10-9.4 10-16.4 0-6-3.8-11-10-15.2Z"></path>
        <path class="lume-ray" d="M18.5 28.2c1.7 2.1 3.6 3.1 5.5 3.1s3.8-1 5.5-3.1"></path>
        <circle class="lume-light" cx="24" cy="21" r="3"></circle>
      </svg>
    </span>
    <span class="lume-toggle-copy"><strong>Lume</strong><small>Guia do ateliê</small></span>
    <span class="lume-toggle-mark" aria-hidden="true">✦</span>
  </button>

  <section class="lume-panel" id="lume-panel" data-lume-panel role="dialog" aria-modal="false" aria-labelledby="lume-title" hidden>
    <header class="lume-panel-head">
      <span class="lume-panel-sigil" aria-hidden="true">✦</span>
      <div>
        <p class="lume-kicker">ANFITRIÃ DO ATELIÊ</p>
        <h2 id="lume-title">Por onde começamos?</h2>
      </div>
      <button class="lume-close" type="button" data-lume-close aria-label="Fechar guia">×</button>
    </header>

    <p class="lume-intro">Sou Lume. Posso indicar caminhos por acervos, referências, cadernos e percursos.</p>
    <p class="lume-privacy"><span aria-hidden="true">●</span> As perguntas são processadas aqui. Só ao ativar, a biblioteca vem do jsDelivr e os pesos da Hugging Face; as perguntas não são enviadas a eles.</p>

    <form class="lume-form" data-lume-form>
      <label for="lume-question">O que você quer explorar?</label>
      <div class="lume-input-row">
        <input id="lume-question" name="question" type="text" maxlength="160" autocomplete="off" placeholder="Ex.: museus, gesto, artistas…" required />
        <button type="submit" aria-label="Enviar pergunta">→</button>
      </div>
    </form>

    <div class="lume-prompts" role="group" aria-label="Sugestões de perguntas">
      <button type="button" data-lume-prompt="Como encontro obras nos museus?">Museus</button>
      <button type="button" data-lume-prompt="Quero estudar gesto e mãos">Gesto & mãos</button>
      <button type="button" data-lume-prompt="Onde vejo artistas de referência?">Referências</button>
    </div>

    <div class="lume-answer">
      <p data-lume-response aria-live="polite">Escolha uma sugestão ou escreva sobre o que procura.</p>
      <nav class="lume-answer-links" data-lume-links aria-label="Caminhos sugeridos"></nav>
    </div>
    <section class="lume-ai" aria-label="Modelo de inteligência artificial local">
      <div class="lume-ai-heading"><strong>IA local opcional</strong><span>Qwen · quantizado</span></div>
      <p class="lume-ai-copy">Com GPU compatível, baixa cerca de 483 MB (4 bits). Sem ela, usa CPU/WASM com cerca de 512 MB (8 bits), em velocidade menor. O modelo só baixa após sua escolha e fica no cache deste navegador; não é uma instalação no Android.</p>
      <button class="lume-ai-enable" type="button" data-lume-ai-enable>Ativar IA local · até 512 MB</button>
      <button class="lume-ai-cancel" type="button" data-lume-ai-cancel hidden>Cancelar carregamento</button>
      <progress class="lume-ai-progress" data-lume-ai-progress max="100" value="0" hidden aria-label="Progresso de carregamento do modelo"></progress>
      <p class="lume-ai-status" data-lume-ai-status role="status">O download começa após sua escolha. Precisa de internet e espaço livre.</p>
      <a class="lume-ai-model-link" href="https://huggingface.co/onnx-community/Qwen2.5-0.5B-Instruct" target="_blank" rel="noopener noreferrer">Ver modelo e arquivos ↗</a>
    </section>
    <p class="lume-note">Modelo experimental: confira os caminhos verificados antes de seguir uma orientação.</p>
  </section>
</aside>

<script>
const root = document.querySelector('[data-lume]');
if (root) {
  const toggle = root.querySelector('[data-lume-toggle]');
  const panel = root.querySelector('[data-lume-panel]');
  const closeButton = root.querySelector('[data-lume-close]');
  const form = root.querySelector('[data-lume-form]');
  const question = root.querySelector('#lume-question');
  const response = root.querySelector('[data-lume-response]');
  const links = root.querySelector('[data-lume-links]');
  const aiEnable = root.querySelector('[data-lume-ai-enable]');
  const aiCancel = root.querySelector('[data-lume-ai-cancel]');
  const aiStatus = root.querySelector('[data-lume-ai-status]');
  const aiProgress = root.querySelector('[data-lume-ai-progress]');
  let aiWorker = null;
  let aiState = 'idle';
  let aiBusy = false;
  let aiDevice = '';
  let requestId = 0;
  let activeRequestId = 0;
  let activeQuestion = '';
  const baseValue = root.dataset.base || '/';
  const base = baseValue.endsWith('/') ? baseValue : baseValue + '/';
  const destinations = Object.freeze({
    museums: { href: base + 'museus/', label: 'Abrir Museus →' },
    gesture: { href: base + 'busca/?q=gesto', label: 'Buscar “gesto” →' },
    notebooks: { href: base + 'cadernos/', label: 'Abrir Cadernos →' },
    references: { href: base + 'referencias/', label: 'Abrir Referências →' },
    journeys: { href: base + 'percursos/', label: 'Abrir Percursos →' },
    search: { href: base + 'busca/', label: 'Abrir Busca →' }
  });

  const answerFor = (raw) => {
    const text = String(raw || '').trim().toLocaleLowerCase('pt-BR').normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    if (!text) return { message: 'Escreva uma palavra ou escolha uma sugestão para eu indicar um caminho.', actions: [] };
    if (/\b(museu|museus|acervo|acervos|obra|obras|colecao|colecoes|met|aic|cleveland)\b/.test(text)) {
      return { message: 'Na página Museus, pesquise por artista, obra ou tema. Abra a ficha do acervo para consultar os dados na instituição de origem.', actions: ['museums'] };
    }
    if (/\b(gesto|mao|maos|figura|exercicio|exercicios|pratica|caderno|cadernos|estudo|estudar)\b/.test(text)) {
      return { message: 'Para estudar gesto e prática, comece pelo Caderno Gesto ou atravesse a busca do site com esse termo.', actions: ['notebooks', 'gesture'] };
    }
    if (/\b(referencia|referencias|artista|artistas|proko|youtube|video|videos|desenho)\b/.test(text)) {
      return { message: 'O Atlas de Referências reúne artistas, materiais de estudo e caminhos para as fontes originais.', actions: ['references'] };
    }
    if (/\b(percurso|percursos|trilha|trilhas|roteiro|comecar|inicio)\b/.test(text)) {
      return { message: 'Os Percursos organizam o estudo em sequências curtas. Escolha uma trilha e siga os links entre páginas.', actions: ['journeys'] };
    }
    if (/\b(busca|buscar|pesquisar|pesquisa|procurar|site|pagina|paginas)\b/.test(text)) {
      return { message: 'A Busca atravessa referências, cadernos, história, bancos, temporadas e percursos.', actions: ['search'] };
    }
    return { message: 'Ainda não reconheço esse tema. Posso levar você aos acervos, ao Atlas de Referências ou aos Percursos.', actions: ['museums', 'references', 'journeys'] };
  };

  const routeKeywords = Object.freeze({
    museums: ['museu', 'acervo'],
    gesture: ['gesto', 'busca'],
    notebooks: ['caderno', 'gesto'],
    references: ['referencia', 'atlas'],
    journeys: ['percurso', 'trilha'],
    search: ['busca', 'pesquisa']
  });

  const answerStaysOnRoute = (raw, actions) => {
    const answer = String(raw || '').toLocaleLowerCase('pt-BR').normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    return actions.some((key) => (routeKeywords[key] || []).some((word) => answer.includes(word)));
  };

  const showAnswer = (raw) => {
    const answer = answerFor(raw);
    response.textContent = answer.message;
    links.replaceChildren();
    answer.actions.forEach((key) => {
      const destination = destinations[key];
      if (!destination) return;
      const link = document.createElement('a');
      link.href = destination.href;
      link.textContent = destination.label;
      links.append(link);
    });
  };

  const setAiStatus = (message) => {
    aiStatus.textContent = message;
  };

  const resetAiWorker = () => {
    if (aiWorker) aiWorker.terminate();
    aiWorker = null;
    aiBusy = false;
    aiDevice = '';
    requestId += 1;
  };

  const handleAiMessage = (event) => {
    const message = event.data || {};
    if (message.type === 'backend') {
      aiDevice = message.device || '';
      const route = aiDevice === 'webgpu' ? 'GPU · 4 bits · ~483 MB' : 'CPU/WASM · 8 bits · ~512 MB';
      setAiStatus(`Motor escolhido: ${route}. Preparando modelo no cache do navegador…`);
      return;
    }

    if (message.type === 'progress') {
      aiProgress.hidden = false;
      const progress = Number(message.progress);
      const engine = aiDevice === 'webgpu' ? 'GPU' : aiDevice === 'wasm' ? 'CPU/WASM' : 'local';
      if (Number.isFinite(progress)) {
        const percent = Math.max(0, Math.min(100, progress <= 1 ? progress * 100 : progress));
        aiProgress.value = percent;
        setAiStatus((message.status === 'runtime' ? 'Carregando o runtime local…' : `Baixando/preparando no motor ${engine}…`) + (percent > 0 ? ' ' + Math.round(percent) + '%.' : ''));
      } else {
        setAiStatus(message.status === 'runtime' ? 'Carregando o runtime local…' : `Baixando e preparando o modelo no motor ${engine}…`);
      }
      return;
    }

    if (message.type === 'unsupported') {
      resetAiWorker();
      aiState = 'failed';
      aiEnable.disabled = false;
      aiEnable.textContent = 'Tentar carregar IA · até 512 MB';
      aiCancel.hidden = true;
      aiProgress.hidden = true;
      setAiStatus(message.reason || 'Este navegador não conseguiu abrir o modelo local. O guia de caminhos continua disponível.');
      return;
    }

    if (message.type === 'ready') {
      aiState = 'ready';
      aiEnable.disabled = true;
      aiEnable.textContent = 'IA local pronta';
      aiCancel.hidden = true;
      aiProgress.hidden = true;
      setAiStatus(`Modelo ${aiDevice === 'webgpu' ? '4 bits na GPU' : '8 bits em CPU/WASM'} pronto e guardado no cache deste navegador. As perguntas são processadas localmente.`);
      return;
    }

    if (message.type === 'answer' && message.id === activeRequestId) {
      aiBusy = false;
      const verified = answerFor(activeQuestion);
      if (!answerStaysOnRoute(message.text, verified.actions)) {
        response.textContent = verified.message;
        setAiStatus('Usei a orientação verificada do site porque a resposta gerada saiu do assunto.');
        return;
      }
      response.textContent = message.text;
      return;
    }

    if (message.type === 'error') {
      if (message.stage === 'answer') {
        if (message.id === activeRequestId) {
          aiBusy = false;
          const localAnswer = answerFor(activeQuestion);
          response.textContent = localAnswer.message + ' A resposta local continua disponível.';
        }
        setAiStatus('A geração local falhou. As sugestões verificadas continuam disponíveis.');
        return;
      }

      aiState = 'failed';
      resetAiWorker();
      aiEnable.disabled = false;
      aiEnable.textContent = 'Tentar carregar IA · até 512 MB';
      aiCancel.hidden = true;
      aiProgress.hidden = true;
      const reason = String(message.reason || '').slice(0, 150);
      setAiStatus((reason ? `Falha ao abrir o modelo: ${reason}. ` : 'Não foi possível abrir o modelo. ') + 'O guia de caminhos continua disponível; você pode tentar novamente.');
    }
  };

  const askWithAi = (raw) => {
    const text = String(raw || '').slice(0, 160);
    showAnswer(text);
    if (aiState !== 'ready' || !aiWorker) return;
    if (aiBusy) {
      response.textContent = 'Ainda estou preparando esta resposta. Aguarde um instante.';
      return;
    }
    aiBusy = true;
    activeQuestion = text;
    activeRequestId = ++requestId;
    response.textContent = 'Lume está preparando uma orientação…';
    aiWorker.postMessage({ type: 'ask', id: activeRequestId, question: text, routeKeys: answerFor(text).actions });
  };

  const startAi = async () => {
    if (aiState === 'loading' || aiState === 'ready') return;
    if (typeof Worker === 'undefined') {
      aiState = 'failed';
      setAiStatus('Este navegador não permite executar o modelo em segundo plano. O guia local continua disponível.');
      return;
    }
    try {
      const estimate = await navigator.storage?.estimate?.();
      const available = Number(estimate?.quota) - Number(estimate?.usage || 0);
      if (Number.isFinite(available) && available > 0 && available < 550 * 1024 * 1024) {
        setAiStatus('O espaço livre informado pelo navegador parece baixo para guardar o modelo. Vou tentar carregar; se falhar, libere espaço e tente de novo.');
      }
    } catch {}
    aiState = 'loading';
    aiEnable.disabled = true;
    aiEnable.textContent = 'Preparando IA local…';
    aiCancel.hidden = false;
    aiProgress.hidden = false;
    aiProgress.value = 0;
    setAiStatus('Verificando GPU e preparando a alternativa CPU/WASM…');
    try {
      aiWorker = new Worker(new URL('../scripts/lume-ai.worker.js', import.meta.url), { type: 'module' });
    } catch (error) {
      aiState = 'failed';
      aiEnable.disabled = false;
      aiEnable.textContent = 'Tentar carregar IA · até 512 MB';
      aiCancel.hidden = true;
      aiProgress.hidden = true;
      setAiStatus(`O runtime local não iniciou: ${String(error?.message || error).slice(0, 140)}. Você pode tentar novamente.`);
      return;
    }
    aiWorker.addEventListener('message', handleAiMessage);
    aiWorker.addEventListener('error', (event) => {
      aiState = 'failed';
      resetAiWorker();
      aiEnable.disabled = false;
      aiEnable.textContent = 'Tentar carregar IA · até 512 MB';
      aiCancel.hidden = true;
      aiProgress.hidden = true;
      setAiStatus('O navegador interrompeu o motor local. Feche outras abas, confira o espaço livre e tente novamente.');
      event.preventDefault();
    });
    aiWorker.postMessage({ type: 'load' });
  };

  const cancelAi = () => {
    resetAiWorker();
    aiState = 'idle';
    aiEnable.disabled = false;
    aiEnable.textContent = 'Ativar IA local · até 512 MB';
    aiCancel.hidden = true;
    aiProgress.hidden = true;
    setAiStatus('Carregamento interrompido. O guia local continua disponível.');
  };

  const setOpen = (open, returnFocus = false) => {
    panel.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    if (open) question.focus();
    else if (returnFocus) toggle.focus();
  };

  toggle.addEventListener('click', () => setOpen(panel.hidden));
  closeButton.addEventListener('click', () => setOpen(false, true));
  form.addEventListener('submit', (event) => {
    event.preventDefault();
    askWithAi(question.value);
  });
  root.querySelectorAll('[data-lume-prompt]').forEach((button) => {
    button.addEventListener('click', () => {
      question.value = button.dataset.lumePrompt || '';
      askWithAi(question.value);
    });
  });
  aiEnable.addEventListener('click', () => { void startAi(); });
  aiCancel.addEventListener('click', cancelAi);
  panel.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setOpen(false, true);
  });
}
</script>

<style>
.lume-host{position:fixed;z-index:110;right:clamp(14px,2.5vw,30px);bottom:22px;max-width:calc(100vw - 24px);color:var(--paper);font-family:inherit}
.lume-toggle{display:flex;align-items:center;gap:10px;min-height:54px;padding:6px 13px 6px 7px;border:1px solid rgba(179,154,105,.55);border-radius:999px;background:rgba(13,14,15,.94);color:var(--paper);box-shadow:0 12px 36px rgba(0,0,0,.42);backdrop-filter:blur(16px);cursor:pointer;text-align:left}
.lume-toggle:hover{border-color:var(--gold);background:#171718}
.lume-sigil{display:grid;place-items:center;width:40px;height:40px;border-radius:50%;background:radial-gradient(circle,rgba(179,154,105,.2),rgba(179,154,105,.035) 68%);flex:0 0 auto}
.lume-sigil svg{width:34px;height:34px;overflow:visible}
.lume-orbit{fill:none;stroke:rgba(179,154,105,.38);stroke-width:1;stroke-dasharray:2 3;transform-origin:24px 24px;animation:lume-orbit 18s linear infinite}
.lume-lantern{fill:rgba(179,154,105,.12);stroke:var(--gold);stroke-width:1.25;stroke-linejoin:round}
.lume-ray{fill:none;stroke:var(--paper-2);stroke-width:1.2;stroke-linecap:round}
.lume-light{fill:var(--gold);filter:drop-shadow(0 0 5px rgba(220,191,126,.85))}
.lume-toggle-copy{display:grid;gap:1px}
.lume-toggle-copy strong{font-size:.78rem;letter-spacing:.12em;text-transform:uppercase}
.lume-toggle-copy small{color:var(--muted);font-size:.66rem}
.lume-toggle-mark{color:var(--gold);font-size:15px;margin-left:3px}
.lume-panel{position:absolute;right:0;bottom:calc(100% + 12px);display:grid;gap:13px;width:min(376px,calc(100vw - 24px));max-height:min(590px,calc(100dvh - 112px));overflow:auto;overscroll-behavior:contain;padding:20px;border:1px solid rgba(179,154,105,.42);border-radius:22px;background:radial-gradient(circle at 95% 0,rgba(179,154,105,.11),transparent 11rem),rgba(15,16,17,.97);box-shadow:0 28px 88px rgba(0,0,0,.62);backdrop-filter:blur(20px)}
.lume-panel-head{display:grid;grid-template-columns:38px minmax(0,1fr) 30px;align-items:center;gap:10px}
.lume-panel-sigil{display:grid;place-items:center;width:36px;height:36px;border:1px solid rgba(179,154,105,.38);border-radius:50%;color:var(--gold);background:rgba(179,154,105,.08)}
.lume-kicker{margin:0;color:var(--gold);font-size:.58rem;font-weight:800;letter-spacing:.18em}
.lume-panel h2{margin:3px 0 0;font:400 1.55rem/1.05 Georgia,serif;letter-spacing:-.025em}
.lume-close{width:30px;height:30px;border:1px solid var(--line);border-radius:50%;background:rgba(255,255,255,.03);color:var(--paper);font-size:20px;line-height:1;cursor:pointer}
.lume-intro{margin:0;color:var(--paper-2);font-size:.82rem;line-height:1.55}
.lume-privacy{margin:-5px 0 0;color:#a9b9a1;font-size:.65rem}
.lume-privacy span{margin-right:5px;font-size:.55rem;color:#9fb28f}
.lume-form{display:grid;gap:7px}
.lume-form label{font-size:.67rem;color:var(--muted)}
.lume-input-row{display:grid;grid-template-columns:minmax(0,1fr) 42px;gap:7px}
.lume-input-row input{min-width:0;height:42px;padding:0 12px;border:1px solid var(--line);border-radius:11px;background:rgba(4,5,6,.62);color:var(--paper);font:inherit;font-size:.76rem}
.lume-input-row input::placeholder{color:#77736d}
.lume-input-row input:focus{border-color:var(--gold);outline:2px solid rgba(179,154,105,.2);outline-offset:1px}
.lume-input-row button{border:1px solid rgba(179,154,105,.55);border-radius:11px;background:var(--gold);color:var(--ink);font-size:21px;cursor:pointer}
.lume-prompts{display:flex;flex-wrap:wrap;gap:6px}
.lume-prompts button{min-height:34px;padding:6px 10px;border:1px solid var(--line);border-radius:999px;background:rgba(255,255,255,.025);color:var(--paper-2);font:inherit;font-size:.65rem;cursor:pointer}
.lume-prompts button:hover{border-color:var(--gold-dim);color:var(--paper)}
.lume-answer{min-height:78px;padding:12px;border-left:2px solid var(--gold-dim);border-radius:0 12px 12px 0;background:rgba(255,255,255,.025)}
.lume-answer p{margin:0;color:var(--paper-2);font-size:.76rem;line-height:1.55}
.lume-answer-links{display:flex;flex-wrap:wrap;gap:8px;margin-top:8px}
.lume-answer-links:empty{display:none}
.lume-answer-links a{color:var(--gold);font-size:.68rem;font-weight:700;text-decoration:none;border-bottom:1px solid rgba(179,154,105,.38)}
.lume-answer-links a:hover{color:var(--paper)}
.lume-ai{display:grid;gap:8px;padding:11px;border:1px solid rgba(179,154,105,.26);border-radius:14px;background:rgba(179,154,105,.035)}
.lume-ai-heading{display:flex;align-items:center;justify-content:space-between;gap:10px}
.lume-ai-heading strong{color:var(--paper-2);font-size:.69rem;letter-spacing:.04em}
.lume-ai-heading span{color:var(--gold);font-size:.59rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase}
.lume-ai-copy,.lume-ai-status{margin:0;color:var(--muted);font-size:.64rem;line-height:1.45}
.lume-ai-enable{min-height:36px;padding:8px 11px;border:1px solid rgba(179,154,105,.5);border-radius:10px;background:rgba(179,154,105,.12);color:var(--paper);font:inherit;font-size:.68rem;font-weight:700;cursor:pointer}
.lume-ai-enable:hover:not(:disabled){border-color:var(--gold);background:rgba(179,154,105,.2)}
.lume-ai-enable:disabled{opacity:.62;cursor:not-allowed}
.lume-ai-cancel{justify-self:start;padding:2px 0;border:0;background:none;color:var(--paper-2);font:inherit;font-size:.64rem;text-decoration:underline;text-underline-offset:3px;cursor:pointer}
.lume-ai-progress{width:100%;height:5px;accent-color:var(--gold)}
.lume-ai-model-link{justify-self:start;color:var(--gold);font-size:.62rem;text-decoration:none;border-bottom:1px solid rgba(179,154,105,.35)}
.lume-ai-model-link:hover{color:var(--paper)}
.lume-note{margin:-5px 0 0;color:#77736d;font-size:.61rem;line-height:1.4}
.lume-host :focus-visible{outline:2px solid var(--gold);outline-offset:3px}
@keyframes lume-orbit{to{transform:rotate(360deg)}}
@media(max-width:760px){
  .lume-host{right:12px;bottom:calc(88px + env(safe-area-inset-bottom))}
  .lume-toggle{min-height:48px;padding:4px 10px 4px 5px;gap:7px}
  .lume-sigil{width:36px;height:36px}
  .lume-sigil svg{width:31px;height:31px}
  .lume-panel{max-height:calc(100dvh - 184px - env(safe-area-inset-bottom));padding:16px;border-radius:18px}
}
@media(max-height:560px){
  .lume-host{bottom:calc(78px + env(safe-area-inset-bottom))}
  .lume-panel{max-height:calc(100dvh - 166px - env(safe-area-inset-bottom));gap:10px;padding:14px}
}
