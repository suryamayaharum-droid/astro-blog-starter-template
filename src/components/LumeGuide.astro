---
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
---

<aside class="lume-host" data-lume data-base={base} aria-label="Lume, guia local do Harum Noir">
  <button class="lume-toggle" type="button" data-lume-toggle aria-controls="lume-panel" aria-expanded="false">
    <span class="lume-sigil" aria-hidden="true">
      <svg viewBox="0 0 48 48" focusable="false">
        <circle class="lume-orbit" cx="24" cy="24" r="19"></circle>
        <path class="lume-lantern" d="M24 8.5c-6.2 4.2-10 9.2-10 15.2 0 7 4.6 12.6 10 16.4 5.4-3.8 10-9.4 10-16.4 0-6-3.8-11-10-15.2Z"></path>
        <path class="lume-ray" d="M18.5 28.2c1.7 2.1 3.6 3.1 5.5 3.1s3.8-1 5.5-3.1"></path>
        <circle class="lume-light" cx="24" cy="21" r="3"></circle>
      </svg>
    </span>
    <span class="lume-toggle-copy"><strong>Lume</strong><small>Guia do ateliê</small></span>
    <span class="lume-toggle-mark" aria-hidden="true">✦</span>
  </button>

  <section class="lume-panel" id="lume-panel" data-lume-panel role="dialog" aria-modal="false" aria-labelledby="lume-title" hidden>
    <header class="lume-panel-head">
      <span class="lume-panel-sigil" aria-hidden="true">✦</span>
      <div>
        <p class="lume-kicker">ANFITRIÃ DO ATELIÊ</p>
        <h2 id="lume-title">Por onde começamos?</h2>
      </div>
      <button class="lume-close" type="button" data-lume-close aria-label="Fechar guia">×</button>
    </header>

    <p class="lume-intro">Sou Lume. Posso indicar caminhos por acervos, referências, cadernos e percursos.</p>
    <p class="lume-privacy"><span aria-hidden="true">●</span> As perguntas são processadas aqui. Só ao ativar, a biblioteca vem do jsDelivr e os pesos da Hugging Face; as perguntas não são enviadas a eles.</p>

    <form class="lume-form" data-lume-form>
      <label for="lume-question">O que você quer explorar?</label>
      <div class="lume-input-row">
        <input id="lume-question" name="question" type="text" maxlength="160" autocomplete="off" placeholder="Ex.: museus, museums, museos…" dir="auto" required />
        <button type="submit" aria-label="Enviar pergunta">→</button>
      </div>
    </form>

    <div class="lume-prompts" role="group" aria-label="Sugestões de perguntas">
      <button type="button" data-lume-prompt="Como encontro obras nos museus?">Museus</button>
      <button type="button" data-lume-prompt="Quero estudar gesto e mãos">Gesto & mãos</button>
      <button type="button" data-lume-prompt="Onde vejo artistas de referência?">Referências</button>
    </div>

    <div class="lume-answer">
      <p data-lume-response aria-live="polite" dir="auto">Escolha uma sugestão ou escreva sobre o que procura.</p>
      <nav class="lume-answer-links" data-lume-links aria-label="Caminhos sugeridos"></nav>
    </div>
    <section class="lume-ai" aria-label="Modelo de inteligência artificial local">
      <div class="lume-ai-heading"><strong>IA local opcional</strong><span>Qwen · quantizado</span></div>
      <p class="lume-ai-copy">Com GPU compatível, baixa cerca de 483 MB (4 bits). Sem ela, usa CPU/WASM com cerca de 512 MB (8 bits), em velocidade menor. O modelo só baixa após sua escolha e fica no cache deste navegador; não é uma instalação no Android.</p>
      <button class="lume-ai-enable" type="button" data-lume-ai-enable>Ativar IA local · até 512 MB</button>
      <button class="lume-ai-cancel" type="button" data-lume-ai-cancel hidden>Cancelar carregamento</button>
      <progress class="lume-ai-progress" data-lume-ai-progress max="100" value="0" hidden aria-label="Progresso de carregamento do modelo"></progress>
      <p class="lume-ai-status" data-lume-ai-status role="status">O download começa após sua escolha. Precisa de internet e espaço livre.</p>
      <a class="lume-ai-model-link" href="https://huggingface.co/onnx-community/Qwen2.5-0.5B-Instruct" target="_blank" rel="noopener noreferrer">Ver modelo e arquivos ↗</a>
    </section>
    <p class="lume-note">Modelo experimental: confira os caminhos verificados antes de seguir uma orientação.</p>
  </section>
</aside>

<script>
const root = document.querySelector('[data-lume]');
if (root) {
  const toggle = root.querySelector('[data-lume-toggle]');
  const panel = root.querySelector('[data-lume-panel]');
  const closeButton = root.querySelector('[data-lume-close]');
  const form = root.querySelector('[data-lume-form]');
  const question = root.querySelector('#lume-question');
  const response = root.querySelector('[data-lume-response]');
  const links = root.querySelector('[data-lume-links]');
  const aiEnable = root.querySelector('[data-lume-ai-enable]');
  const aiCancel = root.querySelector('[data-lume-ai-cancel]');
  const aiStatus = root.querySelector('[data-lume-ai-status]');
  const aiProgress = root.querySelector('[data-lume-ai-progress]');
  let aiWorker = null;
  let aiState = 'idle';
  let aiBusy = false;
  let aiDevice = '';
  let requestId = 0;
  let activeRequestId = 0;
  let activeQuestion = '';
  const baseValue = root.dataset.base || '/';
  const base = baseValue.endsWith('/') ? baseValue : baseValue + '/';
  const destinationLabels = Object.freeze({
    museums:{pt:'Abrir Museus →',en:'Open Museums →',es:'Abrir Museos →',fr:'Ouvrir Musées →',it:'Apri Musei →',de:'Museen öffnen →',ja:'美術館を開く →',ko:'박물관 열기 →',zh:'打开博物馆 →',ar:'فتح المتاحف ←'},
    gesture:{pt:'Buscar “gesto” →',en:'Search “gesture” →',es:'Buscar “gesto” →',fr:'Chercher « geste » →',it:'Cerca “gesto” →',de:'„Geste“ suchen →',ja:'「ジェスチャー」を検索 →',ko:'“제스처” 검색 →',zh:'搜索“姿态” →',ar:'البحث عن «الإيماءة» ←'},
    notebooks:{pt:'Abrir Cadernos →',en:'Open Notebooks →',es:'Abrir Cuadernos →',fr:'Ouvrir Cahiers →',it:'Apri Quaderni →',de:'Hefte öffnen →',ja:'ノートを開く →',ko:'노트 열기 →',zh:'打开学习笔记 →',ar:'فتح الدفاتر ←'},
    references:{pt:'Abrir Referências →',en:'Open References →',es:'Abrir Referencias →',fr:'Ouvrir Références →',it:'Apri Riferimenti →',de:'Referenzen öffnen →',ja:'参考資料を開く →',ko:'레퍼런스 열기 →',zh:'打开参考资料 →',ar:'فتح المراجع ←'},
    journeys:{pt:'Abrir Percursos →',en:'Open Pathways →',es:'Abrir Recorridos →',fr:'Ouvrir Parcours →',it:'Apri Percorsi →',de:'Lernpfade öffnen →',ja:'学習ルートを開く →',ko:'학습 경로 열기 →',zh:'打开学习路径 →',ar:'فتح المسارات ←'},
    search:{pt:'Abrir Busca →',en:'Open Search →',es:'Abrir Búsqueda →',fr:'Ouvrir Recherche →',it:'Apri Ricerca →',de:'Suche öffnen →',ja:'検索を開く →',ko:'검색 열기 →',zh:'打开搜索 →',ar:'فتح البحث ←'},
    banks:{pt:'Abrir Bancos de Imagens →',en:'Open Image Banks →',es:'Abrir Bancos de Imágenes →',fr:'Ouvrir les banques d’images →',it:'Apri le banche immagini →',de:'Bildarchive öffnen →',ja:'画像アーカイブを開く →',ko:'이미지 아카이브 열기 →',zh:'打开图像档案 →',ar:'فتح أرشيف الصور ←'},
    bndigital:{pt:'Abrir BNDigital →',en:'Open BNDigital →',es:'Abrir BNDigital →',fr:'Ouvrir BNDigital →',it:'Apri BNDigital →',de:'BNDigital öffnen →',ja:'BNDigitalを開く →',ko:'BNDigital 열기 →',zh:'打开 BNDigital →',ar:'فتح BNDigital ←'}
  });
  const destinations = Object.freeze({
    museums:{href:base+'museus/',label:destinationLabels.museums},
    gesture:{href:base+'busca/?q=gesto',label:destinationLabels.gesture},
    notebooks:{href:base+'cadernos/',label:destinationLabels.notebooks},
    references:{href:base+'referencias/',label:destinationLabels.references},
    journeys:{href:base+'percursos/',label:destinationLabels.journeys},
    search:{href:base+'busca/',label:destinationLabels.search},
    banks:{href:base+'bancos/',label:destinationLabels.banks},
    bndigital:{href:base+'bancos/bndigital/',label:destinationLabels.bndigital}
  });

  const supportedLocales=new Set(['pt','en','es','fr','it','de','ja','ko','zh','ar']);
  const browserLocale=()=>{
    const value=String(navigator.languages?.[0]||navigator.language||document.documentElement.lang||'en').toLowerCase().split('-')[0];
    return supportedLocales.has(value)?value:'en';
  };
  const detectLocale=(raw)=>{
    const value=String(raw||'').toLocaleLowerCase();
    if(/[\u3040-\u30ff]/.test(value))return'ja';
    if(/[\uac00-\ud7af]/.test(value))return'ko';
    if(/[\u0600-\u06ff]/.test(value))return'ar';
    if(/[\u4e00-\u9fff]/.test(value))return'zh';
    if(/\b(bndigital|bn\s+digital|banco de imagens|bancos de imagens|acervo digital|acervos digitais)\b/.test(value))return'pt';
    if(/\b(image banks?|national library|digital image archive)\b/.test(value))return'en';
    if(/\b(bancos? de im[aá]genes)\b/.test(value))return'es';
    if(/\b(musée|musées|référence|références|artiste|artistes|dessin|mains|recherche|chercher|où|comment|étudier|parcours)\b/.test(value))return'fr';
    if(/\b(museo|musei|riferimento|riferimenti|artista|artisti|disegno|mani|ricerca|cercare|dove|come|studiare|percorso)\b/.test(value))return'it';
    if(/\b(museum|museen|referenz|referenzen|künstler|kunstler|zeichnung|hände|hande|suche|suchen|wo|wie|lernen|lernpfad)\b/.test(value))return'de';
    if(/\b(museum|museums|references|artist|artists|drawing|gesture|hands|search|where|how|study|notebook|pathway|start|want)\b/.test(value))return'en';
    if(/\b(museo|museos|referencias|artista|artistas|dibujo|gesto|manos|buscar|donde|cómo|como|estudiar|cuaderno|recorrido|empezar|quiero)\b/.test(value))return'es';
    if(/\b(museu|museus|referência|referencias|artista|artistas|desenho|gesto|mãos|maos|buscar|onde|como|estudar|caderno|percurso|começar|quero)\b/.test(value))return'pt';
    return browserLocale();
  };

  const messages=Object.freeze({
    pt:{empty:'Escreva uma palavra ou escolha uma sugestão para eu indicar um caminho.',museums:'Na página Museus, pesquise por artista, obra ou tema e abra a fonte institucional.',gesture:'Para gesto e prática de desenho, comece pelos Cadernos ou use a busca do site.',references:'O Atlas de Referências reúne artistas, materiais de estudo e fontes originais.',journeys:'Os Percursos organizam o estudo em sequências curtas e verificadas.',search:'A Busca atravessa referências, cadernos, história, bancos, temporadas e percursos.',banks:"Os Bancos de Imagens organizam instituições, direitos e termos de pesquisa por fonte.",bndigital:"A ficha BNDigital reúne leques de estudo e abre o catálogo da Biblioteca Nacional; confira os direitos na origem.",fallback:'Posso levar você aos Museus, ao Atlas de Referências ou aos Percursos.'},
    en:{empty:'Write a word or choose a suggestion and I will point you to a verified path.',museums:'Use Museums to search by artist, artwork or theme, then open the original institution.',gesture:'For gesture and drawing practice, start with the Notebooks or use site search.',references:'The Reference Atlas gathers artists, study material and original sources.',journeys:'Pathways organize study into short verified sequences.',search:'Search covers references, notebooks, art history, image banks, seasons and pathways.',banks:"Image Banks organize institutions, rights and search terms by source.",bndigital:"The BNDigital record opens Brazil’s National Library catalog; check rights on the original record.",fallback:'I can take you to Museums, the Reference Atlas or the study Pathways.'},
    es:{empty:'Escribe una palabra o elige una sugerencia y te indicaré un camino verificado.',museums:'En Museos busca por artista, obra o tema y abre después la institución original.',gesture:'Para gesto y práctica de dibujo, empieza por los Cuadernos o usa la búsqueda.',references:'El Atlas de Referencias reúne artistas, materiales de estudio y fuentes originales.',journeys:'Los Recorridos organizan el estudio en secuencias breves y verificadas.',search:'La Búsqueda recorre referencias, cuadernos, historia del arte, bancos y recorridos.',banks:"Los Bancos de Imágenes organizan instituciones, derechos y términos de búsqueda por fuente.",bndigital:"La ficha BNDigital abre el catálogo de la Biblioteca Nacional de Brasil; consulta los derechos en el registro original.",fallback:'Puedo llevarte a Museos, al Atlas de Referencias o a los Recorridos.'},
    fr:{empty:'Écrivez un mot ou choisissez une suggestion et je vous indiquerai un chemin vérifié.',museums:'Dans Musées, cherchez un artiste, une œuvre ou un thème puis ouvrez la source institutionnelle.',gesture:'Pour le geste et le dessin, commencez par les Cahiers ou utilisez la recherche.',references:'L’Atlas de Références rassemble artistes, ressources d’étude et sources originales.',journeys:'Les Parcours organisent l’étude en séquences courtes et vérifiées.',search:'La Recherche parcourt références, cahiers, histoire de l’art, banques et parcours.',banks:"Les banques d’images organisent les institutions, les droits et les termes de recherche par source.",bndigital:"La fiche BNDigital ouvre le catalogue de la Bibliothèque nationale du Brésil ; vérifiez les droits à la source.",fallback:'Je peux vous guider vers les Musées, l’Atlas de Références ou les Parcours.'},
    it:{empty:'Scrivi una parola o scegli un suggerimento e ti indicherò un percorso verificato.',museums:'In Musei cerca artista, opera o tema e poi apri la fonte istituzionale.',gesture:'Per gesto e pratica del disegno, inizia dai Quaderni o usa la ricerca.',references:'L’Atlante dei Riferimenti raccoglie artisti, materiali di studio e fonti originali.',journeys:'I Percorsi organizzano lo studio in sequenze brevi e verificate.',search:'La Ricerca attraversa riferimenti, quaderni, storia dell’arte, archivi e percorsi.',banks:"Le banche immagini organizzano istituzioni, diritti e termini di ricerca per fonte.",bndigital:"La scheda BNDigital apre il catalogo della Biblioteca Nazionale del Brasile; verifica i diritti alla fonte.",fallback:'Posso guidarti verso Musei, Atlante dei Riferimenti o Percorsi.'},
    de:{empty:'Schreiben Sie ein Wort oder wählen Sie einen Vorschlag; ich zeige einen geprüften Weg.',museums:'Unter Museen nach Künstler, Werk oder Thema suchen und anschließend die Originalquelle öffnen.',gesture:'Für Geste und Zeichenpraxis mit den Heften beginnen oder die Seitensuche nutzen.',references:'Der Referenzatlas bündelt Künstler, Studienmaterial und Originalquellen.',journeys:'Lernpfade ordnen das Studium in kurze geprüfte Sequenzen.',search:'Die Suche umfasst Referenzen, Hefte, Kunstgeschichte, Bildarchive und Lernpfade.',banks:"Bildarchive ordnen Institutionen, Rechte und Suchbegriffe nach Quelle.",bndigital:"Der BNDigital-Eintrag öffnet den Katalog der Nationalbibliothek Brasiliens; Rechte bitte im Originaldatensatz prüfen.",fallback:'Ich kann zu Museen, Referenzatlas oder Lernpfaden führen.'},
    ja:{empty:'言葉を入力するか候補を選ぶと、確認済みのルートをご案内します。',museums:'「美術館」では作家・作品・テーマから探し、元の所蔵機関を開けます。',gesture:'ジェスチャーやドローイング練習は、ノートまたはサイト内検索から始められます。',references:'参考資料アトラスでは、作家・学習資料・一次情報源をまとめています。',journeys:'学習ルートは、短く確認済みの順序で学びを整理します。',search:'検索では参考資料、ノート、美術史、画像アーカイブ、学習ルートを横断できます。',banks:"画像アーカイブでは、機関・権利・検索語を出典別に整理しています。",bndigital:"BNDigitalの記録からブラジル国立図書館のカタログを開けます。権利は原記録で確認してください。",fallback:'美術館、参考資料アトラス、学習ルートへご案内できます。'},
    ko:{empty:'단어나 제안을 선택하면 확인된 경로를 안내해 드립니다.',museums:'박물관에서 작가·작품·주제로 검색한 뒤 원 기관의 자료를 열 수 있습니다.',gesture:'제스처와 드로잉 연습은 노트 또는 사이트 검색에서 시작하세요.',references:'레퍼런스 아틀라스에는 작가, 학습 자료, 원 출처가 정리되어 있습니다.',journeys:'학습 경로는 짧고 검증된 순서로 공부를 구성합니다.',search:'검색은 레퍼런스, 노트, 미술사, 이미지 아카이브와 학습 경로를 아우릅니다.',banks:"이미지 아카이브는 기관, 권리, 검색어를 출처별로 정리합니다.",bndigital:"BNDigital 항목에서 브라질 국립도서관 카탈로그를 열 수 있습니다. 권리는 원본 기록에서 확인하세요.",fallback:'박물관, 레퍼런스 아틀라스 또는 학습 경로로 안내할 수 있습니다.'},
    zh:{empty:'输入一个词或选择建议，我会带你前往已验证的路径。',museums:'在“博物馆”中按艺术家、作品或主题搜索，然后打开原始机构来源。',gesture:'学习姿态与绘画练习，可从学习笔记或站内搜索开始。',references:'参考资料图谱汇集艺术家、学习材料和原始来源。',journeys:'学习路径把内容组织成简短且已验证的步骤。',search:'搜索可跨参考资料、学习笔记、艺术史、图像档案与学习路径。',banks:"图像档案按来源整理机构、权利和检索词。",bndigital:"BNDigital 条目可打开巴西国家图书馆目录；请在原始记录中核对权利。",fallback:'我可以带你前往博物馆、参考资料图谱或学习路径。'},
    ar:{empty:'اكتب كلمة أو اختر اقتراحًا وسأرشدك إلى مسار موثّق.',museums:'في قسم المتاحف ابحث باسم الفنان أو العمل أو الموضوع ثم افتح المصدر المؤسسي الأصلي.',gesture:'لدراسة الإيماءة والرسم ابدأ بالدفاتر أو استخدم بحث الموقع.',references:'يجمع أطلس المراجع الفنانين ومواد الدراسة والمصادر الأصلية.',journeys:'تنظم المسارات الدراسة في خطوات قصيرة وموثّقة.',search:'يشمل البحث المراجع والدفاتر وتاريخ الفن وأرشيفات الصور والمسارات.',banks:"تنظم أرشيفات الصور المؤسسات والحقوق وعبارات البحث بحسب المصدر.",bndigital:"يفتح سجل BNDigital فهرس المكتبة الوطنية البرازيلية؛ تحقّق من الحقوق في السجل الأصلي.",fallback:'يمكنني إرشادك إلى المتاحف أو أطلس المراجع أو مسارات الدراسة.'}
  });

  const topicKeywords=Object.freeze({
    museums:['museu','museo','museum','musée','musei','museen','美術館','博物馆','박물관','متحف','متاحف','acervo','archive','collection'],
    gesture:['gesto','gesture','geste','mani','hände','hande','ジェスチャー','姿态','제스처','إيماءة','mao','maos','mano','manos','hand','hands','mains','figura','figure','drawing','dessin','disegno','zeichnung','ドローイング','绘画','드로잉','رسم'],
    references:['referencia','reference','référence','riferimento','referenz','参考','레퍼런스','مرجع','مراجع','atlas','artista','artist','artiste','künstler','kunstler','作家','艺术家','작가','فنان'],
    journeys:['percurso','recorrido','pathway','parcours','percorso','lernpfad','学習','学习路径','학습 경로','مسار','trilha','trail'],
    search:['busca','buscar','busqueda','search','recherche','ricerca','suche','検索','搜索','검색','بحث','pesquisa'],
    banks:['banco de imagens','bancos de imagens','acervo digital','acervos digitais','image bank','image banks','image archive','digital collections','banco de imagenes','bancos de imagenes','archivo digital','banque d images','archives numeriques','banca immagini','archivio digitale','bilddatenbank','bildarchiv','画像アーカイブ','이미지 아카이브','图像档案','أرشيف الصور'],
    bndigital:['bndigital','bn digital','biblioteca nacional','national library','bibliotheque nationale','bibliothèque nationale','biblioteca nacional do brasil','biblioteca nacional de brasil','巴西国家图书馆','المكتبة الوطنية البرازيلية']
  });

  const answerFor=(raw)=>{
    const locale=detectLocale(raw);
    const m=messages[locale]||messages.en;
    const text=String(raw||'').trim().toLocaleLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'');
    if(!text)return{message:m.empty,actions:[],locale};
    if(topicKeywords.bndigital.some(word=>text.includes(word)))return{message:m.bndigital,actions:['bndigital'],locale};
    if(topicKeywords.banks.some(word=>text.includes(word)))return{message:m.banks,actions:['banks'],locale};
    if(topicKeywords.museums.some(word=>text.includes(word)))return{message:m.museums,actions:['museums'],locale};
    if(topicKeywords.gesture.some(word=>text.includes(word)))return{message:m.gesture,actions:['notebooks','gesture'],locale};
    if(topicKeywords.references.some(word=>text.includes(word)))return{message:m.references,actions:['references'],locale};
    if(topicKeywords.journeys.some(word=>text.includes(word)))return{message:m.journeys,actions:['journeys'],locale};
    if(topicKeywords.search.some(word=>text.includes(word)))return{message:m.search,actions:['search'],locale};
    return{message:m.fallback,actions:['museums','references','journeys'],locale};
  };
  const routeKeywords=Object.freeze({
    museums:topicKeywords.museums,
    gesture:topicKeywords.gesture.concat(topicKeywords.search),
    notebooks:topicKeywords.gesture.concat(['caderno','cuaderno','notebook','cahier','quaderno','heft','ノート','笔记','노트','دفتر']),
    references:topicKeywords.references,
    journeys:topicKeywords.journeys,
    search:topicKeywords.search,
    banks:topicKeywords.banks,
    bndigital:topicKeywords.bndigital
  });

  const answerStaysOnRoute = (raw, actions) => {
    const answer = String(raw || '').toLocaleLowerCase('pt-BR').normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    return actions.some((key) => (routeKeywords[key] || []).some((word) => answer.includes(word)));
  };

  const showAnswer = (raw) => {
    const answer = answerFor(raw);
    response.textContent = answer.message;
    links.replaceChildren();
    answer.actions.forEach((key) => {
      const destination = destinations[key];
      if (!destination) return;
      const link = document.createElement('a');
      link.href = destination.href;
      link.textContent = destination.label[answer.locale] || destination.label.pt;
      links.append(link);
    });
  };

  const setAiStatus = (message) => {
    aiStatus.textContent = message;
  };

  const resetAiWorker = () => {
    if (aiWorker) aiWorker.terminate();
    aiWorker = null;
    aiBusy = false;
    aiDevice = '';
    requestId += 1;
  };

  const handleAiMessage = (event) => {
    const message = event.data || {};
    if (message.type === 'backend') {
      aiDevice = message.device || '';
      const route = aiDevice === 'webgpu' ? 'GPU · 4 bits · ~483 MB' : 'CPU/WASM · 8 bits · ~512 MB';
      setAiStatus(`Motor escolhido: ${route}. Preparando modelo no cache do navegador…`);
      return;
    }

    if (message.type === 'progress') {
      aiProgress.hidden = false;
      const progress = Number(message.progress);
      const engine = aiDevice === 'webgpu' ? 'GPU' : aiDevice === 'wasm' ? 'CPU/WASM' : 'local';
      if (Number.isFinite(progress)) {
        const percent = Math.max(0, Math.min(100, progress <= 1 ? progress * 100 : progress));
        aiProgress.value = percent;
        setAiStatus((message.status === 'runtime' ? 'Carregando o runtime local…' : `Baixando/preparando no motor ${engine}…`) + (percent > 0 ? ' ' + Math.round(percent) + '%.' : ''));
      } else {
        setAiStatus(message.status === 'runtime' ? 'Carregando o runtime local…' : `Baixando e preparando o modelo no motor ${engine}…`);
      }
      return;
    }

    if (message.type === 'unsupported') {
      resetAiWorker();
      aiState = 'failed';
      aiEnable.disabled = false;
      aiEnable.textContent = 'Tentar carregar IA · até 512 MB';
      aiCancel.hidden = true;
      aiProgress.hidden = true;
      setAiStatus(message.reason || 'Este navegador não conseguiu abrir o modelo local. O guia de caminhos continua disponível.');
      return;
    }

    if (message.type === 'ready') {
      aiState = 'ready';
      aiEnable.disabled = true;
      aiEnable.textContent = 'IA local pronta';
      aiCancel.hidden = true;
      aiProgress.hidden = true;
      setAiStatus(`Modelo ${aiDevice === 'webgpu' ? '4 bits na GPU' : '8 bits em CPU/WASM'} pronto e guardado no cache deste navegador. As perguntas são processadas localmente.`);
      return;
    }

    if (message.type === 'answer' && message.id === activeRequestId) {
      aiBusy = false;
      const verified = answerFor(activeQuestion);
      if (!answerStaysOnRoute(message.text, verified.actions)) {
        response.textContent = verified.message;
        setAiStatus('Usei a orientação verificada do site porque a resposta gerada saiu do assunto.');
        return;
      }
      response.textContent = message.text;
      return;
    }

    if (message.type === 'error') {
      if (message.stage === 'answer') {
        if (message.id === activeRequestId) {
          aiBusy = false;
          const localAnswer = answerFor(activeQuestion);
          response.textContent = localAnswer.message + ' A resposta local continua disponível.';
        }
        setAiStatus('A geração local falhou. As sugestões verificadas continuam disponíveis.');
        return;
      }

      aiState = 'failed';
      resetAiWorker();
      aiEnable.disabled = false;
      aiEnable.textContent = 'Tentar carregar IA · até 512 MB';
      aiCancel.hidden = true;
      aiProgress.hidden = true;
      const reason = String(message.reason || '').slice(0, 150);
      setAiStatus((reason ? `Falha ao abrir o modelo: ${reason}. ` : 'Não foi possível abrir o modelo. ') + 'O guia de caminhos continua disponível; você pode tentar novamente.');
    }
  };

  const askWithAi = (raw) => {
    const text = String(raw || '').slice(0, 160);
    showAnswer(text);
    if (aiState !== 'ready' || !aiWorker) return;
    if (aiBusy) {
      response.textContent = 'Ainda estou preparando esta resposta. Aguarde um instante.';
      return;
    }
    aiBusy = true;
    activeQuestion = text;
    activeRequestId = ++requestId;
    response.textContent = 'Lume está preparando uma orientação…';
    const verified = answerFor(text);
    aiWorker.postMessage({ type: 'ask', id: activeRequestId, question: text, locale: verified.locale, routeKeys: verified.actions, verifiedAnswer: verified.message });
  };

  const startAi = async () => {
    if (aiState === 'loading' || aiState === 'ready') return;
    if (typeof Worker === 'undefined') {
      aiState = 'failed';
      setAiStatus('Este navegador não permite executar o modelo em segundo plano. O guia local continua disponível.');
      return;
    }
    try {
      const estimate = await navigator.storage?.estimate?.();
      const available = Number(estimate?.quota) - Number(estimate?.usage || 0);
      if (Number.isFinite(available) && available > 0 && available < 550 * 1024 * 1024) {
        setAiStatus('O espaço livre informado pelo navegador parece baixo para guardar o modelo. Vou tentar carregar; se falhar, libere espaço e tente de novo.');
      }
    } catch {}
    aiState = 'loading';
    aiEnable.disabled = true;
    aiEnable.textContent = 'Preparando IA local…';
    aiCancel.hidden = false;
    aiProgress.hidden = false;
    aiProgress.value = 0;
    setAiStatus('Verificando GPU e preparando a alternativa CPU/WASM…');
    try {
      aiWorker = new Worker(new URL('../scripts/lume-ai.worker.js', import.meta.url), { type: 'module' });
    } catch (error) {
      aiState = 'failed';
      aiEnable.disabled = false;
      aiEnable.textContent = 'Tentar carregar IA · até 512 MB';
      aiCancel.hidden = true;
      aiProgress.hidden = true;
      setAiStatus(`O runtime local não iniciou: ${String(error?.message || error).slice(0, 140)}. Você pode tentar novamente.`);
      return;
    }
    aiWorker.addEventListener('message', handleAiMessage);
    aiWorker.addEventListener('error', (event) => {
      aiState = 'failed';
      resetAiWorker();
      aiEnable.disabled = false;
      aiEnable.textContent = 'Tentar carregar IA · até 512 MB';
      aiCancel.hidden = true;
      aiProgress.hidden = true;
      setAiStatus('O navegador interrompeu o motor local. Feche outras abas, confira o espaço livre e tente novamente.');
      event.preventDefault();
    });
    aiWorker.postMessage({ type: 'load' });
  };

  const cancelAi = () => {
    resetAiWorker();
    aiState = 'idle';
    aiEnable.disabled = false;
    aiEnable.textContent = 'Ativar IA local · até 512 MB';
    aiCancel.hidden = true;
    aiProgress.hidden = true;
    setAiStatus('Carregamento interrompido. O guia local continua disponível.');
  };

  const setOpen = (open, returnFocus = false) => {
    panel.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    if (open) question.focus();
    else if (returnFocus) toggle.focus();
  };

  toggle.addEventListener('click', () => setOpen(panel.hidden));
  closeButton.addEventListener('click', () => setOpen(false, true));
  form.addEventListener('submit', (event) => {
    event.preventDefault();
    askWithAi(question.value);
  });
  root.querySelectorAll('[data-lume-prompt]').forEach((button) => {
    button.addEventListener('click', () => {
      question.value = button.dataset.lumePrompt || '';
      askWithAi(question.value);
    });
  });
  aiEnable.addEventListener('click', () => { void startAi(); });
  aiCancel.addEventListener('click', cancelAi);
  panel.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setOpen(false, true);
  });
}
</script>

