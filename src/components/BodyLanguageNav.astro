---
const { current="" }=Astro.props;
const base=import.meta.env.BASE_URL.endsWith('/')?import.meta.env.BASE_URL:import.meta.env.BASE_URL+'/';
const items=[
  {id:'maos',n:'01',title:'Mãos',meta:'ação · contato',href:'maos/'},
  {id:'corpo',n:'02',title:'Corpo em Relação',meta:'peso · distância',href:'corpo-em-relacao/'},
  {id:'cabeca',n:'03',title:'Cabeça & Expressão',meta:'direção · presença',href:'cabeca-expressao/'}
];
---
<nav class="body-language-nav" aria-label="Trilha de linguagem corporal">
  <span class="body-language-label">LINGUAGEM CORPORAL</span>
  {items.map((item)=><a href={base+item.href} class:list={['body-language-link',{active:item.id===current}]} aria-current={item.id===current?'page':undefined} data-astro-prefetch>
      <small>{item.n}</small><span><b>{item.title}</b><em>{item.meta}</em></span>
    </a>)}
</nav>
<style>
.body-language-nav{max-width:1380px;margin:18px auto 0;display:grid;grid-template-columns:auto repeat(3,minmax(0,1fr));align-items:center;gap:12px;padding:12px clamp(18px,5vw,76px);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.body-language-label{color:var(--gold);font-size:.61rem;font-weight:800;letter-spacing:.15em}.body-language-link{display:flex;align-items:center;gap:10px;padding:9px 10px;border-radius:8px;text-decoration:none;color:var(--paper-2);transition:.18s}.body-language-link:hover,.body-language-link.active{background:rgba(179,154,105,.08);color:var(--paper)}.body-language-link small{color:var(--gold);font-size:.58rem}.body-language-link span{display:flex;flex-direction:column}.body-language-link b{font:400 1.05rem/1.05 "Cormorant Garamond",Georgia,serif}.body-language-link em{font-style:normal;color:var(--muted);font-size:.62rem;margin-top:3px}
@media(max-width:760px){.body-language-nav{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;padding:10px 18px;gap:6px}.body-language-label{flex:0 0 105px}.body-language-link{flex:0 0 175px;scroll-snap-align:start}}
@media(prefers-reduced-motion:reduce){.body-language-link{transition:none}}
</style>