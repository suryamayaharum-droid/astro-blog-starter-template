---
import '../styles/global.css';
import { STUDIO_INSTAGRAM, ARTE_HARUM_INSTAGRAM, HARUM_YOUTUBE, STUDIO_SITE } from '../consts';
interface Alternate { hreflang:string; href:string; }
interface Props { title:string; description:string; image?:string; locale?:string; alternates?:Alternate[]; }
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const siteRoot = new URL(base, Astro.site);
const canonicalRoot = siteRoot.href.endsWith('/') ? siteRoot.href.slice(0,-1) : siteRoot.href;
const alternateHref = (href:string) => {
  const resolved = new URL(href, siteRoot).href;
  return resolved === siteRoot.href ? canonicalRoot : resolved;
};
const { title, description, image = `${base}noir/visual-atlas/atelier-desk.webp`, locale = 'pt-BR', alternates = [] } = Astro.props;
const wallpaperRoutes: Record<string,string> = {
  '/':'home','/escola':'escola','/atlas':'atlas','/percursos':'percursos',
  '/cadernos':'cadernos','/cadernos/gesto':'cadernos-gesto','/cadernos/memoria':'cadernos-memoria',
  '/cadernos/olhar':'cadernos-olhar','/cadernos/presenca':'cadernos-presenca','/cadernos/vestigio':'cadernos-vestigio',
  '/atelier':'atelier','/maos':'maos','/biblioteca':'biblioteca','/bancos':'bancos','/museus':'museus',
  '/colecoes':'colecoes','/colecoes/estudo-tonal':'colecoes-estudo-tonal','/colecoes/gesto-figura':'colecoes-gesto-figura',
  '/referencias':'referencias','/radar':'radar','/outliers':'outliers','/historia-da-arte':'historia-da-arte',
  '/arquivo':'arquivo','/temporadas':'temporadas','/noir':'noir','/sobre':'sobre','/carta':'carta',
  '/buscar':'buscar','/roubar-como-artista':'roubar-como-artista','/composicoes-autorais':'composicoes-autorais',
  '/cultura-visual-brasileira':'cultura-visual-brasileira','/tatuagem-salvador':'tatuagem-salvador',
  '/vault':'vault','/artists':'artists','/about':'about','/classics':'classics','/desenho':'desenho','/newsletter':'newsletter'
};
const basePath = base !== '/' && base.endsWith('/') ? base.slice(0, -1) : '';
const pathname = Astro.url.pathname;
const unbasedPath = basePath && (pathname === basePath || pathname.startsWith(basePath + '/')) ? pathname.slice(basePath.length) : pathname;
const routePath = unbasedPath.length > 1 && unbasedPath.endsWith('/') ? unbasedPath.slice(0, -1) : unbasedPath || '/';
const wallpaperKey = locale.toLowerCase().startsWith('pt')
  ? (wallpaperRoutes[routePath] || (routePath.startsWith('/referencias/') ? 'referencia-perfil' : ''))
  : '';
const routeWallpaper = wallpaperKey ? `${base}noir/page-wallpapers/${wallpaperKey}.webp` : '';
const ptAlternate=alternates.find(item=>item.hreflang.toLowerCase()==='pt-br');
const xDefaultHref=ptAlternate ? alternateHref(ptAlternate.href) : (locale.toLowerCase()==='pt-br' ? canonicalURL.href : canonicalRoot);
const imageURL = new URL(image, Astro.site);
const ogLocale = locale.replace('-', '_');
const googleVerification=String(import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION||'').trim();
const bingVerification=String(import.meta.env.PUBLIC_BING_SITE_VERIFICATION||'').trim();
const graph = {
  '@context':'https://schema.org',
  '@graph':[
    {
      '@type':'Organization','@id':siteRoot.href+'#arte-harum','name':'Arte Harum','url':siteRoot.href,
      'description':'Pesquisa artística autoral em desenho, carvão, figura, anatomia, repertório visual e composição.',
      'areaServed':{'@type':'Place','name':'Salvador, Bahia, Brazil'},
      'sameAs':[ARTE_HARUM_INSTAGRAM,HARUM_YOUTUBE],
      'knowsAbout':['charcoal drawing','figure drawing','artistic anatomy','gesture drawing','art history','visual research','tattoo composition']
    },
    {
      '@type':'CreativeWorkSeries','@id':siteRoot.href+'#harum-noir','name':'HARUM NOIR','url':siteRoot.href,
      'description':'Selo editorial de Arte Harum para carvão, figura, anatomia, gesto, processo e pesquisa visual.',
      'creator':{'@id':siteRoot.href+'#arte-harum'},
      'inLanguage':['pt-BR','en','es'],
      'keywords':['charcoal drawing','figure drawing','artistic anatomy','gesture','art history','visual archive']
    },
    {
      '@type':['TattooParlor','LocalBusiness'],'@id':siteRoot.href+'#studio-23','name':'Tattoo Studio 23','url':STUDIO_SITE,
      'description':'Prática de tatuagem autoral relacionada a Arte Harum, com portfólio documentado e atendimento por agendamento em Salvador.',
      'sameAs':[STUDIO_INSTAGRAM],
      'areaServed':{'@type':'City','name':'Salvador','containedInPlace':{'@type':'State','name':'Bahia'}},
      'knowsAbout':['authorial tattoo','fine line tattoo','blackwork tattoo','sketch tattoo','botanical tattoo','figure tattoo']
    },
    {
      '@type':'WebSite','@id':siteRoot.href+'#website','url':siteRoot.href,'name':'HARUM NOIR','alternateName':'Arte Harum',
      'description':'Ateliê editorial sobre desenho, carvão, anatomia, observação e história da arte.',
      'inLanguage':['pt-BR','en','es'],'publisher':{'@id':siteRoot.href+'#arte-harum'},
      'about':{'@id':siteRoot.href+'#harum-noir'},'relatedLink':STUDIO_SITE
    },
    {
      '@type':'WebPage','@id':canonicalURL.href+'#webpage','url':canonicalURL.href,'name':title,'description':description,'inLanguage':locale,
      'isPartOf':{'@id':siteRoot.href+'#website'},'about':{'@id':siteRoot.href+'#harum-noir'},
      'publisher':{'@id':siteRoot.href+'#arte-harum'},
      'primaryImageOfPage':{'@type':'ImageObject','url':imageURL.href}
    }
  ]
}
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" content="#0b0b0b" />
<meta name="generator" content={Astro.generator} />
<meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
<meta name="googlebot" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
<meta name="author" content="Arte Harum · HARUM NOIR" />
{googleVerification && <meta name="google-site-verification" content={googleVerification} />}
{bingVerification && <meta name="msvalidate.01" content={bingVerification} />}
<link rel="canonical" href={canonicalURL} />
<link rel="alternate" hreflang={locale} href={canonicalURL} />
{alternates.map(item => <link rel="alternate" hreflang={item.hreflang} href={alternateHref(item.href)} />)}
<link rel="alternate" hreflang="x-default" href={xDefaultHref} />
<link rel="alternate" type="text/plain" title="LLM site guide" href={new URL('llms.txt',siteRoot)} />
<link rel="alternate" type="application/ld+json" title="HARUM NOIR machine-readable catalog" href={new URL('catalog.json',siteRoot)} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Manrope:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
<link rel="alternate" type="application/rss+xml" title="Carta do Ateliê" href={`${base}rss.xml`} />
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="HARUM NOIR · Arte Harum" />
<meta property="og:locale" content={ogLocale} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:alt" content={title} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
<script type="application/ld+json" set:html={JSON.stringify(graph)} />
{routeWallpaper && <meta name="harum-page-wallpaper" content={routeWallpaper} />}
{routeWallpaper && <script is:inline>
  const wallpaperMeta = document.querySelector('meta[name="harum-page-wallpaper"]');
  if (wallpaperMeta) {
    document.documentElement.dataset.routeWallpaper = 'true';
    document.documentElement.style.setProperty('--route-page-wallpaper', 'url("' + wallpaperMeta.content + '")');
  }
</script>}
