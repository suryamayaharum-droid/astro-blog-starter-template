<div class="rail-enhancer-hook" aria-hidden="true"></div>
<script>
let railSequence=0;
const enhanceRails=()=>{
  const selector='.browse-rail,.feature-rail,.stream-rail,.rail,.bank-grid,.atlas-flow-rail,.path-index,.variable-rail,.hands-reference-rail,.player-queue,.collection-index,.ih-topics,.ph-topics,.browse-quick,.search-kinds,.museum-suggestions';
  const language=(document.documentElement.lang||'pt-BR').toLowerCase();
  const labels=language.startsWith('en')
    ? {previous:'Previous content',next:'Next content',back:'Scroll to previous content',advance:'Scroll to next content',up:'Scroll up to previous content',down:'Scroll down to next content'}
    : language.startsWith('es')
      ? {previous:'Contenido anterior',next:'Contenido siguiente',back:'Volver al contenido anterior',advance:'Avanzar al contenido siguiente',up:'Subir al contenido anterior',down:'Bajar al siguiente contenido'}
      : {previous:'Conteúdo anterior',next:'Próximo conteúdo',back:'Voltar ao conteúdo anterior',advance:'Avançar para o próximo conteúdo',up:'Subir para o conteúdo anterior',down:'Descer para o próximo conteúdo'};
  document.querySelectorAll(selector).forEach((rail)=>{
    if(!(rail instanceof HTMLElement) || rail.dataset.enhancedRail==='1') return;
    rail.dataset.enhancedRail='1';
    const hadTabIndex=rail.hasAttribute('tabindex');
    if(!rail.id){
      let id;
      do{id=`enhanced-rail-${++railSequence}`}while(document.getElementById(id));
      rail.id=id;
    }

    const shell=document.createElement('div');
    shell.className='rail-shell';
    rail.parentNode?.insertBefore(shell,rail);
    shell.appendChild(rail);

    const prev=document.createElement('button');
    const next=document.createElement('button');
    prev.className='rail-nav rail-nav-prev';
    next.className='rail-nav rail-nav-next';
    prev.type='button'; next.type='button';
    prev.setAttribute('aria-label',labels.previous);
    next.setAttribute('aria-label',labels.next);
    prev.setAttribute('aria-controls',rail.id);
    next.setAttribute('aria-controls',rail.id);
    prev.textContent='‹'; next.textContent='›';
    shell.append(prev,next);

    const update=()=>{
      const vertical=rail.classList.contains('is-vertical');
      const position=vertical?rail.scrollTop:rail.scrollLeft;
      const max=Math.max(0,(vertical?rail.scrollHeight-rail.clientHeight:rail.scrollWidth-rail.clientWidth)-2);
      const overflow=max>8;
      if(!hadTabIndex){
        if(overflow) rail.tabIndex=0;
        else rail.removeAttribute('tabindex');
      }
      shell.classList.toggle('rail-has-overflow',overflow);
      shell.classList.toggle('rail-vertical',vertical);
      prev.textContent=vertical?'↑':'‹';
      next.textContent=vertical?'↓':'›';
      prev.setAttribute('aria-label',vertical?labels.up:labels.back);
      next.setAttribute('aria-label',vertical?labels.down:labels.advance);
      prev.disabled=!overflow||position<=4;
      next.disabled=!overflow||position>=max-4;
    };
    const jump=(dir)=>{
      const vertical=rail.classList.contains('is-vertical');
      const amount=Math.max((vertical?rail.clientHeight:rail.clientWidth)*.82,280);
      const reduce=window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
      const behavior=reduce?'auto':'smooth';
      if(vertical) rail.scrollBy({top:dir*amount,behavior});
      else rail.scrollBy({left:dir*amount,behavior});
    };
    prev.addEventListener('click',()=>jump(-1));
    next.addEventListener('click',()=>jump(1));
    rail.addEventListener('scroll',()=>requestAnimationFrame(update),{passive:true});
    rail.addEventListener('keydown',(e)=>{
      if(rail.classList.contains('is-vertical')){
        if(e.key==='ArrowDown'){e.preventDefault();jump(1)}
        if(e.key==='ArrowUp'){e.preventDefault();jump(-1)}
      }else{
        if(e.key==='ArrowRight'){e.preventDefault();jump(1)}
        if(e.key==='ArrowLeft'){e.preventDefault();jump(-1)}
      }
    });
    if('ResizeObserver' in window) new ResizeObserver(update).observe(rail);
    else window.addEventListener('resize',update,{passive:true});
    requestAnimationFrame(update);
  });
};
if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',enhanceRails,{once:true});
else enhanceRails();
document.addEventListener('astro:page-load',enhanceRails);
</script>
