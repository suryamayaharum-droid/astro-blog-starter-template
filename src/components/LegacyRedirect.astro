---
interface Props {
  target: string;
  title: string;
  summary: string;
  cta: string;
}
const { target, title, summary, cta } = Astro.props as Props;
const canonical = new URL(target, Astro.site).href;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,follow" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={canonical} />
    <meta name="description" content={summary} />
    <title>{title} · HARUM NOIR</title>
  </head>
  <body>
    <main>
      <p class="eyebrow">REDIRECIONAMENTO · HARUM NOIR</p>
      <h1>{title}</h1>
      <p>{summary}</p>
      <p class="hint">Se a página não abrir automaticamente, continue pelo botão.</p>
      <a href={target}>{cta} <span aria-hidden="true">↗</span></a>
    </main>
  </body>
</html>
<style>
  :global(*){box-sizing:border-box}
  :global(html){min-height:100%;background:#090909;color:#eee7dc;font-family:Arial,Helvetica,sans-serif}
  :global(body){min-height:100vh;margin:0;display:grid;place-items:center;padding:24px}
  main{width:min(100%,680px);padding:clamp(28px,7vw,64px);border:1px solid rgba(192,163,106,.35);background:linear-gradient(145deg,#161514,#0b0b0b);box-shadow:0 28px 80px #0008}
  .eyebrow{color:#c0a36a;font-size:.7rem;font-weight:700;letter-spacing:.16em;text-transform:uppercase}
  h1{margin:24px 0 12px;font-family:Georgia,'Times New Roman',serif;font-size:clamp(2.5rem,8vw,4.6rem);font-weight:400;letter-spacing:-.045em}
  main>p:not(.eyebrow){max-width:52ch;color:#c7c0b5;line-height:1.7}
  .hint{margin-top:28px;font-size:.9rem}
  a{display:inline-flex;align-items:center;gap:12px;min-height:48px;margin-top:10px;padding:0 18px;border:1px solid #c0a36a;border-radius:4px;background:#c0a36a;color:#111;font-size:.9rem;font-weight:700;text-decoration:none}
  a:focus-visible{outline:3px solid #eee7dc;outline-offset:4px}
</style>
