---
import BaseHead from './BaseHead.astro';
import RailEnhancer from './RailEnhancer.astro';
interface Card { kicker:string; title:string; text:string; href:string; label:string; }
interface Answer { question:string; answer:string; }
interface Props {
  title:string; description:string; kicker:string; heading:string; lead:string;
  cards:Card[]; answers?:Answer[]; topics?:string[]; enHref:string; esHref:string;
}
const {title,description,kicker,heading,lead,cards,answers=[],topics=[],enHref,esHref}=Astro.props;
const base=import.meta.env.BASE_URL.endsWith('/')?import.meta.env.BASE_URL:import.meta.env.BASE_URL+'/';

interface Visual {src:string;alt:string;caption:string;}
const atlas=(n:string,alt:string,caption:string):Visual=>({src:base+'noir/visual-atlas/'+n+'.webp',alt,caption});
const studio=(n:string,alt:string,caption:string):Visual=>({src:base+'studio23/assets/'+n,alt,caption});
const archiveVisual=atlas('brasil-acervo-editorial','Prancha editorial com assistência de IA inspirada em pesquisas de acervo brasileiro; não é um documento histórico.','Imagem conceitual · não é documento histórico');
const archiveCollection:Visual[]=[
atlas('museum-gallery','Ambiente editorial de galeria como ponto de partida para pesquisar coleções institucionais.','Cena editorial'),
archiveVisual,
atlas('iris-study','Estudo botânico de íris em grafite e carvão.','Estudo botânico'),
atlas('harum-noir-colecoes-atlas','Atlas editorial com estudos de forma, gesto e matéria em carvão.','Prancha de estudos')];
const drawingCollection:Visual[]=[
atlas('harum-noir-caderno-estudo','Mão desenha um modelo articulado ao lado de caderno, íris e tecido em carvão.','Estudo de observação e matéria'),
atlas('harum-noir-hands-study','Estudos editoriais de mãos, gesto e construção em carvão.','Estudo de gesto'),
atlas('exercicio-quatro-decisoes','Quatro etapas de um estudo: gesto, massas, bordas e acabamento seletivo.','Quatro decisões de desenho'),
studio('collections/instagram/instagram-06.webp','Tatuagem botânica de linha fina em antebraço, do portfólio publicado do Studio 23.','Studio 23 · portfólio publicado')];
const tattooCollection:Visual[]=[
studio('collections/instagram/instagram-06.webp','Tatuagem botânica de linha fina em antebraço, do portfólio publicado do Studio 23.','Studio 23 · portfólio publicado'),
studio('collections/instagram/instagram-02.webp','Interior do Studio 23 com obras nas paredes.','Ambiente do Studio 23 · agendamento na página oficial'),
studio('collections/instagram/instagram-08.webp','Composição floral tatuada no corpo, do portfólio publicado do Studio 23.','Studio 23 · portfólio publicado'),
studio('collections/instagram/instagram-12.webp','Tatuagem de retrato animal com elementos botânicos, do portfólio publicado do Studio 23.','Studio 23 · portfólio publicado')];
const slug=Astro.url.pathname.split('/').filter(Boolean).slice(-1)[0]||'';
const visualCollection=slug==='cultura-visual-brasileira'?archiveCollection:slug==='tatuagem-salvador'?tattooCollection:drawingCollection;
const visualCards=cards.map((card,index)=>({...card,visual:visualCollection[index%visualCollection.length]}));

const schema={
 '@context':'https://schema.org','@type':'CollectionPage',name:title,description,inLanguage:'pt-BR',
 about:topics.map((name:string)=>({'@type':'Thing',name})),
 mainEntity:{'@type':'ItemList',numberOfItems:cards.length,itemListElement:cards.map((card,index)=>({'@type':'ListItem',position:index+1,url:new URL(card.href,Astro.site).href,item:{'@type':'CreativeWork',name:card.title,description:card.text}}))}
};
const topicNav=[
 {href:base+'colecoes/',label:'Coleções'},
 {href:base+'referencias/',label:'Referências'},{href:base+'museus/',label:'Museus'},{href:base+'desenho/',label:'Desenho'},
 {href:base+'historia-da-arte/',label:'História da Arte'},{href:base+'cultura-visual-brasileira/',label:'Brasil'},{href:base+'tatuagem-salvador/',label:'Tatuagem Salvador'}
];
---
<!doctype html><html lang="pt-BR"><head><BaseHead title={title} description={description} locale="pt-BR" alternates={[{hreflang:'en',href:enHref},{hreflang:'es',href:esHref}]}/><script type="application/ld+json" set:html={JSON.stringify(schema)} /></head>
<body>
<header class="ph-header"><a href={base}>HARUM NOIR</a><nav aria-label="Idiomas"><a aria-current="page" href={Astro.url.pathname}>PT</a><a href={enHref}>EN</a><a href={esHref}>ES</a></nav></header>
<main>
<section class="ph-hero"><div><span>{kicker}</span><h1>{heading}</h1><p>{lead}</p></div></section>
<nav class="ph-topics" aria-label="Temas do ecossistema">{topicNav.map(item=><a href={item.href}>{item.label}</a>)}</nav>
<section class="ph-grid" aria-label="Coleções visuais">{visualCards.map(card=><article class="ph-collection-card">
<a class="ph-card-link" href={card.href}><figure class="ph-card-visual"><img src={card.visual.src} alt={card.visual.alt} width="1200" height="800" loading="lazy"/><figcaption><b>{card.kicker}</b><span>{card.visual.caption}</span></figcaption></figure><div class="ph-card-copy"><h2>{card.title}</h2><span class="ph-card-action">{card.label}</span></div></a>
<details class="ph-card-note"><summary>Nota de estudo</summary><p>{card.text}</p></details>
</article>)}</section>
{answers.length>0&&<section class="ph-answers"><div class="ph-answers-head"><span>RESPOSTAS CLARAS</span><h2>Para que serve esta página.</h2></div><div class="ph-answer-grid">{answers.map(item=><article><h3>{item.question}</h3><p>{item.answer}</p></article>)}</div></section>}
<section class="ph-note"><p>O arquivo profundo continua orientado por fontes: museus e bibliotecas permanecem canônicos, referências de artistas voltam aos canais originais e estudos editoriais não são apresentados como tatuagens executadas.</p><div><a href={enHref}>English →</a><a href={esHref}>Español →</a></div></section>
</main>
<RailEnhancer/>
<style>
:global(body){margin:0;background:#090909;color:#f4efe6;font-family:Manrope,Arial,sans-serif}.ph-header{position:sticky;top:0;z-index:10;display:flex;justify-content:space-between;align-items:center;padding:16px clamp(16px,5vw,70px);background:rgba(7,7,7,.92);border-bottom:1px solid rgba(240,236,227,.18);backdrop-filter:blur(14px)}.ph-header>a{font:500 1.05rem "Cormorant Garamond",serif;letter-spacing:.14em;text-decoration:none}.ph-header nav{display:flex;gap:7px}.ph-header nav a{padding:6px 9px;border:1px solid rgba(240,236,227,.18);text-decoration:none;font-size:12px}.ph-header nav a[aria-current]{border-color:#d2b477;color:#d2b477}.ph-hero{min-height:48svh;display:flex;align-items:end;padding:80px clamp(18px,6vw,90px) 55px;background:linear-gradient(180deg,#111,#090909)}.ph-hero>div{max-width:940px}.ph-hero span,.ph-grid b,.ph-answers-head span{color:#d2b477;font-size:12px;letter-spacing:.16em}.ph-hero h1{font:400 clamp(48px,8vw,100px)/.9 "Cormorant Garamond",serif;margin:16px 0;max-width:900px}.ph-hero p{max-width:760px;color:#c8c0b5;font-size:18px}.ph-topics{display:flex;gap:8px;overflow-x:auto;padding:14px clamp(18px,6vw,90px);border-block:1px solid rgba(240,236,227,.18);scrollbar-width:thin}.ph-topics a{flex:0 0 auto;padding:8px 11px;border:1px solid rgba(240,236,227,.18);color:#d2b477;text-decoration:none;font-size:12px;text-transform:uppercase}.ph-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1px;background:rgba(240,236,227,.16)}.ph-answer-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;background:rgba(240,236,227,.16)}.ph-collection-card{min-width:0;background:#0b0b0b;display:flex;flex-direction:column}.ph-card-link{display:flex;flex:1;flex-direction:column;color:inherit;text-decoration:none}.ph-card-visual{position:relative;display:grid;place-items:center;aspect-ratio:1.08;margin:0;overflow:hidden;background:#121211}.ph-card-visual img{display:block;width:100%;height:100%;object-fit:contain}.ph-card-visual figcaption{position:absolute;inset:auto 0 0;display:flex;flex-direction:column;gap:4px;padding:24px 14px 12px;background:linear-gradient(transparent,rgba(5,5,5,.92));font-size:.64rem;line-height:1.4;color:#e6dfd4}.ph-card-visual figcaption b{color:#d2b477;letter-spacing:.13em}.ph-card-copy{display:flex;flex:1;flex-direction:column;padding:18px 20px 20px}.ph-grid h2,.ph-answers-head h2{font:400 clamp(25px,2.3vw,36px)/1.02 "Cormorant Garamond",serif;margin:0 0 22px}.ph-card-action{margin-top:auto;color:#d2b477;font-size:.76rem}.ph-card-note{margin:0 20px 20px;border-top:1px solid rgba(240,236,227,.14);color:#c8c0b5;font-size:.78rem;line-height:1.55}.ph-card-note summary{padding:10px 0;cursor:pointer;color:#d2b477}.ph-card-note p{margin:0 0 14px;line-height:1.65}.ph-answer-grid article{padding:clamp(26px,5vw,60px);background:#0b0b0b}.ph-grid p,.ph-answer-grid p,.ph-note{color:#c8c0b5;line-height:1.75}.ph-note a{color:#d2b477}.ph-answers{padding:clamp(38px,6vw,78px) clamp(18px,6vw,90px);background:#0d0d0d;border-top:1px solid rgba(240,236,227,.18)}.ph-answers-head{max-width:800px;margin-bottom:26px}.ph-answer-grid h3{font:400 clamp(24px,3vw,36px)/1.08 "Cormorant Garamond",serif;margin:0 0 12px}.ph-note{padding:38px clamp(18px,6vw,90px);border-top:1px solid rgba(240,236,227,.18)}.ph-note p{max-width:920px}.ph-note div{display:flex;gap:16px}@media(max-width:1050px){.ph-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:760px){.ph-grid,.ph-answer-grid{grid-template-columns:1fr}.ph-card-visual{aspect-ratio:1.18}.ph-grid h2{font-size:clamp(30px,9vw,42px)}.ph-hero{min-height:42svh}.ph-hero h1{font-size:clamp(44px,14vw,70px)}.ph-header{padding-inline:14px}}
</style>
</body></html>
