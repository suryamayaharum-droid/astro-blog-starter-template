---
import BaseHead from './BaseHead.astro';
interface Card { kicker:string; title:string; text:string; href:string; label:string; }
interface Answer { question:string; answer:string; }
interface Props {
  lang:'en'|'es';
  title:string;
  description:string;
  kicker:string;
  heading:string;
  lead:string;
  cards:Card[];
  alternateHref:string;
  alternateLang:'en'|'es';
  alternateLabel:string;
  ptHref:string;
  topics?:string[];
  answers?:Answer[];
}
const {lang,title,description,kicker,heading,lead,cards,alternateHref,alternateLang,alternateLabel,ptHref,topics=[],answers=[]}=Astro.props;
const base=import.meta.env.BASE_URL.endsWith('/')?import.meta.env.BASE_URL:import.meta.env.BASE_URL+'/';
const homeHref=lang==='en'?base+'en/':base+'es/';
const topicNav=lang==='en'
 ? [
   {href:base+'en/references/',label:'References'},
   {href:base+'en/museums/',label:'Museums'},
   {href:base+'en/drawing/',label:'Drawing'},
   {href:base+'en/art-history/',label:'Art history'},
   {href:base+'en/brazilian-visual-culture/',label:'Brazil'},
   {href:base+'en/tattoo-salvador/',label:'Tattoo Salvador'}
 ]
 : [
   {href:base+'es/referencias/',label:'Referencias'},
   {href:base+'es/museos/',label:'Museos'},
   {href:base+'es/dibujo/',label:'Dibujo'},
   {href:base+'es/historia-del-arte/',label:'Historia'},
   {href:base+'es/cultura-visual-brasilena/',label:'Brasil'},
   {href:base+'es/tatuaje-salvador/',label:'Tatuaje Salvador'}
 ];
const hubSchema={
  '@context':'https://schema.org',
  '@type':'CollectionPage',
  name:title,
  description,
  inLanguage:lang,
  about:topics.map((name:string)=>({'@type':'Thing','name':name})),
  mainEntity:{
    '@type':'ItemList',
    numberOfItems:cards.length,
    itemListElement:cards.map((card,index)=>({
      '@type':'ListItem',
      position:index+1,
      url:new URL(card.href,Astro.site).href,
      item:{'@type':'CreativeWork','name':card.title,'description':card.text}
    }))
  }
};
---
<!doctype html><html lang={lang}><head><BaseHead title={title} description={description} locale={lang} alternates={[{hreflang:alternateLang,href:alternateHref},{hreflang:'pt-BR',href:ptHref}]}/><script type="application/ld+json" set:html={JSON.stringify(hubSchema)} /></head>
<body>
<header class="ih-header"><a href={homeHref}>HARUM NOIR</a><div class="ih-cluster" aria-label={lang==='en'?'Topics':'Temas'}>{lang==='en'?<><a href={base+'en/references/'}>References</a><a href={base+'en/museums/'}>Museums</a><a href={base+'en/drawing/'}>Drawing</a><a href={base+'en/art-history/'}>Art history</a><a href={base+'en/brazilian-visual-culture/'}>Brazil</a><a href={base+'en/tattoo-salvador/'}>Tattoo Salvador</a></>:<><a href={base+'es/referencias/'}>Referencias</a><a href={base+'es/museos/'}>Museos</a><a href={base+'es/dibujo/'}>Dibujo</a><a href={base+'es/historia-del-arte/'}>Historia</a><a href={base+'es/cultura-visual-brasilena/'}>Brasil</a><a href={base+'es/tatuaje-salvador/'}>Tatuaje Salvador</a></>}</div><nav aria-label={lang==='en'?'Languages':'Idiomas'}><a href={base}>PT</a><a href={base+'en/'} aria-current={lang==='en'?'page':undefined}>EN</a><a href={base+'es/'} aria-current={lang==='es'?'page':undefined}>ES</a></nav></header>
<main>
<section class="ih-hero"><div><span>{kicker}</span><h1>{heading}</h1><p>{lead}</p></div></section>
<nav class="ih-topics" aria-label={lang==='en'?'International topics':'Temas internacionales'}>{topicNav.map(item=><a href={item.href}>{item.label}</a>)}</nav>
<section class="ih-grid">{cards.map(card=><article><b>{card.kicker}</b><h2>{card.title}</h2><p>{card.text}</p><a href={card.href}>{card.label}</a></article>)}</section>
{answers.length>0&&<section class="ih-answers" aria-labelledby="ih-answers-title"><div class="ih-answers-head"><span>{lang==='en'?'QUICK ANSWERS':'RESPUESTAS CLARAS'}</span><h2 id="ih-answers-title">{lang==='en'?'What this archive is for.':'Para qué sirve este archivo.'}</h2></div><div class="ih-answer-grid">{answers.map(item=><article><h3>{item.question}</h3><p>{item.answer}</p></article>)}</div></section>}
<section class="ih-footnote"><p>{lang==='en'?'The deeper archive remains source-first: museum records stay canonical, artist references link back to original channels, and editorial studies are not presented as executed tattoos.':'El archivo profundo mantiene las fuentes originales: los registros de museos siguen siendo canónicos, las referencias enlazan a sus canales originales y los estudios editoriales no se presentan como tatuajes realizados.'}</p><a href={alternateHref}>{alternateLabel}</a></section>
</main>
<style>
:global(body){margin:0;background:#090909;color:#f4efe6;font-family:Manrope,Arial,sans-serif}.ih-header{position:sticky;top:0;z-index:10;display:flex;justify-content:space-between;align-items:center;padding:16px clamp(16px,5vw,70px);background:rgba(7,7,7,.92);border-bottom:1px solid rgba(240,236,227,.18);backdrop-filter:blur(14px)}.ih-header>a{font:500 1.05rem "Cormorant Garamond",serif;letter-spacing:.14em;text-decoration:none}.ih-header nav,.ih-cluster{display:flex;gap:7px;align-items:center}.ih-cluster a{font-size:12px;text-decoration:none;color:#c8c0b5}.ih-cluster a:hover,.ih-cluster a:focus-visible{color:#d2b477}.ih-header nav{display:flex;gap:7px}.ih-header nav a{padding:6px 9px;border:1px solid rgba(240,236,227,.18);text-decoration:none;font-size:12px}.ih-header nav a[aria-current]{border-color:#d2b477;color:#d2b477}.ih-hero{min-height:48svh;display:flex;align-items:end;padding:80px clamp(18px,6vw,90px) 55px;background:linear-gradient(180deg,#111,#090909)}.ih-hero>div{max-width:940px}.ih-hero span,.ih-grid b{color:#d2b477;font-size:12px;letter-spacing:.16em}.ih-hero h1{font:400 clamp(48px,8vw,100px)/.9 "Cormorant Garamond",serif;margin:16px 0;max-width:900px}.ih-hero p{max-width:760px;color:#c8c0b5;font-size:18px}.ih-topics{display:flex;gap:8px;overflow-x:auto;padding:14px clamp(18px,6vw,90px);border-top:1px solid rgba(240,236,227,.18);border-bottom:1px solid rgba(240,236,227,.18);scrollbar-width:thin}.ih-topics a{flex:0 0 auto;padding:8px 11px;border:1px solid rgba(240,236,227,.18);color:#d2b477;text-decoration:none;font-size:12px;letter-spacing:.06em;text-transform:uppercase}.ih-topics a:hover,.ih-topics a:focus-visible{border-color:#d2b477}
.ih-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;background:rgba(240,236,227,.18)}.ih-grid article{padding:clamp(28px,5vw,64px);background:#0b0b0b}.ih-grid h2{font:400 clamp(32px,4.5vw,58px)/1 "Cormorant Garamond",serif;margin:12px 0}.ih-grid p,.ih-footnote,.ih-answers p{color:#c8c0b5}.ih-grid a,.ih-footnote a{color:#d2b477}.ih-answers{padding:clamp(38px,6vw,78px) clamp(18px,6vw,90px);border-top:1px solid rgba(240,236,227,.18);background:#0d0d0d}.ih-answers-head{max-width:800px;margin-bottom:26px}.ih-answers-head span{color:#d2b477;font-size:12px;letter-spacing:.16em}.ih-answers-head h2{font:400 clamp(36px,5vw,66px)/1 "Cormorant Garamond",serif;margin:10px 0}.ih-answer-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;background:rgba(240,236,227,.14)}.ih-answer-grid article{background:#0b0b0b;padding:clamp(24px,4vw,46px)}.ih-answer-grid h3{font:400 clamp(24px,3vw,36px)/1.08 "Cormorant Garamond",serif;margin:0 0 12px}.ih-answer-grid p{line-height:1.75;margin:0}.ih-footnote{padding:38px clamp(18px,6vw,90px);border-top:1px solid rgba(240,236,227,.18)}.ih-footnote p{max-width:900px}@media(max-width:900px){.ih-cluster{display:none}}@media(max-width:760px){.ih-grid,.ih-answer-grid{grid-template-columns:1fr}.ih-hero{min-height:42svh}.ih-hero h1{font-size:clamp(44px,14vw,70px)}.ih-header{padding-inline:14px}}
</style>
</body></html>