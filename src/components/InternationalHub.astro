---
import BaseHead from './BaseHead.astro';
import RailEnhancer from './RailEnhancer.astro';
import VisualStudyCollectionRail from './VisualStudyCollectionRail.astro';
interface Card { kicker:string; title:string; text:string; href:string; label:string; }
interface Answer { question:string; answer:string; }
interface Props {
  lang:'en'|'es';
  title:string;
  description:string;
  kicker:string;
  heading:string;
  lead:string;
  cards:Card[];
  alternateHref:string;
  alternateLang:'en'|'es';
  alternateLabel:string;
  ptHref:string;
  topics?:string[];
  answers?:Answer[];
}
const {lang,title,description,kicker,heading,lead,cards,alternateHref,alternateLang,alternateLabel,ptHref,topics=[],answers=[]}=Astro.props;
const isVisualCollectionsPage=title.startsWith('Visual Collections')||title.startsWith('Colecciones Visuales');
const base=import.meta.env.BASE_URL.endsWith('/')?import.meta.env.BASE_URL:import.meta.env.BASE_URL+'/';
const homeHref=lang==='en'?base+'en/':base+'es/';
const aboutHref=lang==='en'?base+'en/about/':base+'es/acerca/';
const topicNav=lang==='en'
 ? [
   {href:base+'en/school/',label:'Open school'},
   {href:base+'en/collections/',label:'Visual collections'},
   {href:base+'en/references/',label:'References'},
   {href:base+'en/museums/',label:'Museums'},
   {href:base+'en/drawing/',label:'Drawing'},
   {href:base+'en/art-history/',label:'Art history'},
   {href:base+'en/brazilian-visual-culture/',label:'Brazil'},
   {href:base+'en/tattoo-salvador/',label:'Tattoo Salvador'}
 ]
 : [
   {href:base+'es/escuela/',label:'Escuela abierta'},
   {href:base+'es/colecciones/',label:'Colecciones visuales'},
   {href:base+'es/referencias/',label:'Referencias'},
   {href:base+'es/museos/',label:'Museos'},
   {href:base+'es/dibujo/',label:'Dibujo'},
   {href:base+'es/historia-del-arte/',label:'Historia'},
   {href:base+'es/cultura-visual-brasilena/',label:'Brasil'},
   {href:base+'es/tatuaje-salvador/',label:'Tatuaje Salvador'}
 ];

interface Visual { src:string; alt:string; caption:string; }
const atlas=(n:string,en:string,es:string,ce:string,cs:string):Visual=>({src:base+'noir/visual-atlas/'+n+'.webp',alt:lang==='en'?en:es,caption:lang==='en'?ce:cs});
const studio=(n:string,en:string,es:string,ce:string,cs:string):Visual=>({src:base+'studio23/assets/'+n,alt:lang==='en'?en:es,caption:lang==='en'?ce:cs});
const archiveVisual=atlas('brasil-acervo-editorial','AI-assisted editorial still life inspired by Brazilian visual archives; not a historical document.','Naturaleza muerta editorial con asistencia de IA, inspirada en archivos visuales brasileños; no es un documento histórico.','Conceptual editorial image · not a source record','Imagen editorial conceptual · no es un registro de fuente');
const drapery=atlas('drapery-still-life','Drapery study showing fold, weight and light.','Estudio de paños sobre pliegues, peso y luz.','Form study','Estudio de forma');
const museum=atlas('museum-gallery','Editorial gallery scene for institutional research.','Escena editorial de galería para investigar fuentes.','Editorial setting','Escena editorial');
const hands=atlas('harum-noir-hands-study','Charcoal hand studies for gesture and anatomy.','Estudios de manos al carbón para gesto y anatomía.','Gesture study','Estudio de gesto');
const sketch=atlas('open-sketchbook','Open sketchbook for drawing research.','Cuaderno abierto para investigación de dibujo.','Study notebook','Cuaderno de estudio');
const charcoal=atlas('harum-noir-caderno-estudo','A charcoal studio study with an articulated model, sketchbook, iris and folded cloth.','Un estudio de taller al carbón con modelo articulado, cuaderno, iris y tela.','Studio drawing study','Estudio de observación y materia');
const figure=atlas('figure-gesture','Four stages of a clothed figure study: action line, silhouette, structural masses and charcoal synthesis.','Cuatro etapas de una figura vestida: línea de acción, silueta, masas estructurales y síntesis al carbón.','Figure · balance · gesture','Figura · equilibrio · gesto');
const iris=atlas('iris-study','Botanical iris study in graphite and charcoal.','Estudio botánico de un iris en grafito y carbón.','Botanical study','Estudio botánico');
const tools=atlas('tools-paper','Drawing tools and paper for a source-based study.','Herramientas y papel para un estudio basado en fuentes.','Drawing materials','Materiales de dibujo');
const atelier=atlas('atelier-desk','Editorial atelier desk for Arte Harum research.','Mesa editorial de atelier para la investigación de Arte Harum.','Editorial atelier scene','Escena editorial de atelier');
const four=atlas('exercicio-quatro-decisoes','Four stages of one still life: gesture, masses, edges and selective finish.','Cuatro etapas de una naturaleza muerta: gesto, masas, bordes y acabado selectivo.','Four drawing decisions','Cuatro decisiones de dibujo');
const tattooLeaf=studio('collections/instagram/instagram-06.webp','Fine-line botanical tattoo on a forearm, from the published Studio 23 portfolio.','Tatuaje botánico de línea fina en un antebrazo, del portafolio publicado de Studio 23.','Studio 23 · published portfolio','Studio 23 · portafolio publicado');
const studioRoom=studio('collections/instagram/instagram-02.webp','Studio 23 interior with artwork on the walls.','Interior de Studio 23 con obras en las paredes.','Studio atmosphere · booking details on the linked page','Ambiente del estudio · detalles en la página de reservas');
const tattooFloral=studio('collections/instagram/instagram-08.webp','Floral tattoo composition on the body, from the published Studio 23 portfolio.','Composición floral tatuada en el cuerpo, del portafolio publicado de Studio 23.','Studio 23 · published portfolio','Studio 23 · portafolio publicado');
const tattooAnimal=studio('collections/instagram/instagram-12.webp','Animal portrait tattoo with botanical elements, from the published Studio 23 portfolio.','Tatuaje de retrato animal con elementos botánicos, del portafolio publicado de Studio 23.','Studio 23 · published portfolio','Studio 23 · portafolio publicado');
const artHistoryCollection:Visual[]=[drapery,museum,hands,sketch];
const archiveCollection:Visual[]=[museum,archiveVisual,iris,charcoal];
const drawingCollection:Visual[]=[charcoal,hands,four,tattooLeaf];
const museumCollection:Visual[]=[museum,sketch,archiveVisual,tools];
const referenceCollection:Visual[]=[hands,charcoal,drapery,sketch];
const visualCollection:Visual[]=[hands,four,charcoal,figure,sketch];
const aboutCollection:Visual[]=[atelier,charcoal,tattooLeaf,sketch];
const tattooCollection:Visual[]=[tattooLeaf,studioRoom,tattooFloral,tattooAnimal];
const collections:Record<string,Visual[]>={collections:visualCollection,colecciones:visualCollection,'art-history':artHistoryCollection,'historia-del-arte':artHistoryCollection,'brazilian-visual-culture':archiveCollection,'cultura-visual-brasilena':archiveCollection,drawing:drawingCollection,dibujo:drawingCollection,museums:museumCollection,museos:museumCollection,references:referenceCollection,referencias:referenceCollection,about:aboutCollection,acerca:aboutCollection,'tattoo-salvador':tattooCollection,'tatuaje-salvador':tattooCollection};
const routeSlug=Astro.url.pathname.split('/').filter(Boolean).slice(-1)[0]||'';
const collection=collections[routeSlug]||referenceCollection;
const visualCards=cards.map((card,index)=>({...card,visual:collection[index%collection.length]}));

const hubSchema={
  '@context':'https://schema.org',
  '@type':'CollectionPage',
  name:title,
  description,
  inLanguage:lang,
  about:topics.map((name:string)=>({'@type':'Thing','name':name})),
  mainEntity:{
    '@type':'ItemList',
    numberOfItems:cards.length,
    itemListElement:cards.map((card,index)=>({
      '@type':'ListItem',
      position:index+1,
      url:new URL(card.href,Astro.site).href,
      item:{'@type':'CreativeWork','name':card.title,'description':card.text}
    }))
  }
};
---
<!doctype html><html lang={lang}><head><BaseHead title={title} description={description} locale={lang} alternates={[{hreflang:alternateLang,href:alternateHref},{hreflang:'pt-BR',href:ptHref}]}/><script type="application/ld+json" set:html={JSON.stringify(hubSchema)} /></head>
<body>
<header class="ih-header"><a href={homeHref}>HARUM NOIR</a><div class="ih-cluster" aria-label={lang==='en'?'Topics':'Temas'}>{lang==='en'?<><a href={base+'en/collections/'}>Collections</a><a href={base+'en/references/'}>References</a><a href={base+'en/museums/'}>Museums</a><a href={base+'en/drawing/'}>Drawing</a><a href={base+'en/art-history/'}>Art history</a><a href={base+'en/brazilian-visual-culture/'}>Brazil</a><a href={base+'en/tattoo-salvador/'}>Tattoo Salvador</a></>:<><a href={base+'es/colecciones/'}>Colecciones</a><a href={base+'es/referencias/'}>Referencias</a><a href={base+'es/museos/'}>Museos</a><a href={base+'es/dibujo/'}>Dibujo</a><a href={base+'es/historia-del-arte/'}>Historia</a><a href={base+'es/cultura-visual-brasilena/'}>Brasil</a><a href={base+'es/tatuaje-salvador/'}>Tatuaje Salvador</a></>}</div><nav aria-label={lang==='en'?'Languages':'Idiomas'}><a href={ptHref} aria-label={lang==='en'?'Open original Portuguese page':'Abrir la página original en portugués'}>PT</a>{lang==='en'?<><span aria-current="page">EN</span><a href={alternateHref} lang="es">ES</a></>:<><a href={alternateHref} lang="en">EN</a><span aria-current="page">ES</span></>}</nav></header>
<main>
<section class="ih-hero"><div><span>{kicker}</span><h1>{heading}</h1><p>{lead}</p></div></section>
<nav class="ih-topics" aria-label={lang==='en'?'International topics':'Temas internacionales'}>{topicNav.map(item=><a href={item.href}>{item.label}</a>)}</nav>
<section class="ih-grid" data-collection-count={visualCards.length} aria-label={lang==='en'?'Visual collections':'Colecciones visuales'}>{visualCards.map(card=><article class="ih-collection-card">
<a class="ih-card-link" href={card.href}><figure class="ih-card-visual"><img src={card.visual.src} alt={card.visual.alt} width="1200" height="800" loading="lazy"/><figcaption><b>{card.kicker}</b><span>{card.visual.caption}</span></figcaption></figure><div class="ih-card-copy"><h2>{card.title}</h2><span class="ih-card-action">{card.label}</span></div></a>
<details class="ih-card-note"><summary>{lang==='en'?'Study note':'Nota de estudio'}</summary><p>{card.text}</p></details>
</article>)}</section>
{isVisualCollectionsPage&&<VisualStudyCollectionRail lang={lang}/>}
{answers.length>0&&<section class="ih-answers" aria-labelledby="ih-answers-title"><div class="ih-answers-head"><span>{lang==='en'?'QUICK ANSWERS':'RESPUESTAS CLARAS'}</span><h2 id="ih-answers-title">{lang==='en'?'What this archive is for.':'Para qué sirve este archivo.'}</h2></div><div class="ih-answer-grid">{answers.map(item=><article><h3>{item.question}</h3><p>{item.answer}</p></article>)}</div></section>}
<section class="ih-footnote"><p>{lang==='en'?'The deeper archive remains source-first: museum records stay canonical, artist references link back to original channels, and editorial studies are not presented as executed tattoos.':'El archivo profundo mantiene las fuentes originales: los registros de museos siguen siendo canónicos, las referencias enlazan a sus canales originales y los estudios editoriales no se presentan como tatuajes realizados.'}</p><div class="ih-footlinks"><a href={alternateHref}>{alternateLabel}</a><a href={aboutHref}>{lang==='en'?'About the ecosystem →':'Acerca del ecosistema →'}</a></div></section>
</main>
<RailEnhancer/>
<style>
:global(body){margin:0;background:#090909;color:#f4efe6;font-family:Manrope,Arial,sans-serif}.ih-header{position:sticky;top:0;z-index:10;display:flex;justify-content:space-between;align-items:center;padding:16px clamp(16px,5vw,70px);background:rgba(7,7,7,.92);border-bottom:1px solid rgba(240,236,227,.18);backdrop-filter:blur(14px)}.ih-header>a{font:500 1.05rem "Cormorant Garamond",serif;letter-spacing:.14em;text-decoration:none}.ih-header nav,.ih-cluster{display:flex;gap:7px;align-items:center}.ih-cluster a{font-size:12px;text-decoration:none;color:#c8c0b5}.ih-cluster a:hover,.ih-cluster a:focus-visible{color:#d2b477}.ih-header nav{display:flex;gap:7px}.ih-header nav a,.ih-header nav span{padding:6px 9px;border:1px solid rgba(240,236,227,.18);text-decoration:none;font-size:12px}.ih-header nav span[aria-current]{border-color:#d2b477;color:#d2b477}.ih-hero{min-height:48svh;display:flex;align-items:end;padding:80px clamp(18px,6vw,90px) 55px;background:linear-gradient(180deg,#111,#090909)}.ih-hero>div{max-width:940px}.ih-hero span,.ih-grid b{color:#d2b477;font-size:12px;letter-spacing:.16em}.ih-hero h1{font:400 clamp(48px,8vw,100px)/.9 "Cormorant Garamond",serif;margin:16px 0;max-width:900px}.ih-hero p{max-width:760px;color:#c8c0b5;font-size:18px}.ih-topics{display:flex;gap:8px;overflow-x:auto;padding:14px clamp(18px,6vw,90px);border-top:1px solid rgba(240,236,227,.18);border-bottom:1px solid rgba(240,236,227,.18);scrollbar-width:thin}.ih-topics a{flex:0 0 auto;padding:8px 11px;border:1px solid rgba(240,236,227,.18);color:#d2b477;text-decoration:none;font-size:12px;letter-spacing:.06em;text-transform:uppercase}.ih-topics a:hover,.ih-topics a:focus-visible{border-color:#d2b477}
.ih-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1px;background:rgba(240,236,227,.18);border-bottom:1px solid rgba(240,236,227,.18)}.ih-collection-card{min-width:0;background:#0b0b0b;display:flex;flex-direction:column}.ih-card-link{display:flex;flex:1;flex-direction:column;color:inherit;text-decoration:none}.ih-card-visual{position:relative;display:grid;place-items:center;aspect-ratio:1.08;margin:0;overflow:hidden;background:#121211}.ih-card-visual img{display:block;width:100%;height:100%;object-fit:contain;transition:transform .45s ease}.ih-card-link:hover .ih-card-visual img,.ih-card-link:focus-visible .ih-card-visual img{transform:scale(1.025)}.ih-card-visual figcaption{position:absolute;inset:auto 0 0;display:flex;flex-direction:column;gap:4px;padding:24px 14px 12px;background:linear-gradient(transparent,rgba(5,5,5,.92));font-size:.64rem;line-height:1.4;color:#e6dfd4}.ih-card-visual figcaption b{color:#d2b477;letter-spacing:.13em}.ih-card-copy{display:flex;flex:1;flex-direction:column;padding:18px 20px 20px}.ih-grid h2{font:400 clamp(25px,2.3vw,36px)/1.02 "Cormorant Garamond",serif;margin:0 0 22px}.ih-card-action{margin-top:auto;color:#d2b477;font-size:.76rem}.ih-card-note{margin:0 20px 20px;border-top:1px solid rgba(240,236,227,.14);color:#c8c0b5;font-size:.78rem;line-height:1.55}.ih-card-note summary{padding:10px 0;cursor:pointer;color:#d2b477}.ih-card-note p{margin:0 0 14px}.ih-footnote,.ih-answers p{color:#c8c0b5}.ih-footnote a{color:#d2b477}.ih-answers{padding:clamp(38px,6vw,78px) clamp(18px,6vw,90px);border-top:1px solid rgba(240,236,227,.18);background:#0d0d0d}.ih-answers-head{max-width:800px;margin-bottom:26px}.ih-answers-head span{color:#d2b477;font-size:12px;letter-spacing:.16em}.ih-answers-head h2{font:400 clamp(36px,5vw,66px)/1 "Cormorant Garamond",serif;margin:10px 0}.ih-answer-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;background:rgba(240,236,227,.14)}.ih-answer-grid article{background:#0b0b0b;padding:clamp(24px,4vw,46px)}.ih-answer-grid h3{font:400 clamp(24px,3vw,36px)/1.08 "Cormorant Garamond",serif;margin:0 0 12px}.ih-answer-grid p{line-height:1.75;margin:0}.ih-footnote{padding:38px clamp(18px,6vw,90px);border-top:1px solid rgba(240,236,227,.18)}.ih-footlinks{display:flex;gap:18px;flex-wrap:wrap}.ih-footnote p{max-width:900px}@media(max-width:900px){.ih-cluster{display:none}}@media(max-width:1050px){.ih-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:760px){.ih-grid,.ih-answer-grid{grid-template-columns:1fr}.ih-card-visual{aspect-ratio:1.18}.ih-grid h2{font-size:clamp(30px,9vw,42px)}.ih-hero{min-height:42svh}.ih-hero h1{font-size:clamp(44px,14vw,70px)}.ih-header{padding-inline:14px}}
@media(min-width:1051px){.ih-grid[data-collection-count="5"]{grid-template-columns:repeat(3,minmax(0,1fr))}}
</style>
</body></html>
