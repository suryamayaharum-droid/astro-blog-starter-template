---
import BaseHead from './BaseHead.astro';
interface Card { kicker:string; title:string; text:string; href:string; label:string; }
interface Props {
  lang:'en'|'es';
  title:string;
  description:string;
  kicker:string;
  heading:string;
  lead:string;
  cards:Card[];
  alternateHref:string;
  alternateLang:'en'|'es';
  alternateLabel:string;
}
const {lang,title,description,kicker,heading,lead,cards,alternateHref,alternateLang,alternateLabel}=Astro.props;
const base=import.meta.env.BASE_URL.endsWith('/')?import.meta.env.BASE_URL:import.meta.env.BASE_URL+'/';
const homeHref=lang==='en'?base+'en/':base+'es/';
---
<!doctype html><html lang={lang}><head><BaseHead title={title} description={description} locale={lang} alternates={[{hreflang:alternateLang,href:alternateHref},{hreflang:'pt-BR',href:''}]}/></head>
<body>
<header class="ih-header"><a href={homeHref}>HARUM NOIR</a><nav aria-label={lang==='en'?'Languages':'Idiomas'}><a href={base}>PT</a><a href={base+'en/'} aria-current={lang==='en'?'page':undefined}>EN</a><a href={base+'es/'} aria-current={lang==='es'?'page':undefined}>ES</a></nav></header>
<main>
<section class="ih-hero"><div><span>{kicker}</span><h1>{heading}</h1><p>{lead}</p></div></section>
<section class="ih-grid">{cards.map(card=><article><b>{card.kicker}</b><h2>{card.title}</h2><p>{card.text}</p><a href={card.href}>{card.label}</a></article>)}</section>
<section class="ih-footnote"><p>{lang==='en'?'The deeper archive remains source-first: museum records stay canonical, artist references link back to original channels, and editorial studies are not presented as executed tattoos.':'El archivo profundo mantiene las fuentes originales: los registros de museos siguen siendo canónicos, las referencias enlazan a sus canales originales y los estudios editoriales no se presentan como tatuajes realizados.'}</p><a href={alternateHref}>{alternateLabel}</a></section>
</main>
<style>
:global(body){margin:0;background:#090909;color:#f4efe6;font-family:Manrope,Arial,sans-serif}.ih-header{position:sticky;top:0;z-index:10;display:flex;justify-content:space-between;align-items:center;padding:16px clamp(16px,5vw,70px);background:rgba(7,7,7,.92);border-bottom:1px solid rgba(240,236,227,.18);backdrop-filter:blur(14px)}.ih-header>a{font:500 1.05rem "Cormorant Garamond",serif;letter-spacing:.14em;text-decoration:none}.ih-header nav{display:flex;gap:7px}.ih-header nav a{padding:6px 9px;border:1px solid rgba(240,236,227,.18);text-decoration:none;font-size:12px}.ih-header nav a[aria-current]{border-color:#d2b477;color:#d2b477}.ih-hero{min-height:48svh;display:flex;align-items:end;padding:80px clamp(18px,6vw,90px) 55px;background:linear-gradient(180deg,#111,#090909)}.ih-hero>div{max-width:940px}.ih-hero span,.ih-grid b{color:#d2b477;font-size:12px;letter-spacing:.16em}.ih-hero h1{font:400 clamp(48px,8vw,100px)/.9 "Cormorant Garamond",serif;margin:16px 0;max-width:900px}.ih-hero p{max-width:760px;color:#c8c0b5;font-size:18px}.ih-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;background:rgba(240,236,227,.18)}.ih-grid article{padding:clamp(28px,5vw,64px);background:#0b0b0b}.ih-grid h2{font:400 clamp(32px,4.5vw,58px)/1 "Cormorant Garamond",serif;margin:12px 0}.ih-grid p,.ih-footnote{color:#c8c0b5}.ih-grid a,.ih-footnote a{color:#d2b477}.ih-footnote{padding:38px clamp(18px,6vw,90px);border-top:1px solid rgba(240,236,227,.18)}.ih-footnote p{max-width:900px}@media(max-width:760px){.ih-grid{grid-template-columns:1fr}.ih-hero{min-height:42svh}.ih-hero h1{font-size:clamp(44px,14vw,70px)}.ih-header{padding-inline:14px}}
</style>
</body></html>