---
import { ecosystemHubs } from '../data/ecosystem';
const { current="", limit=4, title="Continue pelo ecossistema", kicker="PRÓXIMAS PORTAS" } = Astro.props;
const base=import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const maxItems=Number(limit)||4;
const currentIndex=ecosystemHubs.findIndex(item=>item.id===current);
const ordered=currentIndex>=0 ? [...ecosystemHubs.slice(currentIndex+1),...ecosystemHubs.slice(0,currentIndex)] : ecosystemHubs;
const items=ordered.filter(item=>item.id!==current).slice(0,maxItems);
---
<section class="section">
  <div class="section-head">
    <div><div class="eyebrow">{kicker}</div><h2>{title}</h2></div>
    <p>Escolha uma próxima etapa. Cada porta leva a uma página com uma pergunta de estudo clara.</p>
  </div>
  <div class="rail ecosystem-rail" aria-label="Próximas páginas do HARUM NOIR">
    {items.map(item=><a class="card ecosystem-card" href={base+item.href}>
      <div class="ecosystem-cover"><img src={base+'noir/visual-atlas/'+item.cover+'.webp'} alt="" width="640" height="400" loading="lazy"/></div>
      <div class="card-body"><span class="card-kicker">{item.kicker}</span><h3>{item.title}</h3><p>{item.description}</p><b>Entrar <span aria-hidden="true">↗</span></b></div>
    </a>)}
  </div>
</section>
<style>
.ecosystem-rail .ecosystem-card{overflow:hidden;text-decoration:none;color:inherit;min-width:0}.ecosystem-cover{aspect-ratio:16/9;overflow:hidden;background:#151515}.ecosystem-cover img{display:block;width:100%;height:100%;object-fit:cover;filter:saturate(.58);transition:transform .25s}.ecosystem-card:hover .ecosystem-cover img{transform:scale(1.035)}.ecosystem-card .card-body{display:flex;flex-direction:column;min-height:190px}.ecosystem-card h3{margin:8px 0}.ecosystem-card p{font-size:.84rem;line-height:1.55}.ecosystem-card .card-body>b{display:flex;justify-content:space-between;margin-top:auto;padding-top:12px;color:var(--gold);font-size:.75rem}@media(prefers-reduced-motion:reduce){.ecosystem-cover img{transition:none}.ecosystem-card:hover .ecosystem-cover img{transform:none}}
</style>