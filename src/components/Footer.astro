---
import { HARUM_YOUTUBE, STUDIO_INSTAGRAM, STUDIO_SITE, STUDIO_NOIR } from '../consts';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="footer-main">
    <div>
      <img src={`${base}noir/mark.svg`} alt="" width="42" height="42" />
      <p class="footer-title">HARUM NOIR</p>
      <p class="footer-copy">Um ateliê editorial sobre desenho, observação e presença.</p>
    </div>
    <div class="footer-links">
      <a href={`${base}referencias`}>Referências</a>
      <a href={`${base}cadernos`}>Cadernos</a>
      <a href={`${base}atelier`}>Ateliê</a>
      <a href={`${base}carta`}>Carta</a>
      <a href={HARUM_YOUTUBE} target="_blank" rel="noreferrer">YouTube ↗</a>
      <a href={STUDIO_INSTAGRAM} target="_blank" rel="noreferrer">Studio 23 ↗</a>
      <a href={STUDIO_NOIR} target="_blank" rel="noreferrer">Harum Noir no Studio 23 ↗</a>
      <a href={STUDIO_SITE} target="_blank" rel="noreferrer">Site principal ↗</a>
    </div>
  </div>
  <div class="footer-bottom">
    <span>© {year} Harum Noir</span>
    <span>Salvador · Bahia</span>
  </div>
</footer>
