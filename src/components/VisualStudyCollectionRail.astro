---
import { visualStudyCollection } from '../data/visualStudyCollection';

interface Props {
  lang?: 'pt'|'en'|'es';
}

const {lang='pt'}=Astro.props;
const base=import.meta.env.BASE_URL.endsWith('/')?import.meta.env.BASE_URL:import.meta.env.BASE_URL+'/';
const copy={
  pt:{kicker:'COLEÇÃO EDITORIAL · 05 PRANCHAS',title:'Arquivo, natureza, mar e valor.',intro:'Composições de estudo que ampliam o repertório visual. Cada prancha tem um tema próprio e permanece identificada como imagem editorial, separada das obras e documentos dos acervos.',aria:'Carrossel da coleção editorial de estudos HARUM NOIR',roleDescription:'carrossel'},
  en:{kicker:'EDITORIAL STUDY COLLECTION · 05 PLATES',title:'Archive, nature, sea and value.',intro:'Study compositions that expand the visual repertoire. Each plate has its own theme and remains identified as editorial imagery, separate from collection artworks and documents.',aria:'HARUM NOIR editorial study collection carousel',roleDescription:'carousel'},
  es:{kicker:'COLECCIÓN EDITORIAL · 05 LÁMINAS',title:'Archivo, naturaleza, mar y valor.',intro:'Composiciones de estudio que amplían el repertorio visual. Cada lámina tiene un tema propio y se identifica como imagen editorial, separada de las obras y documentos de los acervos.',aria:'Carrusel de la colección editorial de estudios HARUM NOIR',roleDescription:'carrusel'},
}[lang];
---
<section class="visual-study-collection" aria-labelledby="visual-study-title">
  <div class="visual-study-heading"><div><span>{copy.kicker}</span><h2 id="visual-study-title">{copy.title}</h2></div><p>{copy.intro}</p></div>
  <div class="visual-study-rail browse-rail" role="region" aria-roledescription={copy.roleDescription} tabindex="0" aria-label={copy.aria}>
    {visualStudyCollection.map((study)=><a class="visual-study-card browse-tile" href={base+(lang==='pt'?study.href:study[lang]!.href)}>
      <figure><img src={base+study.file} alt={lang==='pt'?study.alt:study[lang]!.alt} width="900" height="600" loading="lazy" decoding="async"/><figcaption><span>{lang==='pt'?study.theme:study[lang]!.theme}</span><small>{lang==='pt'?study.caption:study[lang]!.caption}</small></figcaption></figure>
      <div class="visual-study-card-copy"><h3>{lang==='pt'?study.title:study[lang]!.title}</h3><span>{lang==='pt'?study.link:study[lang]!.link} <b aria-hidden="true">↗</b></span></div>
    </a>)}
  </div>
</section>

<style>
.visual-study-collection{padding:clamp(34px,5vw,66px) 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.visual-study-heading{display:flex;justify-content:space-between;align-items:end;gap:24px;margin-bottom:19px}.visual-study-heading>div>span{color:var(--gold);font-size:.67rem;letter-spacing:.16em}.visual-study-heading h2{font-size:clamp(2rem,4vw,3.5rem);line-height:1;margin:8px 0}.visual-study-heading p{max-width:520px;margin:0;color:var(--paper-2);font-size:.84rem;line-height:1.6}
.visual-study-rail{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(265px,330px);gap:10px;overflow-x:auto;padding:4px 2px 17px;scroll-snap-type:x proximity;scrollbar-width:none}.visual-study-rail::-webkit-scrollbar{display:none}.visual-study-card{display:block;padding:0;min-width:0;color:inherit;text-decoration:none;scroll-snap-align:start;border:1px solid var(--line);border-radius:14px;overflow:hidden;background:linear-gradient(145deg,#151517,#0c0c0d);transition:transform .18s,border-color .18s}.visual-study-card:hover{transform:translateY(-2px);border-color:rgba(179,154,105,.45)}.visual-study-card:focus-visible{outline:2px solid var(--gold);outline-offset:3px}.visual-study-card figure{position:relative;aspect-ratio:3/2;margin:0;overflow:hidden;background:#111}.visual-study-card figure img{width:100%;height:100%;object-fit:cover;filter:saturate(.55);transition:transform .3s ease}.visual-study-card:hover figure img{transform:scale(1.035)}.visual-study-card figcaption{position:absolute;inset:auto 0 0;display:grid;gap:4px;padding:28px 13px 10px;background:linear-gradient(transparent,rgba(7,7,7,.94));color:var(--paper)}.visual-study-card figcaption span{font-size:.67rem;letter-spacing:.1em;text-transform:uppercase;color:#e0c990}.visual-study-card figcaption small{font-size:.61rem;line-height:1.35;color:#d4ccbe}.visual-study-card-copy{padding:12px 14px 14px}.visual-study-card-copy h3{font-size:1.35rem;line-height:1.08;margin:0 0 12px}.visual-study-card-copy>span{display:flex;justify-content:space-between;gap:10px;padding-top:10px;border-top:1px solid var(--line);color:var(--gold);font-size:.72rem}.visual-study-card-copy b{font-size:1rem}
@media(max-width:760px){.visual-study-heading{align-items:flex-start;flex-direction:column;gap:8px}.visual-study-rail{grid-auto-columns:78vw}}
@media(prefers-reduced-motion:reduce){.visual-study-card figure img{transition:none}.visual-study-card:hover figure img{transform:none}}
</style>
