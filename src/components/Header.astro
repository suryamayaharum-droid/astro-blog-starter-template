---
import { STUDIO_SITE } from '../consts';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const primaryPaths = new Set(["escola","atlas","percursos","cadernos","atelier"]);
const links = [
  ["Escola","escola"],
  ["Buscar","busca"],
  ["Atlas","atlas"],
  ["Radar","radar"],
  ["Referências","referencias"],
  ["Percursos","percursos"],
  ["Cadernos","cadernos"],
  ["Mãos","maos"],
  ["Corpo","corpo-em-relacao"],
  ["Cabeça","cabeca-expressao"],
  ["Coleções","colecoes"],
  ["Biblioteca","biblioteca"],
  ["História","historia-da-arte"],
  ["Bancos","bancos"],
  ["Museus","museus"],
  ["Ateliê","atelier"],
  ["Temporadas","temporadas"],
  ["Carta","carta"],
  ["Arquivo","arquivo"],
  ["Sobre","sobre"],
];
---
<header class="site-header">
  <nav class="site-nav" aria-label="Navegação principal">
    <a class="brand-lockup" href={base} aria-label="Harum Noir — início" data-astro-prefetch>
      <img src={`${base}noir/mark.svg`} alt="" width="36" height="36" />
      <span>
        <b>HARUM NOIR</b>
        <small>traço · corpo · presença</small>
      </span>
    </a>
    <div class="nav-links">
      {links.filter(([,path])=>primaryPaths.has(path)).map(([label,path]) => <a href={`${base}${path}`} data-astro-prefetch>{label}</a>)}
      <a href={STUDIO_SITE} target="_blank" rel="noreferrer">Studio 23 ↗</a>
      <span class="locale-inline" aria-label="Idiomas"><a href={base}>PT</a><a href="https://translate.google.com/translate?sl=pt&amp;tl=en" data-google-translate="en" aria-label="Abrir esta página em inglês com o Google Tradutor">EN ↗</a><a href="https://translate.google.com/translate?sl=pt&amp;tl=es" data-google-translate="es" aria-label="Abrir esta página em espanhol com o Google Tradutor">ES ↗</a></span>
    </div>
    <details class="explore-menu">
      <summary>Explorar <span aria-hidden="true">＋</span></summary>
      <nav class="explore-panel" aria-label="Explorar o ecossistema">
        <span class="explore-title">O ateliê inteiro</span>
        {links.map(([label,path])=><a href={`${base}${path}`} data-astro-prefetch>{label}</a>)}
        <a href={STUDIO_SITE} target="_blank" rel="noreferrer">Studio 23 ↗</a>
        <span class="explore-title locale-title">Idiomas · Languages</span>
        <a href={base} data-astro-prefetch>Português</a><a href="https://translate.google.com/translate?sl=pt&amp;tl=en" data-google-translate="en" aria-label="Traduzir esta página para inglês">English · Google ↗</a><a href="https://translate.google.com/translate?sl=pt&amp;tl=es" data-google-translate="es" aria-label="Traduzir esta página para espanhol">Español · Google ↗</a>
      </nav>
    </details>
    <button class="save-current" id="save-current" type="button">＋ Estante</button>
  </nav>
</header>
<nav class="mobile-dock" aria-label="Navegação móvel">
  <a href={base} data-astro-prefetch="tap"><b>⌂</b>Início</a>
  <a href={base+'escola'} data-astro-prefetch="tap"><b>✎</b>Escola</a>
  <a href={base+'percursos'} data-astro-prefetch="tap"><b>↗</b>Percursos</a>
  <a href={base+'cadernos'} data-astro-prefetch="tap"><b>Ⅲ</b>Cadernos</a>
  <a href={base+'busca'} data-astro-prefetch="tap"><b>⌕</b>Buscar</a>
</nav>

<script>
try{
  const full=location.pathname+location.search;
  const rootPath=new URL(document.querySelector('.brand-lockup')?.href||location.href).pathname;
  const home=location.pathname===rootPath;
  if(!home){
    const k='harum_noir_recent';
    const item={path:full,title:document.title||'HARUM NOIR',visitedAt:Date.now()};
    let xs=[];try{xs=JSON.parse(localStorage.getItem(k)||'[]')}catch{}
    xs=[item,...(Array.isArray(xs)?xs:[]).filter(x=>x&&x.path!==item.path)].slice(0,12);
    try{localStorage.setItem(k,JSON.stringify(xs))}catch{}
  }
  document.querySelectorAll<HTMLAnchorElement>('[data-google-translate]').forEach((a)=>{
    const translate=new URL('https://translate.google.com/translate');
    translate.searchParams.set('sl','pt');
    translate.searchParams.set('tl',a.dataset.googleTranslate||'en');
    translate.searchParams.set('u',window.location.href);
    a.href=translate.href;
    a.target='_blank';
    a.rel='noopener noreferrer';
  });
  document.querySelectorAll('.nav-links a,.mobile-dock a,.explore-panel a').forEach((a)=>{
    if(!(a instanceof HTMLAnchorElement)) return;
    const target=new URL(a.href,location.href);
    const sameOrigin=target.origin===location.origin;
    const targetPath=target.pathname.replace(/\/$/,'');
    const currentPath=location.pathname.replace(/\/$/,'');
    const active=sameOrigin&&(currentPath===targetPath||(targetPath&&targetPath!==rootPath.replace(/\/$/,'')&&currentPath.startsWith(targetPath+'/')));
    if(active){a.setAttribute('aria-current','page');a.classList.add('is-current')}
  });
  const b=document.querySelector('#save-current');
  if(b){
    if(home){b.style.display='none'}
    else{
      const key='harum_noir_shelf';
      const read=()=>{try{const x=JSON.parse(localStorage.getItem(key)||'[]');return Array.isArray(x)?x:[]}catch{return[]}};
      const paint=()=>{const on=read().some(x=>x&&x.path===full);b.textContent=on?'✓ Na estante':'＋ Estante';b.classList.toggle('saved',on)};
      paint();
      b.addEventListener('click',()=>{
        let xs=read();const on=xs.some(x=>x&&x.path===full);
        xs=on?xs.filter(x=>x&&x.path!==full):[{path:full,title:document.title||'HARUM NOIR',savedAt:Date.now()},...xs.filter(x=>x&&x.path!==full)].slice(0,24);
        try{localStorage.setItem(key,JSON.stringify(xs));paint();window.dispatchEvent(new Event('harum-noir-shelf'))}catch{b.textContent='Estante indisponível';b.setAttribute('aria-label','Não foi possível salvar neste navegador');}
      });
    }
  }
}catch{}
</script>
<style>
.explore-menu{position:relative;flex:0 0 auto}
.explore-menu summary{list-style:none;cursor:pointer;padding:8px 12px;border:1px solid var(--line);border-radius:999px;font-size:.78rem;color:var(--paper)}
.explore-menu summary::-webkit-details-marker{display:none}
.explore-menu summary span{color:var(--gold);margin-left:8px}
.explore-menu[open] summary{border-color:var(--gold-dim)}
.explore-panel{position:absolute;right:0;top:calc(100% + 14px);width:min(440px,calc(100vw - 32px));display:grid;grid-template-columns:1fr 1fr;gap:4px;padding:20px;background:#111214;border:1px solid var(--line);border-radius:20px;box-shadow:var(--shadow);max-height:calc(100dvh - 150px);overflow:auto}
.explore-title{grid-column:1/-1;color:var(--gold);font-size:.65rem;letter-spacing:.15em;text-transform:uppercase;padding:0 10px 12px}
.explore-panel a{padding:10px;border-radius:8px;text-decoration:none;font-size:.85rem;color:var(--paper-2)}
.explore-panel a:hover,.explore-panel a[aria-current]{background:rgba(179,154,105,.1);color:var(--paper)}
.locale-inline{display:inline-flex;gap:4px;margin-left:4px}.locale-inline a{font-size:.66rem;padding:4px 6px;border:1px solid var(--line);border-radius:999px}.locale-inline a:hover{border-color:var(--gold);color:var(--gold)}
@media(max-width:760px){.locale-inline{display:none}.explore-menu{margin-left:auto}.explore-menu summary{font-size:.72rem;padding:7px 10px}.explore-panel{position:fixed;left:16px;right:16px;top:64px;width:auto}.explore-panel a{font-size:.9rem}}
</style>
