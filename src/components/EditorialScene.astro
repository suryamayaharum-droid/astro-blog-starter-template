---
const {image,alt}=Astro.props;
const base=import.meta.env.BASE_URL.endsWith('/')?import.meta.env.BASE_URL:import.meta.env.BASE_URL+'/';
---
<figure class="editorial-scene"><img src={base+'noir/visual-atlas/'+image+'.webp'} alt={alt} width="640" height="640"/><figcaption>Composição temática criada com assistência de IA; não representa obra de acervo.</figcaption></figure>
<style>
.editorial-scene{margin:0;min-width:0}.editorial-scene img{width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:4px;filter:saturate(.5)}
.editorial-scene figcaption{color:var(--muted);font-size:.65rem;line-height:1.5;margin-top:10px;max-width:48ch}
@media(max-width:760px){.editorial-scene img{aspect-ratio:16/9}}
</style>
