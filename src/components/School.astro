---
import BaseHead from './BaseHead.astro';
import Header from './Header.astro';
interface Props { lang?: 'pt'|'en'|'es'; }
const {lang='pt'} = Astro.props as Props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const copy = {
  pt: {
    locale:'pt-BR', pageTitle:'Escola Aberta de Desenho · HARUM NOIR', description:'Uma escola aberta para estudar desenho por quatro movimentos: observar, estruturar, organizar e traduzir.',
    language:'Idiomas', heroKicker:'HARUM NOIR · ESCOLA ABERTA DE DESENHO', heroTitle:'Aprender a olhar muda o desenho.', heroLead:'Um plano de estudo aberto, feito para sair da imagem e voltar ao papel. Sem conta, sem pressa e sem promessa de atalho.', heroAlt:'Caderno, lápis e tecido iluminados em uma natureza-morta editorial para estudo de desenho.',
    start:'Fazer a primeira prática', map:'Ver os quatro movimentos', courseLabel:'PLANO DE ESTUDO', mapTitle:'Um método que cabe na mão.', mapLead:'Comece pela observação. Depois construa, compare e faça uma escolha sua.',
    firstKicker:'PRIMEIRA PRÁTICA · 12 MINUTOS', firstTitle:'Uma imagem, quatro decisões.', firstLead:'Abra uma referência de museu ou use uma imagem à sua volta. Faça quatro estudos pequenos, sem tentar terminar uma obra.',
    exercise:['1 min · Escolha uma pergunta: onde está o maior peso?','3 min · Marque linha de ação, silhueta e três massas grandes.','5 min · Compare uma borda nítida com outra que pode desaparecer.','3 min · Escreva o que mudou quando simplificou e faça um último desenho.'],
    exerciseLink:'Escolher uma referência no acervo →', exerciseHref:'museums', fundamentals:'FUNDAMENTOS', progressTitle:'Seu progresso de estudo', progressLead:'Marque as práticas que você concluiu. O avanço fica salvo apenas neste aparelho.', progressA11y:'Progresso das práticas de desenho', progressDone:'práticas marcadas', clear:'Limpar progresso',
    tasks:['Escolhi uma imagem e escrevi uma pergunta visual.','Fiz um estudo de gesto sem contornar os detalhes.','Comparei duas referências pelo peso ou pela luz.','Voltei ao papel e fiz uma decisão própria.'],
    footer:'HARUM NOIR · Salvador, Bahia', home:'Início', routes:'Percursos', references:'Referências', museums:'Museus'
  },
  en: {
    locale:'en', pageTitle:'Open Drawing School · HARUM NOIR', description:'An open drawing school built around four steps: observe, structure, organize and translate.',
    language:'Languages', heroKicker:'HARUM NOIR · OPEN DRAWING SCHOOL', heroTitle:'Learning to look changes the drawing.', heroLead:'An open study plan that moves from an image back to the page. No account, no rush and no shortcut promises.', heroAlt:'A sketchbook, pencil and draped cloth lit as an editorial still life for drawing study.',
    start:'Try the first exercise', map:'See the four steps', courseLabel:'STUDY PLAN', mapTitle:'A method you can put to work.', mapLead:'Begin with observation. Then build, compare and make a choice of your own.',
    firstKicker:'FIRST EXERCISE · 12 MINUTES', firstTitle:'One image, four decisions.', firstLead:'Open a museum reference or use an image around you. Make four small studies without trying to finish a work.',
    exercise:['1 min · Choose a question: where is the greatest weight?','3 min · Mark the action line, silhouette and three large masses.','5 min · Compare one sharp edge with another that can disappear.','3 min · Note what changed when you simplified, then draw once more.'],
    exerciseLink:'Choose a museum reference →', exerciseHref:'museums', fundamentals:'FOUNDATIONS', progressTitle:'Your study progress', progressLead:'Mark the practices you have completed. Progress is saved only on this device.', progressA11y:'Drawing practice progress', progressDone:'practices marked', clear:'Clear progress',
    tasks:['Choose an image and write one visual question.','Make a gesture study without outlining details.','Compare two references by weight or light.','Return to the page and make one choice of your own.'],
    footer:'HARUM NOIR · Salvador, Bahia', home:'Home', routes:'Drawing practice', references:'References', museums:'Museums'
  },
  es: {
    locale:'es', pageTitle:'Escuela Abierta de Dibujo · HARUM NOIR', description:'Una escuela abierta de dibujo organizada en cuatro pasos: observar, estructurar, organizar y traducir.',
    language:'Idiomas', heroKicker:'HARUM NOIR · ESCUELA ABIERTA DE DIBUJO', heroTitle:'Aprender a mirar cambia el dibujo.', heroLead:'Un plan de estudio abierto que sale de la imagen y vuelve al papel. Sin cuenta, sin prisa y sin promesas de atajos.', heroAlt:'Cuaderno, lápiz y tela iluminados en una naturaleza muerta editorial para estudiar dibujo.',
    start:'Probar el primer ejercicio', map:'Ver los cuatro pasos', courseLabel:'PLAN DE ESTUDIO', mapTitle:'Un método para poner en práctica.', mapLead:'Empieza por observar. Después construye, compara y toma una decisión propia.',
    firstKicker:'PRIMER EJERCICIO · 12 MINUTOS', firstTitle:'Una imagen, cuatro decisiones.', firstLead:'Abre una referencia de museo o usa una imagen de tu entorno. Haz cuatro estudios pequeños sin intentar terminar una obra.',
    exercise:['1 min · Elige una pregunta: ¿dónde está el mayor peso?','3 min · Marca línea de acción, silueta y tres masas grandes.','5 min · Compara un borde nítido con otro que puede desaparecer.','3 min · Anota qué cambió al simplificar y dibuja una vez más.'],
    exerciseLink:'Elegir una referencia de museo →', exerciseHref:'museums', fundamentals:'FUNDAMENTOS', progressTitle:'Tu progreso de estudio', progressLead:'Marca las prácticas que completaste. El avance se guarda solo en este dispositivo.', progressA11y:'Progreso de las prácticas de dibujo', progressDone:'prácticas marcadas', clear:'Borrar progreso',
    tasks:['Elige una imagen y escribe una pregunta visual.','Haz un estudio del gesto sin contornear los detalles.','Compara dos referencias por el peso o la luz.','Vuelve al papel y toma una decisión propia.'],
    footer:'HARUM NOIR · Salvador, Bahía', home:'Inicio', routes:'Práctica de dibujo', references:'Referencias', museums:'Museos'
  }
};
const c = copy[lang];
const routes = {
  pt:{home:'',school:'escola/',museums:'museus/',hands:'maos/',notebooks:'cadernos/',sketchbooks:'sketchbooks/',pathways:'percursos/',references:'referencias/',practice:'escola/#primeira-pratica'},
  en:{home:'en/',school:'en/school/',museums:'en/museums/',hands:'en/drawing/',notebooks:'en/references/',sketchbooks:'en/drawing/',pathways:'en/drawing/',references:'en/references/',practice:'en/school/#primeira-pratica'},
  es:{home:'es/',school:'es/escuela/',museums:'es/museos/',hands:'es/dibujo/',notebooks:'es/referencias/',sketchbooks:'es/dibujo/',pathways:'es/dibujo/',references:'es/referencias/',practice:'es/escuela/#primeira-pratica'}
};
const to = (key:string) => base + routes[lang][key as keyof typeof routes.pt];
const steps = [
  {n:'01',title:lang==='pt'?'Observar':lang==='en'?'Observe':'Observar',tag:lang==='pt'?'ESCOLHER':lang==='en'?'CHOOSE':'ELEGIR',text:lang==='pt'?'Escolha uma referência e descubra o que pede atenção.':lang==='en'?'Choose a reference and notice what deserves attention.':'Elige una referencia y descubre qué merece atención.',image:'museum-gallery',alt:lang==='pt'?'Galeria de museu para observar imagens.':lang==='en'?'Museum gallery for looking closely at images.':'Galería de museo para observar imágenes.',link:lang==='pt'?'Abrir Museus':lang==='en'?'Open Museums':'Abrir Museos',href:'museums'},
  {n:'02',title:lang==='pt'?'Estruturar':lang==='en'?'Structure':'Estructurar',tag:lang==='pt'?'CONSTRUIR':lang==='en'?'BUILD':'CONSTRUIR',text:lang==='pt'?'Leia gesto, silhueta, peso e as massas principais.':lang==='en'?'Read the gesture, silhouette, weight and main shapes.':'Lee el gesto, la silueta, el peso y las masas principales.',image:'harum-noir-hands-study',alt:lang==='pt'?'Estudos de mãos em quatro gestos, desenhados a carvão.':lang==='en'?'Four charcoal studies of hands in different gestures.':'Cuatro estudios de manos en distintos gestos, dibujados al carbón.',link:lang==='pt'?'Estudar desenho':lang==='en'?'Study drawing':'Estudiar dibujo',href:'hands'},
  {n:'03',title:lang==='pt'?'Organizar':lang==='en'?'Organize':'Organizar',tag:lang==='pt'?'COMPARAR':lang==='en'?'COMPARE':'COMPARAR',text:lang==='pt'?'Compare fontes no caderno e guarde uma descoberta.':lang==='en'?'Compare sources in a notebook and keep one discovery.':'Compara fuentes en un cuaderno y conserva un hallazgo.',image:'open-sketchbook',alt:lang==='pt'?'Caderno aberto para organizar observações visuais.':lang==='en'?'An open sketchbook for organizing visual observations.':'Cuaderno abierto para organizar observaciones visuales.',link:lang==='pt'?'Abrir cadernos':lang==='en'?'Compare references':'Comparar referencias',href:'notebooks'},
  {n:'04',title:lang==='pt'?'Traduzir':lang==='en'?'Translate':'Traducir',tag:lang==='pt'?'DECIDIR':lang==='en'?'DECIDE':'DECIDIR',text:lang==='pt'?'Volte ao papel e tome uma decisão visual sua.':lang==='en'?'Return to the page and make a visual decision of your own.':'Vuelve al papel y toma una decisión visual propia.',image:'harum-noir-caderno-estudo',alt:lang==='pt'?'Estudo editorial de ateliê com carvão, modelo articulado, caderno e tecido.':lang==='en'?'Editorial charcoal studio study with an articulated model, sketchbook and drapery.':'Estudio editorial de taller al carbón con modelo articulado, cuaderno y tela.',link:lang==='pt'?'Seguir um percurso':lang==='en'?'Return to the practice':'Volver a la práctica',href:lang==='pt'?'pathways':'practice'}
];
const alternates=[{hreflang:'pt-BR',href:'escola/'},{hreflang:'en',href:'en/school/'},{hreflang:'es',href:'es/escuela/'}];
---
<!doctype html>
<html lang={c.locale}>
<head><BaseHead title={c.pageTitle} description={c.description} locale={lang==='pt'?undefined:lang} alternates={alternates}/></head>
<body>
{lang==='pt' ? <Header/> : <header class="school-intl-header"><a href={to('home')}>HARUM NOIR</a><nav aria-label={c.language}><a href={base}>PT</a><a href={base+'en/school/'} aria-current={lang==='en'?'page':undefined}>EN</a><a href={base+'es/escuela/'} aria-current={lang==='es'?'page':undefined}>ES</a></nav></header>}
{lang!=='pt' && <nav class="mobile-dock school-intl-dock" aria-label={c.language}>
  <a href={to('home')}><b>⌂</b>{c.home}</a>
  <a href={to('school')} aria-current="page"><b>✎</b>{lang==='en'?'School':'Escuela'}</a>
  <a href={to('pathways')}><b>↗</b>{c.routes}</a>
  <a href={to('references')}><b>▤</b>{c.references}</a>
  <a href={to('museums')}><b>◉</b>{c.museums}</a>
</nav>}
<main class="school-page">
  <section class="school-hero">
    <figure class="school-hero-art"><img src={base+'noir/visual-atlas/harum-noir-escola-hero.webp'} alt={c.heroAlt} width="1200" height="485" fetchpriority="high"/><figcaption>{lang==='pt'?'Cenário editorial criado com assistência de IA':lang==='en'?'Editorial scene created with AI assistance':'Escena editorial creada con asistencia de IA'}</figcaption></figure>
    <div class="school-hero-copy"><span class="school-kicker">{c.heroKicker}</span><h1>{c.heroTitle}</h1><p>{c.heroLead}</p><div class="school-actions"><a class="school-primary" href="#primeira-pratica">{c.start} <span aria-hidden="true">↗</span></a><a href="#fundamentos">{c.map}</a></div></div>
  </section>
  <section class="school-section" id="fundamentos" aria-labelledby="school-map-title">
    <div class="school-section-head"><div><span class="school-kicker">{c.courseLabel}</span><h2 id="school-map-title">{c.mapTitle}</h2></div><p>{c.mapLead}</p></div>
    <div class="school-steps">{steps.map(step=><a class="school-step" href={to(step.href)}>
      <div class="school-step-art"><img src={base+'noir/visual-atlas/'+step.image+'.webp'} alt={step.alt} width="900" height="600" loading="lazy"/><span>{step.n}</span></div>
      <div class="school-step-copy"><small>{step.tag}</small><h3>{step.title}</h3><p>{step.text}</p><b>{step.link} <span aria-hidden="true">↗</span></b></div>
    </a>)}</div>
  </section>
  <section class="school-practice" id="primeira-pratica" aria-labelledby="first-practice-title">
    <div class="school-practice-copy"><span class="school-kicker">{c.firstKicker}</span><h2 id="first-practice-title">{c.firstTitle}</h2><p>{c.firstLead}</p>
      <figure class="school-exercise-visual">
        <img src={base+'noir/visual-atlas/exercicio-quatro-decisoes.webp'} alt={lang==='pt'?'Prancha em quatro etapas: linha de gesto, massas de valor, bordas e estudo seletivo de uma pera e um tecido.':lang==='en'?'Four stages of a pear and draped cloth study: gesture, value masses, edges and selective finish.':'Cuatro etapas de estudio de una pera y una tela: gesto, masas de valor, bordes y acabado selectivo.'} width="1536" height="1024" loading="lazy"/>
        <figcaption>{lang==='pt'?'Prancha didática criada com assistência de IA; demonstra decisões de desenho, não uma obra histórica.':lang==='en'?'Didactic plate created with AI assistance; it demonstrates drawing decisions, not a historical artwork.':'Lámina didáctica creada con asistencia de IA; muestra decisiones de dibujo, no una obra histórica.'}</figcaption>
      </figure>
      <ol>{c.exercise.map(item=><li>{item}</li>)}</ol><a class="school-text-link" href={to(c.exerciseHref)}>{c.exerciseLink}</a>
    </div>
    <aside class="school-progress" aria-labelledby="school-progress-title">
      <span class="school-kicker">{c.fundamentals}</span><h2 id="school-progress-title">{c.progressTitle}</h2><p>{c.progressLead}</p>
      <div class="school-progress-label"><span class="school-progress-count">0 / {c.tasks.length} {c.progressDone}</span><span class="school-progress-percent">0%</span></div>
      <div class="school-progress-track" role="progressbar" aria-label={c.progressA11y} aria-valuemin="0" aria-valuemax={c.tasks.length} aria-valuenow="0"><span></span></div>
      <div class="school-task-list">{c.tasks.map((task,i)=><label class="school-task"><input type="checkbox" data-school-task={'task-'+(i+1)}/><span>{task}</span></label>)}</div>
      <button class="school-clear" type="button">{c.clear}</button>
    </aside>
  </section>
</main>
<footer class="school-footer"><span>{c.footer}</span><nav><a href={to('home')}>{c.home}</a><a href={to('pathways')}>{c.routes}</a><a href={base+'en/school/'}>EN</a><a href={base+'es/escuela/'}>ES</a><a href={base+'escola/'}>PT</a></nav></footer>
<script>
const storageKey='harum_noir_school_v1';
const checkboxes=[...document.querySelectorAll('[data-school-task]')];
const progress=document.querySelector('.school-progress-track');
const count=document.querySelector('.school-progress-count');
const percent=document.querySelector('.school-progress-percent');
const clear=document.querySelector('.school-clear');
const update=()=>{
  const done=checkboxes.filter(box=>box.checked).length;
  const value=checkboxes.length?Math.round(done*100/checkboxes.length):0;
  progress?.setAttribute('aria-valuenow',String(done));
  if(progress?.firstElementChild)progress.firstElementChild.style.width=value+'%';
  if(percent)percent.textContent=value+'%';
  if(count)count.textContent=done+' / '+checkboxes.length+' '+(document.documentElement.lang==='pt-BR'?'práticas marcadas':document.documentElement.lang==='es'?'prácticas marcadas':'practices marked');
  try{localStorage.setItem(storageKey,JSON.stringify(checkboxes.filter(box=>box.checked).map(box=>box.dataset.schoolTask)))}catch{}
};
try{
  const saved=JSON.parse(localStorage.getItem(storageKey)||'[]');
  if(Array.isArray(saved))checkboxes.forEach(box=>{box.checked=saved.includes(box.dataset.schoolTask)});
}catch{}
checkboxes.forEach(box=>box.addEventListener('change',update));
clear?.addEventListener('click',()=>{checkboxes.forEach(box=>{box.checked=false});update()});
update();
</script>
<style>
.school-intl-header{position:sticky;top:0;z-index:10;display:flex;justify-content:space-between;align-items:center;padding:15px clamp(16px,5vw,70px);background:rgba(7,7,7,.94);border-bottom:1px solid var(--line);backdrop-filter:blur(14px)}.school-intl-header>a{font-family:Georgia,serif;letter-spacing:.14em;text-decoration:none}.school-intl-header nav{display:flex;gap:7px}.school-intl-header nav a{padding:6px 9px;border:1px solid var(--line);text-decoration:none;font-size:.72rem}.school-intl-header nav a[aria-current]{border-color:var(--gold);color:var(--gold)}
.school-page{max-width:1400px;margin:0 auto;padding:22px clamp(18px,5vw,70px) 80px}.school-hero{display:grid;grid-template-columns:1fr .9fr;gap:clamp(24px,5vw,70px);align-items:center;padding:22px 0 58px;border-bottom:1px solid var(--line)}.school-hero-art{margin:0;min-width:0;position:relative}.school-hero-art img{display:block;width:100%;aspect-ratio:1.48;object-fit:cover;border-radius:4px}.school-hero-art figcaption{position:absolute;right:10px;bottom:10px;padding:5px 7px;background:#090909cc;color:var(--paper-2);font-size:.62rem}.school-kicker{color:var(--gold);font-size:.68rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase}.school-hero h1{font-size:clamp(3rem,6.2vw,6rem);line-height:.93;letter-spacing:-.055em;margin:18px 0}.school-hero-copy>p{max-width:50ch;color:var(--paper-2);line-height:1.7}.school-actions{display:flex;flex-wrap:wrap;align-items:center;gap:16px;margin-top:24px}.school-actions a,.school-text-link{color:var(--gold);text-decoration:none;font-size:.85rem}.school-actions .school-primary{padding:12px 16px;background:var(--gold);color:#111;border-radius:3px}.school-section{padding:64px 0;border-bottom:1px solid var(--line)}.school-section-head{display:grid;grid-template-columns:1fr .7fr;gap:26px;align-items:end;margin-bottom:24px}.school-section h2,.school-practice h2{font-size:clamp(2.2rem,4.5vw,4.1rem);line-height:.98;letter-spacing:-.04em;margin:12px 0}.school-section-head>p,.school-practice-copy>p{color:var(--paper-2);line-height:1.65;max-width:53ch}.school-steps{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:13px}.school-step{overflow:hidden;border:1px solid var(--line);border-radius:7px;text-decoration:none;color:inherit;background:#101011}.school-step-art{position:relative;aspect-ratio:1.35;overflow:hidden}.school-step-art img{width:100%;height:100%;object-fit:cover;filter:saturate(.52)}.school-step-art>span{position:absolute;top:10px;left:10px;padding:5px 8px;border-radius:20px;background:#080808c9;color:var(--paper);font-size:.7rem}.school-step-copy{padding:16px}.school-step-copy small{color:var(--gold);letter-spacing:.13em;font-size:.62rem}.school-step-copy h3{font-size:1.35rem;margin:9px 0}.school-step-copy p{min-height:4.7em;color:var(--paper-2);font-size:.77rem;line-height:1.55}.school-step-copy b{display:flex;justify-content:space-between;padding-top:11px;border-top:1px solid var(--line);color:var(--gold);font-size:.72rem}.school-practice{display:grid;grid-template-columns:1.1fr .9fr;gap:clamp(28px,6vw,84px);padding:66px 0 0;align-items:start}.school-exercise-visual{margin:22px 0 18px;border:1px solid var(--line);background:#111}.school-exercise-visual img{display:block;width:100%;height:auto;aspect-ratio:3/2;object-fit:cover}.school-exercise-visual figcaption{padding:9px 12px;color:var(--paper-2);font-size:.68rem;line-height:1.45;border-top:1px solid var(--line)}.school-practice-copy ol{padding-left:1.2em;color:var(--paper-2);line-height:1.8}.school-text-link{display:inline-block;margin-top:10px}.school-progress{position:sticky;top:95px;padding:25px;border:1px solid var(--line);border-radius:8px;background:linear-gradient(145deg,#141415,#0a0a0b)}.school-progress h2{font-size:2rem;margin:10px 0}.school-progress>p{color:var(--paper-2);font-size:.82rem;line-height:1.55}.school-progress-label{display:flex;justify-content:space-between;gap:10px;margin:22px 0 8px;font-size:.74rem}.school-progress-percent{color:var(--gold)}.school-progress-track{height:8px;border-radius:9px;background:#302c25;overflow:hidden}.school-progress-track span{display:block;width:0;height:100%;background:var(--gold);transition:width .25s ease}.school-task-list{display:grid;gap:0;margin-top:14px}.school-task{display:flex;gap:11px;align-items:flex-start;padding:12px 0;border-bottom:1px solid var(--line);font-size:.8rem;line-height:1.5;cursor:pointer}.school-task input{accent-color:var(--gold);margin-top:3px}.school-task span{flex:1}.school-clear{margin-top:14px;padding:8px 10px;border:1px solid var(--line);background:transparent;color:var(--paper-2);cursor:pointer;border-radius:3px;font-size:.72rem}.school-footer{display:flex;justify-content:space-between;gap:18px;flex-wrap:wrap;padding:24px clamp(18px,5vw,70px);border-top:1px solid var(--line);color:var(--muted);font-size:.72rem}.school-footer nav{display:flex;gap:14px;flex-wrap:wrap}.school-footer a{color:var(--paper-2);text-decoration:none}
@media(max-width:1050px){.school-steps{grid-template-columns:repeat(2,minmax(0,1fr))}.school-progress{position:static}}
@media(max-width:760px){.school-page{padding-top:12px}.school-hero{grid-template-columns:1fr;gap:20px;padding-bottom:36px}.school-hero-art{order:-1}.school-hero-art img{aspect-ratio:1.55}.school-hero h1{font-size:clamp(2.8rem,12vw,4.6rem)}.school-section-head{grid-template-columns:1fr;gap:5px}.school-steps{grid-template-columns:1fr 1fr;gap:9px}.school-step-copy{padding:12px}.school-step-copy h3{font-size:1.16rem}.school-step-copy p{min-height:0;font-size:.72rem}.school-practice{grid-template-columns:1fr;gap:24px;padding-top:42px}.school-progress{padding:18px}.school-intl-header{padding-inline:14px}.school-footer{padding-bottom:84px}}
@media(max-width:440px){.school-steps{grid-template-columns:1fr}}
@media(prefers-reduced-motion:reduce){.school-progress-track span{transition:none}}
</style>
</body>
</html>